{
  "name": "pi-eval-metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Automatic privacy-preserving Notes A/B evaluation metrics for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "evaluation",
    "metrics"
  ],
  "pi": {
    "extensions": [
      "./entry.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "report": "tsx report.ts",
    "benchmark": "tsx harness.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "25.5.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
