{"type":"message","id":"9a9a45e9","parentId":"cdf7b8fd","timestamp":"2026-08-31T19:03:46.736Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-b722f199c0c6bb85","toolName":"read","content":[{"type":"text","text":"describe('GET /api/properties/[id]', () => {\n  const watched = {\n    id: 'prop-001',\n    address: '1 Main St',\n    city: 'Cleveland',\n    state: 'OH',\n    zipCode: '44113',\n    propertyType: 'office',\n    title: 'Main Street Office',\n    crexiId: 'crexi-abc',\n    listingUrl: 'https://crexi.com/listing/1',\n    thumbnailUrl: null,\n    price: 500000,\n    sizeSqFt: 12000,\n    pricePerSqFt: 41.67,\n    capturedAt: '2026-08-19T12:00:00.000Z',\n    verdict: 'CAUTION',\n    addedAt: '2026-08-19T12:00:00.000Z',\n  };\n\n  const sampleRun = {\n    runId: 'sr:prop-001:1:0',\n    ownerUid: 'u1',\n    propertyId: 'prop-001',\n    policyVersion: 'screening-policy.v1',\n    origin: 'auto' as const,\n    verdict: 'CAUTION' as const,\n    reasons: [\n      {\n        code: 'delinquent_taxes' as const,\n        message: 'Delinquent balance is $12,500.',\n        blocking: false,\n        sources: [],\n      },\n    ],\n    checks: [\n      {\n        id: 'county_record',\n        label: 'County parcel record',\n        status: 'complete' as const,\n        asOf: '2026-08-23T10:00:00.000Z',\n      },\n      {\n        id: 'recorded_documents',\n        label: 'Recorded documents search',\n        status: 'complete' as const,\n        asOf: '2026-08-23T10:00:00.000Z',\n      },\n    ],\n    inputSignature: 'c3:rcomplete',\n    startedAt: '2026-08-23T10:00:00.000Z',\n    completedAt: '2026-08-23T10:00:00.000Z',\n  };\n\n  beforeEach(() => {\n    (getLatestScreeningProjection as jest.Mock).mockResolvedValue([]);\n  });\n\n  it('returns 401 when unauthenticated', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue(null);\n    const res = await GET(\n      new NextRequest('http://localhost/api/properties/prop-001'),\n      params()\n    );\n    expect(res.status).toBe(401);\n  });\n\n  it('returns 404 when the property is not in the watchlist', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getWatchlistItem as jest.Mock).mockResolvedValue(null);\n    const res = await GET(\n      new NextRequest('http://localhost/api/properties/prop-001'),\n      params()\n    );\n    expect(res.status).toBe(404);\n    expect((await res.json()).error).toBe('Property not in your watchlist');\n  });\n\n  it('returns the item, live Crexi financials, and the screening projection', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getWatchlistItem as jest.Mock).mockResolvedValue(watched);\n    (searchCrexiProperty as jest.Mock).mockResolvedValue({\n      price: 500000,\n      sizeSqFt: 12000,\n      yearBuilt: 1998,\n      capRate: 6.4,\n      noi: 32000,\n      occupancyRate: 92,\n      pricePerSqFt: 41.67,\n    });\n    (getLatestScreeningProjection as jest.Mock).mockResolvedValue([\n      { propertyId: 'prop-001', run: sampleRun },\n    ]);\n    const res = await GET(\n      new NextRequest('http://localhost/api/properties/prop-001'),\n      params()\n    );\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.property).toEqual(watched);\n    expect(body.crexi.capRate).toBe(6.4);\n    // Freshness of the live values — the route stamps the retrieval time\n    // so the deep-dive can show when these were fetched.\n    expect(typeof body.crexi.retrievedAt).toBe('string');\n    expect(Number.isNaN(Date.parse(body.crexi.retrievedAt))).toBe(false);\n    expect(body.screening).toEqual(sampleRun);\n    expect(getLatestScreeningProjection).toHaveBeenCalledWith('u1', [\n      'prop-001',\n    ]);\n  });\n\n  it('returns a null screening projection when the property was never screened', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getWatchlistItem as jest.Mock).mockResolvedValue(watched);\n    (searchCrexiProperty as jest.Mock).mockResolvedValue(null);\n    const res = await GET(\n      new NextRequest('http://localhost/api/properties/prop-001'),\n      params()\n    );\n    expect(res.status).toBe(200);\n\n[32 more lines in file. Use offset=314 to continue.]"}],"isError":false,"timestamp":1788203026736}}
