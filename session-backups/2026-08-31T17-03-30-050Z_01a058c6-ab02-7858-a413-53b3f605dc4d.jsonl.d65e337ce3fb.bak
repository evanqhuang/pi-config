{"type":"message","id":"15f23570","parentId":"06ca1465","timestamp":"2026-08-31T18:09:45.794Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-8e20efa4a1d9d7ce","toolName":"read","content":[{"type":"text","text":"/**\n * Unit tests for GET /api/properties/[id]/recorded-documents/searches/[searchId]\n * (Task 5) — the per-run poll endpoint the UI uses to watch a run finish.\n */\nimport { NextRequest } from 'next/server';\nimport { GET } from '../route';\nimport type { RecordedSearch } from '@/types/recorded-documents';\nimport type { WatchlistItem } from '@/types/records-dashboard';\n\njest.mock('@/lib/auth', () => ({ getUserFromRequest: jest.fn() }));\njest.mock('@/lib/firestore/properties', () => ({\n  getWatchlistItem: jest.fn(),\n}));\njest.mock('@/lib/firestore/recorded-documents', () => ({\n  getRecordedSearchById: jest.fn(),\n}));\njest.mock('@/lib/rate-limiter', () => ({\n  checkRateLimit: jest.fn(),\n  getRateLimitHeaders: jest.fn().mockReturnValue({}),\n}));\n\nimport { getUserFromRequest } from '@/lib/auth';\nimport { getWatchlistItem } from '@/lib/firestore/properties';\nimport { getRecordedSearchById } from '@/lib/firestore/recorded-documents';\nimport { checkRateLimit } from '@/lib/rate-limiter';\n\nconst NOW = '2026-08-22T00:00:00.000Z';\n\nconst WATCH_ITEM: WatchlistItem = {\n  id: 'prop-001',\n  address: '1234 Euclid Ave',\n  city: 'Cleveland',\n  state: 'OH',\n  zipCode: '44109',\n  county: { code: 'cuyahoga-oh', name: 'Cuyahoga County' },\n  propertyType: null,\n  title: null,\n  crexiId: null,\n  listingUrl: null,\n  thumbnailUrl: null,\n  price: null,\n  sizeSqFt: null,\n  pricePerSqFt: null,\n  capturedAt: NOW,\n  verdict: null,\n  addedAt: NOW,\n};\n\nfunction search(over: Partial<RecordedSearch> = {}): RecordedSearch {\n  return {\n    searchId: 'rdsearch:prop-001:r1',\n    propertyId: 'prop-001',\n    countyRecordRevision: 1,\n    status: 'running',\n    mode: 'fixture',\n    configVersion: 1,\n    startedAt: NOW,\n    completedAt: null,\n    indexes: [],\n    documents: [],\n    manualNextSteps: [],\n    createdAt: NOW,\n    revision: 1,\n    ...over,\n  };\n}\n\nfunction params(id = 'prop-001', searchId = 'rdsearch:prop-001:r1') {\n  return { params: Promise.resolve({ id, searchId }) };\n}\n\nbeforeEach(() => {\n  jest.clearAllMocks();\n  (checkRateLimit as jest.Mock).mockReturnValue({\n    allowed: true,\n    limit: 10,\n    remaining: 10,\n    resetTime: new Date(),\n  });\n  (getWatchlistItem as jest.Mock).mockResolvedValue(WATCH_ITEM);\n  (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n});\n\ndescribe('GET .../recorded-documents/searches/[searchId]', () => {\n  it('401 when unauthenticated', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue(null);\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(401);\n  });\n\n  it('404 for an unknown search id', async () => {\n    (getRecordedSearchById as jest.Mock).mockResolvedValue(null);\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(404);\n  });\n\n  it('404 when the search belongs to a DIFFERENT property', async () => {\n    (getRecordedSearchById as jest.Mock).mockResolvedValue(\n      search({ propertyId: 'other-property' })\n    );\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(404);\n  });\n\n  it('returns the run (the UI polls this until it is terminal)', async () => {\n    (getRecordedSearchById as jest.Mock).mockResolvedValue(\n      search({\n        status: 'complete',\n        completedAt: NOW,\n        indexes: [\n          {\n            id: 'deeds',\n            label: 'Deed index',\n            required: true,\n            status: 'complete',\n            docCount: 0,\n            blockerReason: null,\n            manualNextStep: null,\n            fetchedAt: NOW,\n          },\n        ],\n      })\n    );\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe('complete');\n    expect(body.completedAt).toBe(NOW);\n    expect(body.indexes).toHaveLength(1);\n  });\n});\n"}],"isError":false,"timestamp":1788199785794}}
