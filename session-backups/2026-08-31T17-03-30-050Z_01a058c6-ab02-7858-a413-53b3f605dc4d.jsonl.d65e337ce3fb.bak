{"type":"message","id":"7eaeaa44","parentId":"f2153aec","timestamp":"2026-08-31T17:33:25.062Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-95fea8f61de613de","toolName":"bash","content":[{"type":"text","text":"  COUNTY_CAPABILITIES,\n  countyIdentityForProperty,\n  countyForSourceId,\n  lookupCountyCapability,\n  normalizeCountyCode,\n  notCoveredPayload,\n  resolveCountyCoverage,\n} from '@/lib/county-records/capabilities';\n    const p = notCoveredPayload(resolveCountyCoverage(null, null));\n    expect(p.reason).toBe('unknown');\n    expect(p.county).toBeNull();\n  });\n\n  it('a county contradiction is surfaced for review; a clean coverage is not', () => {\n    const withContradiction = notCoveredPayload(\n      resolveCountyCoverage(\n        { code: 'summit-oh', name: 'Summit County' },\n        'cuyahoga-arcgis'\n      )\n    );\n    expect(withContradiction.reason).toBe('planned');\n    expect(withContradiction.message).toContain('Summit County');\n    expect(withContradiction.message).toContain('Cuyahoga County');\n    expect(withContradiction.message).toMatch(/review the county/i);\n\n    const clean = notCoveredPayload(\n      resolveCountyCoverage({ code: 'summit-oh', name: 'Summit County' }, null)\n    );\n    expect(clean.message).not.toMatch(/review the county/i);\n"}],"isError":false,"timestamp":1788197605062}}
