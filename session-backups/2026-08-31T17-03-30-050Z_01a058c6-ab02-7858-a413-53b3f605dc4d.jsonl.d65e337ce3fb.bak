e county-\n+446  * specific results are never presented as current authoritative data.\n+447  */\n+448 export function coverageNote(coverage: CountyCoverage): {\n+449   status: CountyCoverage['status'];\n+450   county: { code: string; name: string } | null;\n+451   message: string | null;\n+452 } {\n+453   if (coverage.status === 'live') {\n+454     return { status: 'live', county: coverage.county, message: null };\n+455   }\n+456   const payload = notCoveredPayload(coverage);\n+457   return {\n+458     status: coverage.status,\n+459     county: payload.county,\n+460     message: payload.message,\n+461   };\n+462 }\n+463 \n 404 export function screeningCoverageRow(coverage: CountyCoverage): {\n 405   status: CountyCoverage['status'];\n 406   county: { code: string; name: string } | null;\n 407   eta: string | null;\n     ...","patch":"--- /Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/lib/county-records/capabilities.ts\n+++ /Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/lib/county-records/capabilities.ts\n@@ -16,8 +16,13 @@\n  *   - `not_covered`: the county is known but has no coverage (on or off\n  *                    the roadmap), or the county identity is not in the\n  *                    registry.\n  *   - `unknown`:     the property has no county identity at all.\n+ *   - `review`:      the property's EXPLICIT county and the county a\n+ *                    CONFIRMED parcel snapshot proves disagree. This is a\n+ *                    fail-closed review state: no county work runs until a\n+ *                    human resolves the contradiction (it is never treated\n+ *                    as `live`, even when one side is a covered county).\n  */\n import type {\n   CountyIdentity,\n   CountyRecordsSourceId,\n@@ -224,14 +229,14 @@\n   return { code: cap.code, name: cap.name };\n }\n \n /**\n- * Review signal (never a routing input): the property's EXPLICIT county\n- * and the county proven by a CONFIRMED parcel snapshot disagree (for\n- * example, an explicit Summit County plus a Cuyahoga-confirmed parcel).\n- * Resolution is unchanged — the explicit county always wins and provenance\n- * is only a backfill for missing identity — but the mismatch is surfaced\n- * in fail-closed responses so a human reviews the property's county.\n+ * The property's EXPLICIT county and the county proven by a CONFIRMED\n+ * parcel snapshot disagree (for example, an explicit Summit County plus a\n+ * Cuyahoga-confirmed parcel). A present contradiction is a FAIL-CLOSED\n+ * review state (`status: 'review'`): the explicit county is displayed but\n+ * no county work may run — a confirmed parcel is a stronger claim than a\n+ * user assertion, and only a human may resolve which one stands.\n  */\n export type CountyCoverageContradiction = {\n   explicit: CountyIdentity;\n   provenance: CountyIdentity;\n@@ -265,8 +270,15 @@\n       county: null;\n       eta: null;\n       source: null;\n       contradiction?: CountyCoverageContradiction;\n+    }\n+  | {\n+      status: 'review';\n+      county: CountyIdentity;\n+      eta: null;\n+      source: null;\n+      contradiction: NonNullable<CountyCoverageContradiction>;\n     };\n \n /** The live branch of CountyCoverage — guarantees a usable county identity. */\n export type LiveCoverage = Extract<CountyCoverage, { status: 'live' }>;\n@@ -280,9 +292,13 @@\n  *                        snapshot, when one exists (source-provenance\n  *                        backfill for legacy properties).\n  *\n  * Never returns a live result for a property that has no county identity\n- * and no confirmed county source — unknown stays unknown.\n+ * and no confirmed county source — unknown stays unknown. When the\n+ * explicit county and the confirmed-snapshot provenance prove DIFFERENT\n+ * counties, the result is the fail-closed `review` state: the explicit\n+ * county is displayed, but no county work runs until a human resolves the\n+ * contradiction (even if one of