{"type":"message","id":"9d481803","parentId":"796cb226","timestamp":"2026-08-31T18:08:45.632Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-93d662cfe5141687","toolName":"read","content":[{"type":"text","text":"/**\n * Unit tests for GET /api/properties/[id]/recorded-documents (Task 5).\n */\nimport { NextRequest } from 'next/server';\nimport { GET } from '../route';\nimport type { RecordedSearch } from '@/types/recorded-documents';\nimport type { WatchlistItem } from '@/types/records-dashboard';\n\njest.mock('@/lib/auth', () => ({ getUserFromRequest: jest.fn() }));\njest.mock('@/lib/firestore/properties', () => ({\n  getWatchlistItem: jest.fn(),\n}));\njest.mock('@/lib/firestore/recorded-documents', () => ({\n  getLatestRecordedSearch: jest.fn(),\n}));\njest.mock('@/lib/rate-limiter', () => ({\n  checkRateLimit: jest.fn(),\n  getRateLimitHeaders: jest.fn().mockReturnValue({}),\n}));\n\nimport { getUserFromRequest } from '@/lib/auth';\nimport { getWatchlistItem } from '@/lib/firestore/properties';\nimport { getLatestRecordedSearch } from '@/lib/firestore/recorded-documents';\nimport { checkRateLimit } from '@/lib/rate-limiter';\n\nconst NOW = '2026-08-22T00:00:00.000Z';\n\nconst WATCH_ITEM: WatchlistItem = {\n  id: 'prop-001',\n  address: '1234 Euclid Ave',\n  city: 'Cleveland',\n  state: 'OH',\n  zipCode: '44109',\n  county: { code: 'cuyahoga-oh', name: 'Cuyahoga County' },\n  propertyType: null,\n  title: null,\n  crexiId: null,\n  listingUrl: null,\n  thumbnailUrl: null,\n  price: null,\n  sizeSqFt: null,\n  pricePerSqFt: null,\n  capturedAt: NOW,\n  verdict: null,\n  addedAt: NOW,\n};\n\nconst SEARCH: RecordedSearch = {\n  searchId: 'rdsearch:prop-001:r1',\n  propertyId: 'prop-001',\n  countyRecordRevision: 1,\n  status: 'search_incomplete',\n  mode: 'fixture',\n  configVersion: 1,\n  startedAt: NOW,\n  completedAt: NOW,\n  indexes: [\n    {\n      id: 'deeds',\n      label: 'Deed index (grantor/grantee)',\n      required: true,\n      status: 'blocked',\n      docCount: 0,\n      blockerReason: 'down for maintenance',\n      manualNextStep: 'check the portal',\n      fetchedAt: null,\n    },\n    {\n      id: 'liens',\n      label: 'Lien index (recorded liens and releases)',\n      required: true,\n      status: 'complete',\n      docCount: 1,\n      blockerReason: null,\n      manualNextStep: null,\n      fetchedAt: NOW,\n    },\n  ],\n  documents: [\n    {\n      docId: 'liens:2005-118803:taxlien',\n      number: '2005-118803',\n      type: 'Tax Lien',\n      date: '2005-09-01',\n      parties: ['Cuyahoga County Treasurer'],\n      propertyRef: {\n        parcelId: '43205003',\n        parcelIdFormatted: '432-05-003',\n        address: '1234 Euclid Ave, Cleveland, OH 44109',\n        bookPage: null,\n      },\n      officialUrl:\n        'https://recorder.cuyahoga-county.example/document/2005-118803',\n      retrievedAt: NOW,\n      provenance: {\n        sourceId: 'cuyahoga-recorder',\n        indexId: 'liens',\n        fetchedAt: NOW,\n        schemaVersion: 1,\n      },\n      relationship: 'possible_lien',\n    },\n  ],\n  manualNextSteps: ['Deed index: check the portal'],\n  createdAt: NOW,\n  revision: 2,\n};\n\nfunction params(id = 'prop-001') {\n  return { params: Promise.resolve({ id }) };\n}\n\nbeforeEach(() => {\n  jest.clearAllMocks();\n  (checkRateLimit as jest.Mock).mockReturnValue({\n    allowed: true,\n    limit: 10,\n    remaining: 10,\n    resetTime: new Date(),\n  });\n  (getWatchlistItem as jest.Mock).mockResolvedValue(WATCH_ITEM);\n});\n\ndescribe('GET /api/properties/[id]/recorded-documents', () => {\n  it('401 when unauthenticated', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue(null);\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(401);\n  });\n\n  it('404 when the property is not in the caller watchlist', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getWatchlistItem as jest.Mock).mockResolvedValue(null);\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(404);\n  });\n\n  it('returns the not_started shape when the property was never searched', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getLatestRecordedSearch as jest.Mock).mockResolvedValue(null);\n\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body).toEqual(\n      expect.objectContaining({\n        status: 'not_started',\n        searchId: null,\n        propertyId: 'prop-001',\n      })\n    );\n    expect(body.manualNextSteps.length).toBeGreaterThan(0);\n  });\n\n  it('returns the latest search run (coverage ledger + documents)', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getLatestRecordedSearch as jest.Mock).mockResolvedValue(SEARCH);\n\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe('search_incomplete');\n    expect(body.indexes).toHaveLength(2);\n    expect(body.documents[0].relationship).toBe('possible_lien');\n    expect(body.documents[0].officialUrl).toBe(\n      'https://recorder.cuyahoga-county.example/document/2005-118803'\n    );\n    expect(body.manualNextSteps).toEqual(['Deed index: check the portal']);\n  });\n\n  it('sends no-store caching', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getLatestRecordedSearch as jest.Mock).mockResolvedValue(null);\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.headers.get('cache-control')).toBe('no-store');\n  });\n});\n"}],"isError":false,"timestamp":1788199725632}}
{"type":"message","id":"24fcf2d8","parentId":"9d481803","timestamp":"2026-08-31T18:09:26.905Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"This test mocks `@/lib/firestore/properties` (getWatchlistItem) and `@/lib/firestore/recorded-documents` (getLatestRecordedSearch), but does **not** mock `@/lib/firestore/county-records` — so `recordedReadGuard` (imported from './shared', and not mocked) calls the real `getCountyRecord` → which calls `getFirestoreDb()` → and throws in the unit environment (no firebase initialization) → 500.\n\nFix: add `jest.mock('@/lib/firestore/county-records', () => ({ getCountyRecord: jest.fn().mockResolvedValue(null) }))`. Since WATCH_ITEM has an explicit Cuyahoga county and no snapshot record, coverage is 'live' → authoritative is true. Also add an assertion to the \"returns the latest search run\" test: `body.authoritative` is true and `body.coverage.status` is 'live'. Furthermore, we could add a test for the non-live case: county-less property + no record → authoritative is false, coverage is unknown. A good idea for verifying the guard. I'll make the following edits:\n\n1. Add the mock block after the recorded-documents mock.\n2. Import getCountyRecord.\n3. Add assertions to the \"latest search run\" test: authoritative is true, coverage.status is 'live', coverage.county.code is 'cuyahoga-oh'.\n4. Add a new test: \"flags a county-less property (no confirmed parcel) as non-authoritative\": getWatchlistItem resolves a county-less variant, getLatestRecordedSearch resolves null → body.authoritative is false, body.coverage.status is 'unknown'.\n\nFor the county-less variant, WATCH_ITEM with county set to null — I'll define a const inline within the test.\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-8cec1c1851715be4","name":"edit","arguments":{"edits":[{"newText":"jest.mock('@/lib/firestore/recorded-documents', () => ({\n  getLatestRecordedSearch: jest.fn(),\n}));\njest.mock('@/lib/firestore/county-records', () => ({\n  getCountyRecord: jest.fn().mockResolvedValue(null),\n}));\njest.mock('@/lib/rate-limiter', () => ({\n  checkRateLimit: jest.fn(),\n  getRateLimitHeaders: jest.fn().mockReturnValue({}),\n}));\n\nimport { getUserFromRequest } from '@/lib/auth';\nimport { getWatchlistItem } from '@/lib/firestore/properties';\nimport { getCountyRecord } from '@/lib/firestore/county-records';\nimport { getLatestRecordedSearch } from '@/lib/firestore/recorded-documents';\nimport { checkRateLimit } from '@/lib/rate-limiter';","oldText":"jest.mock('@/lib/firestore/recorded-documents', () => ({\n  getLatestRecordedSearch: jest.fn(),\n}));\njest.mock('@/lib/rate-limiter', () => ({\n  checkRateLimit: jest.fn(),\n  getRateLimitHeaders: jest.fn().mockReturnValue({}),\n}));\n\nimport { getUserFromRequest } from '@/lib/auth';\nimport { getWatchlistItem } from '@/lib/firestore/properties';\nimport { getLatestRecordedSearch } from '@/lib/firestore/recorded-documents';\nimport { checkRateLimit } from '@/lib/rate-limiter';"},{"newText":"  it('returns the latest search run (coverage ledger + documents)', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getLatestRecordedSearch as jest.Mock).mockResolvedValue(SEARCH);\n\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe('search_incomplete');\n    expect(body.indexes).toHaveLength(2);\n    expect(body.documents[0].relationship).toBe('possible_lien');\n    expect(body.documents[0].officialUrl).toBe(\n      'https://recorder.cuyahoga-county.example/document/2005-118803'\n    );\n    expect(body.manualNextSteps).toEqual(['Deed index: check the portal']);\n    // The read guard: live coverage (explicit county, no contradiction) is\n    // presented as authoritative.\n    expect(body.authoritative).toBe(true);\n    expect(body.coverage.status).toBe('live');\n    expect(body.coverage.county?.code).toBe('cuyahoga-oh');\n  });\n\n  it('flags stored results as non-authoritative when coverage is not live', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    // Legacy property: county never asserted and no confirmed parcel to\n    // prove one — nothing may be presented as authoritative county data.\n    (getWatchlistItem as jest.Mock).mockResolvedValue({\n      ...WATCH_ITEM,\n      county: null,\n    });\n    (getLatestRecordedSearch as jest.Mock).mockResolvedValue(null);\n\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe('not_started');\n    expect(body.authoritative).toBe(false);\n    expect(body.coverage.status).toBe('unknown');\n    expect(body.coverage.message).toContain('county');\n  });","oldText":"  it('returns the latest search run (coverage ledger + documents)', async () => {\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getLatestRecordedSearch as jest.Mock).mockResolvedValue(SEARCH);\n\n    const res = await GET(new NextRequest('http://test/api'), params());\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe('search_incomplete');\n    expect(body.indexes).toHaveLength(2);\n    expect(body.documents[0].relationship).toBe('possible_lien');\n    expect(body.documents[0].officialUrl).toBe(\n      'https://recorder.cuyahoga-county.example/document/2005-118803'\n    );\n    expect(body.manualNextSteps).toEqual(['Deed index: check the portal']);\n  });"}],"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/__tests__/route.test.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":72985,"output":1521,"cacheRead":0,"cacheWrite":0,"reasoning":384,"totalTokens":74506,"c