{"type":"message","id":"7dbce843","parentId":"c255206a","timestamp":"2026-08-31T18:29:40.673Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-925d1012cb4162df","toolName":"bash","content":[{"type":"text","text":"    super(message);\n    this.name = 'WorkerLeaseLostError';\n  }\n}\n\n/**\n * Categorized worker failure. `blocking` codes are the ones a retry can\n * never fix (human action or a changed world state); everything else is\n * transient and gets bounded exponential backoff until maxAttempts.\n */\nexport type WorkerFailure =\n  | { kind: 'cas_conflict'; currentStateRevision: number }\n  | {\n      kind: 'blocking';\n      info: { code: string; message: string };\n    }\n  | {\n      kind: 'transient';\n      info: { code: string; message: string };\n    };\n\n/**\n * Error codes that are permanently blocking (exact next step, no retry):\n * the request/state cannot succeed as-is until a human or a new upstream\n * observation intervenes. `source_unavailable` / `source_malformed` are\n * deliberately TRANSIENT (source flakiness retries; the backoff bounds it).\n * Task 10 adds the MCP auth/CAPTCHA/paywall codes here.\n */\nconst BLOCKING_WORKER_CODES = new Set([\n  'unsupported_county',\n  'county_changed',\n  'invalid_request',\n  'parcel_gone',\n]);\n\nexport function classifyWorkerFailure(error: unknown): WorkerFailure {\n  if (error instanceof CountyRecordChangedError) {\n    return {\n      kind: 'cas_conflict',\n      currentStateRevision: error.current.revision,\n    };\n  }\n  if (error instanceof WorkerBlockedError) {\n    return {\n      kind: 'blocking',\n      info: { code: error.code, message: error.message },\n    };\n  }\n  if (error instanceof CountyRecordsError) {\n    const info: { code: string; message: string } =\n      error.code === 'unsupported_county'\n        ? { code: 'unsupported_county', message: error.message }\n        : { code: error.code, message: error.message };\n    return BLOCKING_WORKER_CODES.has(error.code)\n      ? { kind: 'blocking', info }\n      : { kind: 'transient', info };\n  }\n  // Unknown (bug-class) failure: transient so the attempt budget applies,\n  // but the message never echoes anything upstream.\n  return {\n    kind: 'transient',\n    info: { code: 'internal_error', message: 'Unexpected worker failure' },\n  };\n}\n\n/** Bounded exponential retry delay: 30s, 60s, 120s, ... capped at 30min. */\n573:export async function blockTask(\n574-  uid: string,\n575-  taskId: string,\n576-  workerId: string,\n577-  error: AgentTaskPublicError,\n578-  now = Date.now(),\n579-  result: AgentTaskResultRef | null = null\n580-): Promise<AgentTask | null> {\n581-  const db = getFirestoreDb();\n582-  const ref = agentTaskRef(uid, taskId);\n583-  return db.runTransaction(async (tx) => {\n584-    const doc = await tx.get(ref);\n585-    if (!doc.exists) return null;\n586-    const task = parseAgentTask(doc.id, doc.data());\n587-    if (\n588-      (task.status !== 'claimed' && task.status !== 'running') ||\n589-      (task.leaseOwner !== workerId && !isLeaseExpired(task, now))\n590-    ) {\n591-      return null;\n592-    }\n593-    const updated: AgentTask = {\n"}],"isError":false,"timestamp":1788200980673}}
