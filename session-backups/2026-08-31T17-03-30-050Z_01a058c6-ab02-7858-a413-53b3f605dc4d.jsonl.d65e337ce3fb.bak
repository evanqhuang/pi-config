{"type":"message","id":"44eb8c4b","parentId":"5a8f98eb","timestamp":"2026-08-31T18:36:40.310Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-a5fb78e844cf04e6","toolName":"bash","content":[{"type":"text","text":"674:async function runCountyRefresh(\n675-  task: AgentTask,\n676-  ctx: WorkerContext\n677-): Promise<TaskSuccess> {\n678-  // SAFETY: the county refresh route builds this exact shape at enqueue\n679-  // time (the revision is the only caller input).\n680-  const input = task.input as unknown as CountyRefreshInput;\n681-  const uid = task.ownerUid;\n682-  const propertyId = task.propertyId;\n683-  const item = await requireWatchlistProperty(uid, propertyId);\n684-\n685-  const current = await getCountyRecord(uid, propertyId);\n686-  if (!current?.snapshot) {\n687-    throw new WorkerBlockedError(\n688-      'no_snapshot',\n689-      'No confirmed parcel snapshot to refresh; run a resolution first.'\n690-    );\n691-  }\n692-\n693-  // M1 coverage gate (re-verified at run time; zero writes on failure).\n694-  const coverage = await requireLiveCounty(item, current, input.county);\n695-  const provider = providerFor(ctx, coverage.county);\n696-  const snapshot = await provider.fetchParcelSnapshot(\n697-    current.snapshot.provenance.objectId,\n698-    scenarioOption(ctx)\n699-  );\n700-  if (snapshot === null) {\n701-    const info: CountyRecordsErrorInfo = {\n702-      code: 'parcel_gone',\n703-      message: publicMessageFor('parcel_gone'),\n704-    };\n"}],"isError":false,"timestamp":1788201400310}}
{"type":"message","id":"f3636c7a","parentId":"44eb8c4b","timestamp":"2026-08-31T18:37:53.438Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"I need to investigate this further. Let me check the details.\n\nThe advisory is advisory only — no action needed. I've gathered all the information I need. The shape of CountyRefreshInput: {expectedRevision, county?} — the input for the refresh task: the refresh route builds it. I'll enqueue with `{ expectedRevision: 2, county: CUYAHOGA }` (the input.county used in the expectedCounty check — since the item's county is Cuyahoga, passing CUYAHOGA is consistent; the normalize check compares the expected and coverage counties).\n\nAlright, let me rewrite the integration test file.\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-a7b477ba838a1d5a","name":"write","arguments":{"content":"/**\n * Integration tests for the transactional county reconciliation (WU1).\n *\n * Runs against the local Firestore emulator (localhost:8095 — set by\n * jest.setup.integration.js). The legacy state the plan calls for — a\n * county-LESS property with an already-confirmed Cuyahoga parcel (the\n * current seed has no such property) — is built through the REAL seams:\n * upsert (county: null) → saveResolution (confirmation_required with the\n * genuine fixture candidates) → confirmCountyParcel (genuine fixture\n * snapshot). From that state the coverage is `live` through provenance,\n * which is exactly what makes county work — and therefore the\n * reconciliation — reachable for a county-less property.\n *\n *   A. A successful county refresh reconciles the county durably\n *      (merge write with the provenance metadata).\n *   B. A direct re-attempt of the reconciliation is idempotent: no\n *      second write, no duplicate tasks or events.\n *   C. The fail-closed review contradiction blocks WORKER county work\n *      (the second enforcement line after the route gates): a Summit\n *      assertion on top of a confirmed Cuyahoga parcel blocks a refresh\n *      with `county_review` and zero writes.\n */\nimport {\n  upsertWatchlistItem,\n  getWatchlistItem,\n  updateWatchlistItemCounty,\n  reconcileWatchlistCounty,\n} from '@/lib/firestore/properties';\nimport {\n  enqueueCountyTaskIfCurrent,\n  getCountyRecord,\n  saveResolution,\n  confirmCountyParcel,\n} from '@/lib/firestore/county-records';\nimport { getTaskForOwner } from '@/lib/firestore/agent-tasks';\nimport { processOneTask } from '@/lib/agent-worker';\nimport { CuyahogaFixtureProvider } from '@/lib/county-records/fixtures';\nimport { getFirestoreDb } from '@/lib/firebase/admin';\nimport type { CountyIdentity } from '@/types/records-dashboard';\nimport type { CountyParcelSnapshot } from '@/types/county-records';\nimport type { AgentTask } from '@/types/agent-tasks';\n\nconst CUYAHOGA: CountyIdentity = {\n  code: 'cuyahoga-oh',\n  name: 'Cuyahoga County',\n};\nconst SUMMIT: CountyIdentity = { code: 'summit-oh', name: 'Summit County' };\n\nconst ADDR = {\n  street: '5180 broadview road',\n  unit: null,\n  city: 'cleveland',\n  state: 'OH',\n  zip: '44143',\n};\n\nconst runId = () => `${Date.now()}-${Math.floor(Math.random() * 1e6)}`;\nconst provider = new CuyahogaFixtureProvider();\n\nasync function seedLegacyConfirmed(\n  uid: string,\n  propertyId: string,\n  county: CountyIdentity | null = null\n) {\n  await upsertWatchlistItem(uid, propertyId, {\n    address: '5180 Broadview Rd',\n    city: 'Cleveland',\n    state: 'OH',\n    zipCode: '44143',\n    county,\n    propertyType: 'residential',\n    title: 'Broadview Rd House',\n    crexiId: propertyId,\n    listingUrl: null,\n    thumbnailUrl: null,\n    price: null,\n    sizeSqFt: null,\n    pricePerSqFt: null,\n  });\n\n  // The legacy confirmation path, through the real CAS seams: a\n  // confirmation_required resolution followed by a parcel confirmation.\n  const candidates = await provider.resolveCandidates(ADDR);\n  if (candidates.length === 0) throw new Error('fixture returned no parcel');\n  const candidate = candidates[0];\n  const snapshot = await provider.fetchParcelSnapshot(candidate.objectId);\n  if (!snapshot) throw new Error('fixture returned no snapshot');\n  await saveResolution(uid, propertyId, {\n    status: 'confirmation_required',\n    resolvedAddress: ADDR,\n    candidates,\n    lastRefresh: { at: new Date().toISOString(), ok: true, error: null },\n    expectedRevision: 0,\n  });\n  const confirmed = await confirmCountyParcel(\n    uid,\n    propertyId,\n    {\n      objectId: candidate.objectId,\n      parcelId: candidate.parcelId,\n      parcelIdFormatted: candidate.parcelIdFormatted,\n      resolvedAddress: ADDR,\n      snapshot: snapshot as CountyParcelSnapshot,\n      expectedRevision: 1,\n    },\n    { actor: 'client' }\n  );\n  if (!confirmed || confirmed.status !== 'confirmed') {\n    throw new Error('seed confirmation failed');\n  }\n  return confirmed;\n}\n\n/** Raw watchlist document (includes the reconciliation metadata fields). */\nasync function rawPropertyDoc(\n  uid: string,\n  propertyId: string\n): Promise<Record<string, unknown>> {\n  const doc = await getFirestoreDb()\n    .collection('users')\n    .doc(uid)\n    .collection('properties')\n    .doc(propertyId)\n    .get();\n  if (!doc.exists) throw new Error('property document missing');\n  return doc.data() as Record<string, unknown>;\n}\n\n/** Every document under users/{uid} the county pipeline can write. */\nasync function countUserDocs(uid: string): Promise<number> {\n  const db = getFirestoreDb();\n  const user = db.collection('users').doc(uid);\n  let total = 0;\n  const subcollections = [\n    'agentTasks',\n    'domainEvents',\n    'feedItems',\n    'actionItems',\n    'properties',\n  ];\n  for (const sub of subcollections) {\n    const snap = await user.collection(sub).get();\n    total += snap.size;\n    if (sub === 'properties') {\n      for (const doc of snap.docs) {\n        const cr = await doc.ref.collection('countyRecords').get();\n        total += cr.size;\n      }\n    }\n  }\n  return total;\n}\n\nasync function runRefresh(\n  uid: string,\n  propertyId: string,\n  expectedRevision: number\n): Promise<AgentTask> {\n  const enq = await enqueueCountyTaskIfCurrent(\n    uid,\n    propertyId,\n    'county_refresh',\n    { expectedRevision, county: CUYAHOGA },\n    expectedRevision\n  );\n  if (!enq.task) throw new Error('refresh enqueue failed');\n  await processOneTask(enq.task, { workerId: `w-cr-${runId()}` });\n  const task = await getTaskForOwner(uid, enq.task.taskId);\n  if (!task) throw new Error('task document vanished');\n  return task;\n}\n\ndescribe('county reconciliation (emulator)', () => {\n  it('a successful refresh durably reconciles a legacy county-less property', async () => {\n    const uid = `cr-a-${runId()}`;\n    const propertyId = `prop-cra-${runId()}`;\n    const seeded = await seedLegacyConfirmed(uid, propertyId);\n    expect(seeded.revision).toBe(2);\n\n    const before = await countUserDocs(uid);\n    const task = await runRefresh(uid, propertyId, seeded.revision);\n    expect(task.status).toBe('succeeded');\n\n    // The county identity is now persisted with its provenance, and the\n    // refresh advanced the record exactly once.\n    const item = await getWatchlistItem(uid, propertyId);\n    expect(item?.county).toEqual(CUYAHOGA);\n    const raw = await rawPropertyDoc(uid, propertyId);\n    expect(raw.countyReconciledFrom).toBe('cuyahoga-fixture');\n    expect(typeof raw.countyReconciledAt).toBe('string');\n    const record = await getCountyRecord(uid, propertyId);\n    expect(record?.revision).toBe(3);\n    // The refresh wrote exactly the record transition (+ its event) —\n    // nothing else new appeared under the owner.\n    expect(await countUserDocs(uid)).toBe(before + 2);\n  });\n\n  it('a direct reconciliation is idempotent: a re-attempt writes nothing', async () => {\n    const uid = `cr-b-${runId()}`;\n    const propertyId = `prop-crb-${runId()}`;\n    await seedLegacyConfirmed(uid, propertyId);\n\n    const first = await reconcileWatchlistCounty(\n      uid,\n      propertyId,\n      CUYAHOGA,\n      'cuyahoga-fixture'\n    );\n    expect(first.status).toBe('reconciled');\n    const before = await countUserDocs(uid);\n    const countyBefore = (await rawPropertyDoc(uid, propertyId)).county;\n\n    const second = await reconcileWatchlistCounty(\n      uid,\n      propertyId,\n      CUYAHOGA,\n      'cuyahoga-fixture'\n    );\n    expect(second.status).toBe('already_reconciled');\n    expect(await countUserDocs(uid)).toBe(before);\n    expect((await rawPropertyDoc(uid, propertyId)).county).toEqual(\n      countyBefore\n    );\n  });\n\n  it('a review contradiction blocks worker county work with zero writes', async () => {\n    const uid = `cr-c-${runId()}`;\n    const propertyId = `prop-crc-${runId()}`;\n    const seeded = await seedLegacyConfirmed(uid, propertyId);\n\n    // The user then asserts a DIFFERENT county — the real PATCH seam.\n    // The confirmed parcel proves Cuyahoga; from now on the property is\n    // in the fail-closed review state.\n    await updateWatchlistItemCounty(uid, propertyId, SUMMIT);\n\n    const before = await countUserDocs(uid);\n    const recordBefore = await getCountyRecord(uid, propertyId);\n    const task = await runRefresh(uid, propertyId, seeded.revision);\n\n    expect(task.status).toBe('blocked');\n    expect(task.error?.code).toBe('county_review');\n    // Zero writes: the record is untouched and the assertion survives.\n    expect(await countUserDocs(uid)).toBe(before);\n    const recordAfter = await getCountyRecord(uid, propertyId);\n    expect(recordAfter?.revision).toBe(recordBefore?.revision);\n    expect(recordAfter?.snapshot).toEqual(recordBefore?.snapshot);\n    expect((await getWatchlistItem(uid, propertyId))?.county).toEqual(SUMMIT);\n  });\n});\n","path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/__tests__/integration/firestore/county-reconcile.integration.test.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":143621,"output":2564,"cacheRead":0,"cacheWrite":0,"reasoning":135,"totalTokens":146185,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788201400314,"responseId":"chatcmpl-81bbaa2ce86d292d","rawStopReason":"tool_calls"}}
