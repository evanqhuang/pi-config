{"type":"message","id":"02219465","parentId":"6448a83c","timestamp":"2026-08-31T17:35:34.349Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"The property detail route is already wired up. Next:\n- /api/coverage route — make it provenance-aware (already reads the county record for the summary; need per-item provenance for the rows).\n- The property list route — per-item coverage for the pill.\n- The root + polling of recorded-documents — guard.\n\nLet's take a closer look at /api/coverage.\n","thinkingSignature":"reasoning"},{"type":"text","text":"\n\nProperty detail route wired. Now the `/api/coverage` route:\n\n"},{"type":"toolCall","id":"chatcmpl-tool-a9f300e5bddb98fb","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/coverage/route.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":71460,"output":150,"cacheRead":0,"cacheWrite":0,"reasoning":84,"totalTokens":71610,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788197729257,"responseId":"chatcmpl-80b11bd0b4658980","rawStopReason":"tool_calls"}}
{"type":"message","id":"fbbf0323","parentId":"02219465","timestamp":"2026-08-31T17:35:34.361Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-a9f300e5bddb98fb","toolName":"read","content":[{"type":"text","text":"import { NextRequest, NextResponse } from 'next/server';\nimport { getUserFromRequest } from '@/lib/auth';\nimport { listWatchlistItems } from '@/lib/firestore/properties';\nimport {\n  COUNTY_CAPABILITIES,\n  countyIdentityForProperty,\n  resolveCountyCoverage,\n  type CountyCoverage,\n} from '@/lib/county-records/capabilities';\n\nexport const dynamic = 'force-dynamic';\n\n/** Client-safe projection of the capability registry (the roadmap strip). */\nfunction capabilityRow(\n  cap: (typeof COUNTY_CAPABILITIES)[number]\n): {\n  code: string;\n  name: string;\n  state: string;\n  status: 'live' | 'planned' | 'not_covered';\n  eta: string | null;\n  sourceLabel: string | null;\n} {\n  return {\n    code: cap.code,\n    name: cap.name,\n    state: cap.state,\n    status: cap.status,\n    eta: cap.eta,\n    sourceLabel: cap.source ? cap.source.label : null,\n  };\n}\n\ninterface CoverageCountyRow {\n  code: string;\n  name: string;\n  state: string;\n  status: CountyCoverage['status'];\n  eta: string | null;\n  sourceLabel: string | null;\n  propertyCount: number;\n}\n\n/**\n * GET /api/coverage\n *\n * County coverage from the canonical capability registry (the ONLY\n * source of coverage truth) plus the user's own watchlist grouped by\n * county identity. A property without county identity is reported as\n * `unknown` — never folded into a covered county (state is NOT a routing\n * input). The roadmap lists the registry as-is, including counties the\n * user has no properties in: that is the designed honesty (planned and\n * not-covered counties are facts about the product, not invented data —\n * and no property counts are ever fabricated for them).\n */\nexport async function GET(request: NextRequest) {\n  const NO_STORE = { 'Cache-Control': 'no-store' } as const;\n  try {\n    const user = await getUserFromRequest(request);\n    if (!user) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401, headers: NO_STORE }\n      );\n    }\n\n    const items = await listWatchlistItems(user.id);\n    const byCounty = new Map<\n      string,\n      {\n        name: string;\n        state: string;\n        coverage: CountyCoverage;\n        count: number;\n      }\n    >();\n    let unknownCount = 0;\n\n    for (const item of items) {\n      const identity = countyIdentityForProperty(\n        item.county ?? undefined,\n        item.state\n      );\n      // The list view uses the explicit identity only (no per-property\n      // county-record backfill — this endpoint is a light projection;\n      // the deep-dive carries the full backfill).\n      const coverage = resolveCountyCoverage(identity, null);\n      if (coverage.status === 'unknown') {\n        unknownCount += 1;\n        continue;\n      }\n      const key = coverage.county.code;\n      const existing = byCounty.get(key);\n      if (existing) {\n        existing.count += 1;\n      } else {\n        byCounty.set(key, {\n          name: coverage.county.name,\n          state: (item.state ?? '').toUpperCase() || '—',\n          coverage,\n          count: 1,\n        });\n      }\n    }\n\n    const counties: CoverageCountyRow[] = [...byCounty.values()].map(\n      (entry) => {\n        const cap = COUNTY_CAPABILITIES.find(\n          (c) => c.code === entry.coverage.county!.code\n        );\n        return {\n          code: entry.coverage.county!.code,\n          name: entry.coverage.county!.name,\n          state: cap ? cap.state : entry.state,\n          status: entry.coverage.status,\n          eta:\n            entry.coverage.status === 'planned' ? entry.coverage.eta : null,\n          sourceLabel:\n            entry.coverage.status === 'live'\n              ? entry.coverage.source.label\n              : null,\n          propertyCount: entry.count,\n        };\n      }\n    );\n    // Live first, then planned, then not covered; alpha within a tier.\n    const ORDER: Record<string, number> = {\n      live: 0,\n      planned: 1,\n      not_covered: 2,\n    };\n    counties.sort(\n      (a, b) =>\n        ORDER[a.status] - ORDER[b.status] || a.name.localeCompare(b.name)\n    );\n\n    return NextResponse.json(\n      {\n        coverage: {\n          counties,\n          unknownCount,\n          roadmap: COUNTY_CAPABILITIES.map(capabilityRow),\n        },\n      },\n      { headers: NO_STORE }\n    );\n  } catch (error) {\n    console.error('Error in /api/coverage:', error);\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: NO_STORE }\n    );\n  }\n}\n"}],"isError":false,"timestamp":1788197734361}}
