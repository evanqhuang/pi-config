{"type":"message","id":"752636d2","parentId":"f1487262","timestamp":"2026-08-31T17:54:55.607Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-8e9229cccae6021b","toolName":"bash","content":[{"type":"text","text":"131:function reloadHrefFor(propertyId: string): string {\n290:function scenarioOption(\n301:function providerFor(\n314:async function requireLiveCounty(\n364:async function reconcileCountyBestEffort(\n392:function casOptionsFor(task: AgentTask) {\n403:async function requireWatchlistProperty(\n423:async function runCountyResolve(\n586:async function runCountyConfirm(\n674:async function runCountyRefresh(\n745:async function runRecordedDocumentsSearch(\n848:async function runScreening(task: AgentTask): Promise<{ run: ScreeningRun }> {\n880:async function runOwnerRequestDraft(\n */\nfunction providerFor(\n  ctx: WorkerContext,\n  county: CountyIdentity\n): CountyRecordsProvider {\n  return ctx.provider ?? getCountyRecordsProvider(county);\n}\n\n/**\n * M1 run-time re-check: the property's canonical coverage must be `live`\n * NOW (the world may have changed since enqueue), and — when the task\n * input captured a county — it must still match. Fails closed with a\n * blocking error and ZERO county writes.\n */\nasync function requireLiveCounty(\n  item: WatchlistItem,\n  record: StoredCountyRecord | null,\n  expectedCounty: CountyIdentity | null | undefined\n): Promise<LiveCoverage> {\n  const coverage = resolveCountyCoverage(\n    item.county ?? null,\n    record?.snapshot?.provenance?.sourceId ?? null\n  );\n  if (coverage.status === 'review') {\n    // Fail closed: the explicit county and a confirmed parcel disagree.\n    // A distinct code — this is not \"the county is unsupported\"; it is\n    // a contradiction only a human can resolve.\n    throw new WorkerBlockedError(\n      'county_review',\n      notCoveredPayload(coverage).message\n    );\n  }\n  if (coverage.status !== 'live') {\n    throw new WorkerBlockedError(\n      'unsupported_county',\n      notCoveredPayload(coverage).message\n    );\n  }\n  if (\n    expectedCounty &&\n    normalizeCountyCode(expectedCounty.code) !==\n      normalizeCountyCode(coverage.county.code)\n  ) {\n    throw new WorkerBlockedError(\n      'county_changed',\n      'The property\\u2019s county changed since this work was queued. Reload and re-run it.'\n"}],"isError":false,"timestamp":1788198895607}}
