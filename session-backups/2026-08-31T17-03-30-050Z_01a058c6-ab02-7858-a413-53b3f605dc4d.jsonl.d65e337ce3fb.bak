{"type":"message","id":"b66ae7b2","parentId":"4b06c0f4","timestamp":"2026-08-31T17:11:36.343Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-bbddee6e607c6c10","toolName":"read","content":[{"type":"text","text":"import { NextRequest, NextResponse } from 'next/server';\nimport { z } from 'zod';\n\nimport {\n  NO_STORE,\n  countyRecordChangedResponse,\n  requireRecordedProperty,\n} from '../shared';\nimport { enqueueRecordedSearchIfCurrent } from '@/lib/firestore/recorded-documents';\nimport { getCountyRecord } from '@/lib/firestore/county-records';\nimport {\n  notCoveredPayload,\n  resolveCountyCoverage,\n} from '@/lib/county-records/capabilities';\n\nexport const dynamic = 'force-dynamic';\n\n/**\n * The body carries ONLY the county-record revision the caller last saw\n * (0 when the property has no county record yet). Nothing else: the\n * parcel/address reference is always re-read server-side at run time, so a\n * caller can never steer which parcel is searched.\n */\nconst bodySchema = z.object({\n  expectedRevision: z.number().int().nonnegative(),\n});\n\n/**\n * POST /api/properties/[id]/recorded-documents/search\n *\n * Enqueues the durable recorded-document search work (202). No provider\n * I/O runs in this route — the worker does it. A stale county revision\n * returns the canonical 409 `county_record_changed`.\n */\nexport async function POST(\n  request: NextRequest,\n  { params }: { params: Promise<{ id: string }> }\n) {\n  try {\n    const auth = await requireRecordedProperty(request, params);\n    if (auth instanceof NextResponse) return auth;\n    const { user, property } = auth;\n\n    let raw: unknown;\n    try {\n      raw = await request.json();\n    } catch {\n      return NextResponse.json(\n        { error: 'expectedRevision must be a non-negative integer' },\n        { status: 400, headers: NO_STORE }\n      );\n    }\n    const parsed = bodySchema.safeParse(raw);\n    if (!parsed.success) {\n      return NextResponse.json(\n        { error: 'expectedRevision must be a non-negative integer' },\n        { status: 400, headers: NO_STORE }\n      );\n    }\n    const { expectedRevision } = parsed.data;\n\n    // M1 coverage gate: the recorder search only runs against the covered\n    // county's recorder. A property whose county is planned, not-covered,\n    // or unknown fails closed with ZERO writes — no search run, no task,\n    // no event. (The worker re-checks at run time as well.)\n    const gateRecord = await getCountyRecord(user.id, property.id);\n    const coverage = resolveCountyCoverage(\n      property.county ?? null,\n      gateRecord?.snapshot?.provenance?.sourceId ?? null\n    );\n    if (coverage.status !== 'live') {\n      return NextResponse.json(notCoveredPayload(coverage), {\n        status: 422,\n        headers: NO_STORE,\n      });\n    }\n\n    const result = await enqueueRecordedSearchIfCurrent(\n      user.id,\n      property.id,\n      expectedRevision\n    );\n    if (result.stale || !result.task || !result.search) {\n      // Stale: the county record moved since the caller looked. Return the\n      // full current county state (the canonical 409 payload) so the UI can\n      // adopt it and re-run the search against the newer revision.\n      const current = await getCountyRecord(user.id, property.id);\n      return current\n        ? countyRecordChangedResponse(current)\n        : NextResponse.json(\n            { error: 'county_record_changed', state: null },\n            { status: 409, headers: NO_STORE }\n          );\n    }\n\n    return NextResponse.json(\n      {\n        taskId: result.task.taskId,\n        taskRevision: result.task.revision,\n        stateRevision: result.countyRecordRevision,\n        searchId: result.search.searchId,\n        created: result.created,\n      },\n      { status: 202, headers: NO_STORE }\n    );\n  } catch (error) {\n    console.error('Error in POST .../recorded-documents/search:', error);\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: NO_STORE }\n    );\n  }\n}\n"}],"isError":false,"timestamp":1788196296343}}
{"type":"message","id":"5bd68ab3","parentId":"b66ae7b2","timestamp":"2026-08-31T17:11:36.343Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-9bc4deb304ad43dc","toolName":"bash","content":[{"type":"text","text":"__tests__/\nsearch/\nsearches/\n[searchId]/\n__tests__/\nroute.ts  1.4K\nshared.ts  1.8K\nroute.ts  1.3K\n===\n/**\n * Normalized domain types for county records (Cuyahoga MVP).\n *\n * The UI and API consume only these normalized shapes. Raw ArcGIS field\n * names never cross the provider boundary. A missing county value is\n * `null` (unknown) — never 0/false. Flags are three-state: null/true/false.\n */\n\n/** Which county source produced a value. */\nexport type CountyRecordsSourceId = 'cuyahoga-arcgis' | 'cuyahoga-fixture';\n\n/**\n * Canonical county identity for a property.\n *\n * `code` is a STABLE SLUG and the ONLY routing key (capability lookup,\n * provider selection, worker verification). `name` is display-only and\n * never drives routing. A missing county is `null` (unknown) — never an\n * inferred default (e.g. Cuyahoga on the strength of an OH state).\n */\nexport interface CountyIdentity {\n  /** Stable slug, e.g. `cuyahoga-oh` or `lorain-oh`. */\n  code: string;\n  /** Display name, e.g. `Cuyahoga County`. */\n  name: string;\n}\n\n/** Bumped when the persisted StoredCountyRecord shape changes. */\nexport const COUNTY_RECORDS_SCHEMA_VERSION = 1 as const;\n\n/**\n * A property address in normalized form (lowercase ASCII; directionals and\n * street suffixes expanded). Unit and location parts are separate fields so\n * matching never depends on string layout.\n */\nexport interface NormalizedPropertyAddress {\n  /** e.g. \"5180 broadview dr\" */\n  street: string;\n  /** e.g. \"4B\"; null when the property has no unit */\n  unit: string | null;\n  /** e.g. \"cleveland\" */\n  city: string | null;\n  /** 2-letter USPS code, e.g. \"OH\"; null when unknown */\n  state: string | null;\n  /** 5-digit ZIP; null when unknown */\n  zip: string | null;\n}\n\nexport type ParcelMatchQuality = 'exact' | 'strong' | 'weak';\n\n/** One parcel the county source returned for a property-address search. */\nexport interface ParcelCandidate {\n  /** Upstream ObjectID — the only stable handle for revalidation. */\n  objectId: number;\n  /** Raw county parcel id, e.g. \"43205003\" (leading zeros preserved). */\n  parcelId: string;\n  /** Human format, e.g. \"432-05-003\". */\n  parcelIdFormatted: string;\n  /** The county's own address for this parcel (normalized fields). */\n  address: {\n    /** The source's full address string, verbatim. */\n    raw: string | null;\n    street: string | null;\n    city: string | null;\n    state: string | null;\n    zip: string | null;\n    unit: string | null;\n  } | null;\n  /**\n   * County owner as recorded (displayed only after confirmation).\n   * Excluded from persisted pending candidates.\n   */\n  owner: string | null;\n  /** 0–100 match score against the property address. */\n  score: number;\n  matchQuality: ParcelMatchQuality;\n  /** The source's last-update timestamp (ISO), or null. */\n  sourceUpdateAt: string | null;\n}\n\n/**\n"}],"isError":false,"timestamp":1788196296343}}
{"type":"message","id":"14a6d3c0","parentId":"5bd68ab3","timestamp":"2026-08-31T17:11:48.631Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Alright. The recorded-documents search POST route is already gating on coverage with provenance. The plan's WU1 says \"apply the canonical coverage guard to the collection and search-polling reads of recorded documents.\" In other words, the read path — `recorded-documents/searches/[searchId]/route.ts` (polling) and `recorded-documents/searches/route.ts` (listing) — should be guarded too. Let me read these.\n\nAlso, I need to check `src/lib/firestore/recorded-documents.ts` (the collection read) and the agent-worker's handling (around line 319).\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-ade211f56cf0457f","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/searches/[searchId]/route.ts"}},{"type":"toolCall","id":"chatcmpl-tool-853aff25456ff20e","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/searches/route.ts"}},{"type":"toolCall","id":"chatcmpl-tool-b60513df112e5be2","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/shared.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":87696,"output":310,"cacheRead":0,"cacheWrite":0,"reasoning":134,"totalTokens":88006,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788196296346,"responseId":"chatcmpl-aaab6c715c83a65e","rawStopReason":"tool_calls"}}
