{"type":"message","id":"4ef2fb2b","parentId":"8b3b66e9","timestamp":"2026-08-31T18:32:50.338Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"`getTaskForOwner(uid, taskId)` is the reader. Next, I'll write the integration test file.\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-a805dc5d6d25f181","name":"write","arguments":{"content":"/**\n * Integration tests for the transactional county reconciliation (WU1).\n *\n * Runs against the local Firestore emulator (localhost:8095 — set by\n * jest.setup.integration.js). Everything flows through the REAL seams\n * (upsert / enqueue seam / worker run / user PATCH / reconcile call) —\n * no raw county-record seeding — so the assertions prove the durable\n * behavior, not a test fixture:\n *\n *   1. A legacy county-less property with a fixture auto-confirmed\n *      parcel gets its county reconciled durably (merge write with the\n *      provenance metadata), exactly once.\n *   2. Re-running the reconciliation is idempotent: no second write, no\n *      duplicate tasks or events.\n *   3. The fail-closed review contradiction blocks WORKER county work\n *      (the second enforcement line after the route gates): an\n *      explicit-Summit assertion on top of a confirmed Cuyahoga parcel\n *      blocks a refresh with `county_review` and zero writes.\n */\nimport {\n  upsertWatchlistItem,\n  getWatchlistItem,\n  updateWatchlistItemCounty,\n  reconcileWatchlistCounty,\n} from '@/lib/firestore/properties';\nimport {\n  enqueueCountyTaskIfCurrent,\n  getCountyRecord,\n} from '@/lib/firestore/county-records';\nimport { getTaskForOwner } from '@/lib/firestore/agent-tasks';\nimport { processOneTask } from '@/lib/agent-worker';\nimport { getFirestoreDb } from '@/lib/firebase/admin';\nimport type { CountyIdentity } from '@/types/records-dashboard';\nimport type { AgentTask } from '@/types/agent-tasks';\n\nconst CUYAHOGA: CountyIdentity = {\n  code: 'cuyahoga-oh',\n  name: 'Cuyahoga County',\n};\nconst SUMMIT: CountyIdentity = { code: 'summit-oh', name: 'Summit County' };\n\nconst ADDR = {\n  street: '5180 broadview road',\n  unit: null,\n  city: 'cleveland',\n  state: 'OH',\n  zip: '44143',\n};\n\nconst runId = () => `${Date.now()}-${Math.floor(Math.random() * 1e6)}`;\n\nasync function seedLegacyCountyless(uid: string, propertyId: string) {\n  await upsertWatchlistItem(uid, propertyId, {\n    address: '5180 Broadview Rd',\n    city: 'Cleveland',\n    state: 'OH',\n    zipCode: '44143',\n    county: null, // legacy: added before county identity existed\n    propertyType: 'residential',\n    title: 'Broadview Rd House',\n    crexiId: propertyId,\n    listingUrl: null,\n    thumbnailUrl: null,\n    price: null,\n    sizeSqFt: null,\n    pricePerSqFt: null,\n  });\n}\n\nasync function autoConfirmCuyahoga(uid: string, propertyId: string) {\n  const enq = await enqueueCountyTaskIfCurrent(\n    uid,\n    propertyId,\n    'county_resolve',\n    { expectedRevision: 0, address: ADDR },\n    0\n  );\n  if (!enq.task) throw new Error('county resolve enqueue failed');\n  await processOneTask(enq.task, { workerId: `w-cr-${runId()}` });\n}\n\n/** Raw watchlist document (includes the reconciliation metadata fields). */\nasync function rawPropertyDoc(\n  uid: string,\n  propertyId: string\n): Promise<Record<string, unknown>> {\n  const doc = await getFirestoreDb()\n    .collection('users')\n    .doc(uid)\n    .collection('properties')\n    .doc(propertyId)\n    .get();\n  if (!doc.exists) throw new Error('property document missing');\n  return doc.data() as Record<string, unknown>;\n}\n\n/** Every document under users/{uid} the county pipeline can write. */\nasync function countUserDocs(uid: string): Promise<number> {\n  const db = getFirestoreDb();\n  const user = db.collection('users').doc(uid);\n  let total = 0;\n  const subcollections = [\n    'agentTasks',\n    'domainEvents',\n    'feedItems',\n    'actionItems',\n    'properties',\n  ];\n  for (const sub of subcollections) {\n    const snap = await user.collection(sub).get();\n    total += snap.size;\n    if (sub === 'properties') {\n      for (const doc of snap.docs) {\n        const cr = await doc.ref.collection('countyRecords').get();\n        total += cr.size;\n      }\n    }\n  }\n  return total;\n}\n\ndescribe('county reconciliation (emulator)', () => {\n  it('auto-confirmed parcel durably reconciles a legacy county-less property', async () => {\n    const uid = `cr-t1-${runId()}`;\n    const propertyId = `prop-cr1-${runId()}`;\n    await seedLegacyCountyless(uid, propertyId);\n\n    await autoConfirmCuyahoga(uid, propertyId);\n\n    const item = await getWatchlistItem(uid, propertyId);\n    expect(item?.county).toEqual(CUYAHOGA);\n    const raw = await rawPropertyDoc(uid, propertyId);\n    expect(raw.countyReconciledFrom).toBe('cuyahoga-fixture');\n    expect(typeof raw.countyReconciledAt).toBe('string');\n  });\n\n  it('reconciliation is idempotent: a re-attempt writes nothing new', async () => {\n    const uid = `cr-t2-${runId()}`;\n    const propertyId = `prop-cr2-${runId()}`;\n    await seedLegacyCountyless(uid, propertyId);\n    await autoConfirmCuyahoga(uid, propertyId);\n\n    const before = await countUserDocs(uid);\n    const countyBefore = (await rawPropertyDoc(uid, propertyId)).county;\n\n    // A direct re-attempt (e.g. the next county work after an earlier\n    // persistence failure): the county is present, so nothing changes.\n    const outcome = await reconcileWatchlistCounty(\n      uid,\n      propertyId,\n      CUYAHOGA,\n      'cuyahoga-fixture'\n    );\n    expect(outcome.status).toBe('already_reconciled');\n\n    const after = await countUserDocs(uid);\n    expect(after).toBe(before);\n    expect((await rawPropertyDoc(uid, propertyId)).county).toEqual(\n      countyBefore\n    );\n  });\n\n  it('a review contradiction blocks worker county work with zero writes', async () => {\n    const uid = `cr-t3-${runId()}`;\n    const propertyId = `prop-cr3-${runId()}`;\n    await seedLegacyCountyless(uid, propertyId);\n    await autoConfirmCuyahoga(uid, propertyId);\n\n    // The user then asserts a DIFFERENT county — the real PATCH seam.\n    // The confirmed parcel proves Cuyahoga; from now on every surface\n    // must fail closed.\n    await updateWatchlistItemCounty(uid, propertyId, SUMMIT);\n\n    const recordBefore = await getCountyRecord(uid, propertyId);\n    expect(recordBefore).not.toBeNull();\n    const refreshEnq = await enqueueCountyTaskIfCurrent(\n      uid,\n      propertyId,\n      'county_refresh',\n      { expectedRevision: recordBefore!.revision },\n      recordBefore!.revision\n    );\n    if (!refreshEnq.task) throw new Error('refresh enqueue failed');\n    const workerId = `w-cr3-${runId()}`;\n    await processOneTask(refreshEnq.task, { workerId });\n\n    const task = (await getTaskForOwner(uid, refreshEnq.task.taskId)) as\n      | AgentTask\n      | null;\n    expect(task?.status).toBe('blocked');\n    expect(task?.error?.code).toBe('county_review');\n\n    // Zero writes: the county record is untouched, the explicit county\n    // assertion survives, and the snapshot is preserved.\n    const recordAfter = await getCountyRecord(uid, propertyId);\n    expect(recordAfter?.revision).toBe(recordBefore!.revision);\n    expect(recordAfter?.snapshot).toEqual(recordBefore!.snapshot);\n    expect((await getWatchlistItem(uid, propertyId))?.county).toEqual(SUMMIT);\n  });\n});\n","path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/__tests__/integration/firestore/county-reconcile.integration.test.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":128735,"output":2003,"cacheRead":0,"cacheWrite":0,"reasoning":24,"totalTokens":130738,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788201114878,"responseId":"chatcmpl-84dbfc7410efc582","rawStopReason":"tool_calls"}}
