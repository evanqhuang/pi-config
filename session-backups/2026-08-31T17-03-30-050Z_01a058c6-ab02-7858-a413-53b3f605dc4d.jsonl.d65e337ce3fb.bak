{"type":"message","id":"92a26363","parentId":"48a24f69","timestamp":"2026-08-31T17:17:02.694Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-a5a7453f61c6a2ff","toolName":"read","content":[{"type":"text","text":"  // observation (same rule the synchronous route used).\n  const confirmed = await confirmCountyParcel(\n    uid,\n    propertyId,\n    {\n      objectId: selected.objectId,\n      parcelId: snapshot.parcelId,\n      parcelIdFormatted: snapshot.parcelIdFormatted,\n      resolvedAddress: address,\n      snapshot,\n      expectedRevision: pending.revision,\n    },\n    casOptionsFor(task)\n  );\n  if (!confirmed || confirmed.snapshot === null) {\n    throw new WorkerBlockedError(\n      'candidate_mismatch',\n      'The stored candidates no longer include this parcel; re-run the resolution.'\n    );\n  }\n  // Legacy reconciliation (idempotent): an auto-confirmed parcel proves the\n  // county, so a property that was added without county identity gets it\n  // persisted here — same best-effort backfill the explicit confirm lane\n  // uses. An explicit county is never overwritten.\n  await backfillCountyBestEffort(uid, item, coverage.county);\n  return { eventType: 'county_record_confirmed', record: confirmed };\n}\n\n/**\n * county_confirm: re-fetch the candidate's snapshot (the county is the\n * source of truth — never the requester's payload) and confirm it.\n */\nasync function runCountyConfirm(\n  task: AgentTask,\n  ctx: WorkerContext\n): Promise<TaskSuccess> {\n  // SAFETY: the county confirm route builds this exact shape at enqueue\n  // time (objectId from the stored candidates, never the requester's raw\n  // parcel payload).\n  const input = task.input as unknown as CountyConfirmInput;\n  const uid = task.ownerUid;\n  const propertyId = task.propertyId;\n  const item = await requireWatchlistProperty(uid, propertyId);\n\n  const current = await getCountyRecord(uid, propertyId);\n  if (!current) {\n    throw new WorkerBlockedError(\n      'no_record',\n      'There is no stored county record to confirm against.'\n    );\n  }\n\n  // M1 coverage gate (re-verified at run time; zero writes on failure).\n  const coverage = await requireLiveCounty(item, current, input.county);\n  const provider = providerFor(ctx, coverage.county);\n  const snapshot = await provider.fetchParcelSnapshot(\n    input.objectId,\n    scenarioOption(ctx)\n  );\n  if (snapshot === null) {\n    // Best-effort failure record (the caller's follow-up GET is the source\n    // of truth; a persistence conflict is logged, not propagated).\n    const info: CountyRecordsErrorInfo = {\n      code: 'parcel_gone',\n      message: publicMessageFor('parcel_gone'),\n    };\n    try {\n      if (current.snapshot) {\n        await recordCountyRefreshFailure(\n          uid,\n          propertyId,\n          info,\n          current.revision\n        );\n      } else if (current.resolvedAddress) {\n        await recordResolutionFailure(uid, propertyId, {\n          resolvedAddress: current.resolvedAddress,\n          error: info,\n          expectedRevision: current.revision,\n        });\n      }\n    } catch (error) {\n      console.warn(\n        `[agent-worker] best-effort confirm-failure record failed: ${String(error)}`\n      );\n    }\n    throw new WorkerBlockedError(\n      'parcel_gone',\n      publicMessageFor('parcel_gone')\n    );\n  }\n\n  const confirmed = await confirmCountyParcel(\n    uid,\n    propertyId,\n    {\n      objectId: input.objectId,\n      parcelId: snapshot.parcelId,\n      parcelIdFormatted: snapshot.parcelIdFormatted,\n      resolvedAddress:\n        current.resolvedAddress ?? (input.address as NormalizedPropertyAddress),\n      snapshot,\n      expectedRevision: input.expectedRevision,\n    },\n    casOptionsFor(task)\n  );\n  if (!confirmed) {\n    throw new WorkerBlockedError(\n      'candidate_mismatch',\n      'The stored candidates no longer include this parcel; re-run the resolution.'\n    );\n  }\n  await backfillCountyBestEffort(uid, item, coverage.county);\n  return { eventType: 'county_record_confirmed', record: confirmed };\n}\n\n/**\n * county_refresh: re-fetch the confirmed parcel's snapshot and store it\n * (last-known-good semantics: a failed refresh keeps the old snapshot).\n */\nasync function runCountyRefresh(\n  task: AgentTask,\n  ctx: WorkerContext\n): Promise<TaskSuccess> {\n  // SAFETY: the county refresh route builds this exact shape at enqueue\n  // time (the revision is the only caller input).\n  const input = task.input as unknown as CountyRefreshInput;\n  const uid = task.ownerUid;\n  const propertyId = task.propertyId;\n  const item = await requireWatchlistProperty(uid, propertyId);\n\n[556 more lines in file. Use offset=650 to continue.]"}],"isError":false,"timestamp":1788196622694}}
