{"type":"message","id":"9a10877f","parentId":"c27fe85c","timestamp":"2026-08-31T17:11:07.537Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-89b0bccd81f6478c","toolName":"read","content":[{"type":"text","text":"import { NextRequest, NextResponse } from 'next/server';\nimport { getUserFromRequest } from '@/lib/auth';\nimport {\n  searchCrexiProperty,\n  type CrexiDetail,\n} from '@/lib/crexi/property-search';\nimport {\n  deleteWatchlistItem,\n  getWatchlistItem,\n  updateWatchlistItemCounty,\n} from '@/lib/firestore/properties';\nimport { getLatestScreeningProjection } from '@/lib/screening/runs';\nimport {\n  countyIdentityForProperty,\n  normalizeCountyCode,\n  resolveCountyCoverage,\n} from '@/lib/county-records/capabilities';\nimport { z } from 'zod';\n\nexport const dynamic = 'force-dynamic';\n\n/**\n * GET /api/properties/[id] — deep-dive data for a watched property:\n * the watchlist snapshot (identity, captured financials, verdict) plus\n * live Crexi financials re-fetched by the stored address. 404 when the\n * property isn't in the user's watchlist — an unwatched Crexi id can't\n * be resolved without a stored address, so there is no live fallback.\n */\nexport async function GET(\n  request: NextRequest,\n  { params }: { params: Promise<{ id: string }> }\n) {\n  try {\n    const user = await getUserFromRequest(request);\n    if (!user) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401, headers: { 'Cache-Control': 'no-store' } }\n      );\n    }\n    const { id } = await params;\n\n    const property = await getWatchlistItem(user.id, id);\n    if (!property) {\n      return NextResponse.json(\n        { error: 'Property not in your watchlist' },\n        { status: 404, headers: { 'Cache-Control': 'no-store' } }\n      );\n    }\n\n    // Live financials by the stored address (best effort — null when the\n    // listing is gone or Crexi/MCP is unreachable). searchCrexiProperty\n    // returns null on failure rather than throwing.\n    const live = property.address\n      ? await searchCrexiProperty(property.address)\n      : null;\n    // Stamp the retrieval time: the deep-dive shows it as the freshness\n    // of the live values (separate from the snapshot's capturedAt).\n    const crexi: CrexiDetail | null = live\n      ? { ...live, retrievedAt: new Date().toISOString() }\n      : null;\n\n    // The authoritative screening projection (Task 6) — the latest run,\n    // never a mutable verdict.\n    const [screening] = await getLatestScreeningProjection(user.id, [id]);\n    // M1: the resolved coverage for this property's county — the deep-dive\n    // header chip and the not-covered banner render from this (the UI never\n    // infers coverage from state).\n    const coverage = resolveCountyCoverage(property.county ?? null, null);\n    return NextResponse.json(\n      { property, crexi, screening: screening?.run ?? null, coverage },\n      { headers: { 'Cache-Control': 'no-store' } }\n    );\n  } catch (error) {\n    console.error('Error in /api/properties/[id]:', error);\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: { 'Cache-Control': 'no-store' } }\n    );\n  }\n}\n\n/**\n * PATCH /api/properties/[id] — set (or clear) the property's county\n * identity. M1: this is the ONLY way a county enters the system — an\n * explicit user assertion, normalized server-side (the state only\n * disambiguates the slug; it never creates a county). The response returns\n * the updated item plus the resolved coverage so the UI can immediately\n * show the honest state.\n */\nconst countyPatchSchema = z.object({\n  county: z.union([\n    z.object({\n      code: z.string().min(1).max(64),\n      name: z.string().min(1).max(120),\n    }),\n    z.object({\n      name: z.string().min(1).max(120),\n    }),\n  ]),\n  expectedRevision: z.number().int().nonnegative().optional(),\n});\n\nexport async function PATCH(\n  request: NextRequest,\n  { params }: { params: Promise<{ id: string }> }\n) {\n  const NO_STORE = { 'Cache-Control': 'no-store' } as const;\n  try {\n    const user = await getUserFromRequest(request);\n    if (!user) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401, headers: NO_STORE }\n      );\n    }\n    const { id } = await params;\n    const property = await getWatchlistItem(user.id, id);\n    if (!property) {\n      return NextResponse.json(\n        { error: 'Property not in your watchlist' },\n        { status: 404, headers: NO_STORE }\n      );\n    }\n\n    let raw: unknown;\n    try {\n      raw = await request.json();\n    } catch {\n      return NextResponse.json(\n        { error: 'county is required' },\n        { status: 400, headers: NO_STORE }\n      );\n    }\n    const parsed = countyPatchSchema.safeParse(raw);\n    if (!parsed.success) {\n      return NextResponse.json(\n        { error: 'county must be a non-empty name (optionally with a code)' },\n        { status: 400, headers: NO_STORE }\n      );\n    }\n\n    const input = parsed.data.county;\n    const identity = countyIdentityForProperty(\n      {\n        code:\n          'code' in input && normalizeCountyCode(input.code) !== '0'\n            ? input.code\n            : undefined,\n        name: input.name,\n      },\n      property.state ?? null\n    );\n    if (!identity) {\n      return NextResponse.json(\n        {\n          error:\n            'county must contain letters (e.g. \"Cuyahoga\" or \"Cuyahoga County\")',\n        },\n        { status: 400, headers: NO_STORE }\n      );\n    }\n\n    const updated = await updateWatchlistItemCounty(user.id, id, identity);\n    if (!updated) {\n      return NextResponse.json(\n        { error: 'Property not in your watchlist' },\n        { status: 404, headers: NO_STORE }\n      );\n    }\n    const coverage = resolveCountyCoverage(identity, null);\n    return NextResponse.json(\n      { property: updated, coverage },\n      { headers: NO_STORE }\n    );\n  } catch (error) {\n    console.error('Error in PATCH /api/properties/[id]:', error);\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: { 'Cache-Control': 'no-store' } }\n    );\n  }\n}\nexport async function DELETE(\n  request: NextRequest,\n  { params }: { params: Promise<{ id: string }> }\n) {\n  try {\n    const user = await getUserFromRequest(request);\n    if (!user) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401, headers: { 'Cache-Control': 'no-store' } }\n      );\n    }\n    const { id } = await params;\n\n    const deleted = await deleteWatchlistItem(user.id, id);\n    if (!deleted) {\n      return NextResponse.json(\n        { error: 'Property not in your watchlist' },\n        { status: 404, headers: { 'Cache-Control': 'no-store' } }\n      );\n    }\n    return NextResponse.json(\n      { ok: true },\n      { headers: { 'Cache-Control': 'no-store' } }\n    );\n  } catch (error) {\n    console.error('Error in DELETE /api/properties/[id]:', error);\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: { 'Cache-Control': 'no-store' } }\n    );\n  }\n}\n"}],"isError":false,"timestamp":1788196267537}}
{"type":"message","id":"073c801d","parentId":"9a10877f","timestamp":"2026-08-31T17:11:23.543Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Confirmed: the property detail GET (`src/app/api/properties/[id]/route.ts:69`) is calling `resolveCountyCoverage(property.county ?? null, null)` — the second argument (the provenance from the confirmed county record snapshot) is hardcoded to `null`. In other words, a legacy property that doesn't have an explicit county but does have a confirmed Cuyahoga snapshot will show up as `unknown` in the property detail, even if the worker / recorded-documents routes treat it as live. This is exactly the \"one consistent county feature\" gap.\n\nThe fix requires the property detail (and /api/coverage, the screening inputs, etc.) to fetch the source ID of the confirmed county record. How do we get it? We need to check where the confirmed county records are stored (the county-records subcollection under property?) and whether there's a reader. The Explore agent will find this, but let's also check the recorded-documents search route and the coverage route ourselves.\n\nI'll read the following:\n- src/app/api/coverage/route.ts\n- src/app/api/properties/[id]/recorded-documents/search/route.ts (the search-polling read path)\n- src/lib/screening/inputs.ts\n- Around lines 300–340 of src/lib/agent-worker.ts\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-be63a3485c270974","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/coverage/route.ts"}},{"type":"toolCall","id":"chatcmpl-tool-96dc46833d54e9ad","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/lib/screening/inputs.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":82977,"output":378,"cacheRead":0,"cacheWrite":0,"reasoning":279,"totalTokens":83355,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788196267542,"responseId":"chatcmpl-83b4c1cfb8858bf6","rawStopReason":"tool_calls"}}
{"type":"message","id":"6b328d36","parentId":"073c801d","timestamp":"2026-08-31T17:11:23.589Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-be63a3485c270974","toolName":"read","content":[{"type":"text","text":"import { NextRequest, NextResponse } from 'next/server';\nimport { getUserFromRequest } from '@/lib/auth';\nimport { listWatchlistItems } from '@/lib/firestore/properties';\nimport {\n  COUNTY_CAPABILITIES,\n  countyIdentityForProperty,\n  resolveCountyCoverage,\n  type CountyCoverage,\n} from '@/lib/county-records/capabilities';\n\nexport const dynamic = 'force-dynamic';\n\n/** Client-safe projection of the capability registry (the roadmap strip). */\nfunction capabilityRow(\n  cap: (typeof COUNTY_CAPABILITIES)[number]\n): {\n  code: string;\n  name: string;\n  state: string;\n  status: 'live' | 'planned' | 'not_covered';\n  eta: string | null;\n  sourceLabel: string | null;\n} {\n  return {\n    code: cap.code,\n    name: cap.name,\n    state: cap.state,\n    status: cap.status,\n    eta: cap.eta,\n    sourceLabel: cap.source ? cap.source.label : null,\n  };\n}\n\ninterface CoverageCountyRow {\n  code: string;\n  name: string;\n  state: string;\n  status: CountyCoverage['status'];\n  eta: string | null;\n  sourceLabel: string | null;\n  propertyCount: number;\n}\n\n/**\n * GET /api/coverage\n *\n * County coverage from the canonical capability registry (the ONLY\n * source of coverage truth) plus the user's own watchlist grouped by\n * county identity. A property without county identity is reported as\n * `unknown` — never folded into a covered county (state is NOT a routing\n * input). The roadmap lists the registry as-is, including counties the\n * user has no properties in: that is the designed honesty (planned and\n * not-covered counties are facts about the product, not invented data —\n * and no property counts are ever fabricated for them).\n */\nexport async function GET(request: NextRequest) {\n  const NO_STORE = { 'Cache-Control': 'no-store' } as const;\n  try {\n    const user = await getUserFromRequest(request);\n    if (!user) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401, headers: NO_STORE }\n      );\n    }\n\n    const items = await listWatchlistItems(user.id);\n    const byCounty = new Map<\n      string,\n      {\n        name: string;\n        state: string;\n        coverage: CountyCoverage;\n        count: number;\n      }\n    >();\n    let unknownCount = 0;\n\n    for (const item of items) {\n      const identity = countyIdentityForProperty(\n        item.county ?? undefined,\n        item.state\n      );\n      // The list view uses the explicit identity only (no per-property\n      // county-record backfill — this endpoint is a light projection;\n      // the deep-dive carries the full backfill).\n      const coverage = resolveCountyCoverage(identity, null);\n      if (coverage.status === 'unknown') {\n        unknownCount += 1;\n        continue;\n      }\n      const key = coverage.county.code;\n      const existing = byCounty.get(key);\n      if (existing) {\n        existing.count += 1;\n      } else {\n        byCounty.set(key, {\n          name: coverage.county.name,\n          state: (item.state ?? '').toUpperCase() || '—',\n          coverage,\n          count: 1,\n        });\n      }\n    }\n\n    const counties: CoverageCountyRow[] = [...byCounty.values()].map(\n      (entry) => {\n        const cap = COUNTY_CAPABILITIES.find(\n          (c) => c.code === entry.coverage.county!.code\n        );\n        return {\n          code: entry.coverage.county!.code,\n          name: entry.coverage.county!.name,\n          state: cap ? cap.state : entry.state,\n          status: entry.coverage.status,\n          eta:\n            entry.coverage.status === 'planned' ? entry.coverage.eta : null,\n          sourceLabel:\n            entry.coverage.status === 'live'\n              ? entry.coverage.source.label\n              : null,\n          propertyCount: entry.count,\n        };\n      }\n    );\n    // Live first, then planned, then not covered; alpha within a tier.\n    const ORDER: Record<string, number> = {\n      live: 0,\n      planned: 1,\n      not_covered: 2,\n    };\n    counties.sort(\n      (a, b) =>\n        ORDER[a.status] - ORDER[b.status] || a.name.localeCompare(b.name)\n    );\n\n    return NextResponse.json(\n      {\n        coverage: {\n          counties,\n          unknownCount,\n          roadmap: COUNTY_CAPABILITIES.map(capabilityRow),\n        },\n      },\n      { headers: NO_STORE }\n    );\n  } catch (error) {\n    console.error('Error in /api/coverage:', error);\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: NO_STORE }\n    );\n  }\n}\n"}],"isError":false,"timestamp":1788196283589}}
{"type":"message","id":"1a368b14","parentId":"6b328d36","timestamp":"2026-08-31T17:11:23.589Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-96dc46833d54e9ad","toolName":"read","content":[{"type":"text","text":"/**\n * Screening input assembly (Task 6) — the single source of truth for the\n * decision-table inputs, shared by the worker (which evaluates) and the\n * enqueue route (which computes the idempotency signature). Inputs are\n * ALWAYS re-read server-side at call time; no client state is trusted.\n */\nimport { getCountyRecord } from '@/lib/firestore/county-records';\nimport { getLatestRecordedSearch } from '@/lib/firestore/recorded-documents';\nimport { getWatchlistItem } from '@/lib/firestore/properties';\nimport { isCountySnapshotStale } from '@/lib/county-records/config';\nimport {\n  resolveCountyCoverage,\n  type CountyCoverage,\n} from '@/lib/county-records/capabilities';\nimport type {\n  CountyIdentity,\n  StoredCountyRecord,\n} from '@/types/county-records';\nimport type { ScreenedCountyState, ScreeningInputs } from './policy';\n\n/**\n * The canonical coverage for screening (Task 2): the property's explicit\n * county identity, or — for legacy properties — the source provenance of\n * a CONFIRMED snapshot, resolved through the same capability registry the\n * property-detail and coverage APIs use. The enqueue route, the retry\n * route, the queue listing, and the worker all gate/evaluate on this one\n * resolver; no client-asserted capability or revision is ever trusted.\n * Unknown / planned / not-covered all fail closed.\n */\nexport function coverageForScreening(\n  county: CountyIdentity | null | undefined,\n  record: StoredCountyRecord | null\n): CountyCoverage {\n  return resolveCountyCoverage(\n    county ?? null,\n    record?.snapshot?.provenance?.sourceId ?? null\n  );\n}\n\n/**\n * The county record's derived state for screening (the same mapping the\n * county route uses, minus the route payloads).\n */\nexport function countyStateForScreening(\n  record: StoredCountyRecord | null\n): ScreenedCountyState {\n  if (!record) return null;\n  const revision = record.revision;\n  switch (record.status) {\n    case 'unsupported_county':\n      return { state: 'unsupported_county', revision };\n    case 'no_match':\n      return { state: 'no_match', revision };\n    case 'confirmation_required':\n      return { state: 'confirmation_required', revision };\n    case 'source_error':\n      return { state: 'source_error', revision };\n    case 'confirmed': {\n      if (!record.snapshot) return { state: 'source_unavailable', revision };\n      if (record.lastRefresh && record.lastRefresh.ok === false) {\n        return {\n          state: record.lastRefresh.error ? 'refresh_failed' : 'source_error',\n          revision,\n          snapshot: record.snapshot,\n        };\n      }\n      return {\n        state: isCountySnapshotStale(record.snapshot) ? 'stale' : 'loaded',\n        revision,\n        snapshot: record.snapshot,\n      };\n    }\n    default:\n      return { state: 'source_error', revision };\n  }\n}\n\n/**\n * Build the decision-table inputs for one property from current stored\n * state (the watchlist item, the county record, the latest recorded\n * search).\n */\nexport async function buildScreeningInputs(\n  ownerUid: string,\n  propertyId: string\n): Promise<ScreeningInputs> {\n  const watchlist = await getWatchlistItem(ownerUid, propertyId);\n  const county = await getCountyRecord(ownerUid, propertyId);\n  const recorded = await getLatestRecordedSearch(ownerUid, propertyId);\n  // M1/M2: screening uses the SAME county/capability lookup as the rest\n  // of the product (explicit county identity, or a confirmed snapshot's\n  // source provenance). Unknown / planned / not-covered all fail closed.\n  const countyCoverage = coverageForScreening(watchlist?.county ?? null, county);\n  return {\n    countyCoverage,\n    county: countyStateForScreening(county),\n    recordedStatus: recorded?.status ?? null,\n    recordedDocuments: recorded?.documents ?? [],\n    recordedAsOf: recorded?.completedAt ?? null,\n    countySourceId: county?.snapshot?.provenance?.sourceId ?? null,\n  };\n}\n"}],"isError":false,"timestamp":1788196283589}}
{"type":"message","id":"4b06c0f4","parentId":"1a368b14","timestamp":"2026-08-31T17:11:36.260Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Interesting. In other words:\n\n- `/api/coverage` deliberately uses explicit identity only (\"a lightweight projection; no per-property county-record backfilling — the deep-dive carries the full backfill\"). However, the deep-dive (properties/[id]/route.ts) passes `null` as provenance! So the \"deep-dive carries the full backfill\" comment is **wrong** — the deep-dive doesn't backfill either. This is the discrepancy: property-detail (the deep-dive) should be reading the sourceId of the confirmed county record and passing it in.\n\n- Screening input is passing provenance (record.snapshot.provenance.sourceId) — good.\n\nNext, let's check the recorded-documents search route (line 67) and its polling read path, plus the county-records reader `getCountyRecord`. Also, check where confirmed records store provenance (types/county-records.ts).\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-bbddee6e607c6c10","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/search/route.ts"}},{"type":"toolCall","id":"chatcmpl-tool-9bc4deb304ad43dc","name":"bash","arguments":{"command":"ls src/app/api/properties/[id]/recorded-documents/ src/app/api/properties/[id]/recorded-documents/searches/ src/app/api/properties/[id]/recorded-documents/searches/[searchId]/; echo \"===\"; sed -n '1,80p' src/types/county-records.ts 2>/dev/null || find src/types -name \"*county*\""}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":85514,"output":361,"cacheRead":0,"cacheWrite":0,"reasoning":194,"totalTokens":85875,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788196283592,"responseId":"chatcmpl-a11a98a909959116","rawS