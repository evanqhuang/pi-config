/src/types/recorded-documents.ts\n@@ -160,8 +160,29 @@\n \n /** What the list/search routes return. */\n export type RecordedSearchResponse = RecordedSearch | RecordedSearchNotFound;\n \n+/**\n+ * Client-safe coverage note attached to recorded-document READS (the\n+ * collection list and the search poll). When the property's county\n+ * coverage is no longer live — it went planned/not-covered/unknown, or\n+ * landed in the fail-closed review state after the search ran — the read\n+ * carries `authoritative: false` plus this note, so a stale county-\n+ * specific result is never presented as current authoritative data. The\n+ * stored documents remain available (they were real at retrieval time).\n+ */\n+export interface RecordedCoverageNote {\n+  status: 'live' | 'planned' | 'not_covered' | 'unknown' | 'review';\n+  county: { code: string; name: string } | null;\n+  message: string | null;\n+}\n+\n+/** A recorded read plus its coverage guard (additive fields). */\n+export type RecordedSearchGuardedResponse = RecordedSearchResponse & {\n+  authoritative: boolean;\n+  coverage: RecordedCoverageNote;\n+};\n+\n /** The query a provider is asked to answer. */\n export interface RecordedSearchQuery {\n   parcelId: string | null;\n   parcelIdFormatted: string | null;\n","firstChangedLine":164},"isError":false,"timestamp":1788198344464}}
{"type":"message","id":"be3dc3eb","parentId":"93e64cc8","timestamp":"2026-08-31T17:46:05.316Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"The L811 error in properties/page.tsx is old (already fixed by widening the pill's prop — the file was reported as clean in the previous check). The \"unused exports\" hint is as expected — next up is to use them in the recorded-documents route.\n\nNext, add a guard helper to shared.ts and wire up both GET routes.\n","thinkingSignature":"reasoning"},{"type":"text","text":"\n\nStale advisory (the L811 error was already fixed by the pill widening); the unused exports are being consumed now. Adding the guard helper to `shared.ts`:\n\n"},{"type":"toolCall","id":"chatcmpl-tool-ac7bac0a7395261a","name":"edit","arguments":{"edits":[{"newText":"import { NextResponse } from 'next/server';\nimport type { NextRequest } from 'next/server';\nimport type { StoredCountyRecord } from '@/types/county-records';\nimport { requireWatchedProperty } from '../county-records/shared';\nimport { resolveCountyCoverage, coverageNote } from '@/lib/county-records/capabilities';","oldText":"import { NextResponse } from 'next/server';\nimport type { NextRequest } from 'next/server';\nimport type { StoredCountyRecord } from '@/types/county-records';\nimport { requireWatchedProperty } from '../county-records/shared';"},{"newText":"/**\n * The canonical coverage guard for recorded-document READS (the collection\n * list and the search poll). It resolves coverage from EXACTLY the same\n * inputs the search enqueue gate uses — the explicit county plus the\n * confirmed-snapshot provenance — so a read can never disagree with what\n * the gate would do today:\n *\n *   - live:      the read stays `authoritative: true`; the result is\n *                presented as current.\n *   - not live:  the stored result is still returned (it was real when\n *                retrieved) but `authoritative: false` with a typed note,\n *                so a stale county-specific result is never presented as\n *                current authoritative data.\n */\nexport async function recordedReadGuard(\n  user: { id: string },\n  propertyId: string\n): Promise<{\n  authoritative: boolean;\n  coverage: ReturnType<typeof coverageNote>;\n}> {\n  const property = await requireWatchedProperty.__placeholder__;\n  throw new Error('unused');\n}","oldText":"/**\n * Authentication wrapper for the recorded-documents routes. (The county\n * shared's `requireWatchedProperty` does the real work; this keeps the\n * routes from importing across feature trees directly.)\n */\nexport async function requireRecordedProperty(\n  request: NextRequest,\n  params: Promise<{ id: string }>\n): Promise<WatchedPropertyAuth | NextResponse> {\n  const auth = await requireWatchedProperty(request, params);\n  return auth;\n}"}],"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/shared.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":104935,"output":680,"cacheRead":0,"cacheWrite":0,"reasoning":75,"totalTokens":105615,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788198344993,"responseId":"chatcmpl-bbf7f8366c1aef40","rawStopReason":"tool_calls"}}
