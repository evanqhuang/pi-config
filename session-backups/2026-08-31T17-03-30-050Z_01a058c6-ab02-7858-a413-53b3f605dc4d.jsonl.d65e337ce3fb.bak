bc552a016a95b40af5d487d1bf39f1e2609bdfac","name":"bash","arguments":{"command":"git status --short --branch && git worktree list --porcelain && git branch --show-current && git remote -v","timeout":30}},{"type":"toolCall","id":"call_MRziKUmPEQaDuxtpsK70BmYC|fc_00c8a41726bc552a016a95b40af5e887d1a24ba3c9b006ca57","name":"read","arguments":{"path":"docs/superpowers/plans/2026-08-23-records-agent-post-audit-completion.md"}},{"type":"toolCall","id":"call_qbkRr8a80SQ7CCr3IfQAFT4w|fc_00c8a41726bc552a016a95b40af5f487d187e998c7a2c25a0d","name":"read","arguments":{"path":"docs/records-agent-post-audit-closeout-2026-08-23.md"}},{"type":"toolCall","id":"call_bju7ijt7nqrxU2It0rJanugp|fc_00c8a41726bc552a016a95b40af5fc87d1a721d3154334daf7","name":"read","arguments":{"path":"docs/records-agent-launch-final-report.md"}},{"type":"toolCall","id":"call_z84dan45TFTCDQnkhKx3EhW1|fc_00c8a41726bc552a016a95b40af60487d1bc8b3597449e8deb","name":"todo","arguments":{"action":"list"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":23347,"output":192,"cacheRead":0,"cacheWrite":0,"reasoning":32,"totalTokens":23539,"cost":{"input":0.116735,"output":0.00576,"cacheRead":0,"cacheWrite":0,"total":0.122495}},"stopReason":"toolUse","timestamp":1788195841927,"responseId":"resp_00c8a41726bc552a016a95b402d77c87d1a6d77b65de7b9fc1","rawStopReason":"completed"}}
{"type":"message","id":"0ad509af","parentId":"6fc686c6","timestamp":"2026-08-31T17:04:11.088Z","message":{"role":"toolResult","toolCallId":"call_i054dtf2JyCV5MQnvcbayWy1|fc_00c8a41726bc552a016a95b40af5d487d1bf39f1e2609bdfac","toolName":"bash","content":[{"type":"text","text":"* feat/records-agent-launch\n?? docs/superpowers/plans/2026-08-23-records-agent-final-audit-gap-closure.md\n~/brickspect/dashboard 450773f [main]\n~/brickspect/dashboard/.worktrees/records-agent-launch a9eeff9 [feat/records-agent-launch]\nfeat/records-agent-launch\norigin\tgit@github.com:Brickspect/dashboard.git (fetch)\norigin\tgit@github.com:Brickspect/dashboard.git (push)\n"}],"isError":false,"timestamp":1788195851087}}
{"type":"message","id":"f98006cb","parentId":"0ad509af","timestamp":"2026-08-31T17:04:11.088Z","message":{"role":"toolResult","toolCallId":"call_MRziKUmPEQaDuxtpsK70BmYC|fc_00c8a41726bc552a016a95b40af5e887d1a24ba3c9b006ca57","toolName":"read","content":[{"type":"text","text":"# Records Agent Post-Audit Completion Plan\n\n## Goal\n\nClose every verified gap remaining after the first Records Agent launch-gap implementation. This is a fresh-session execution plan. Work against actual source behavior, not earlier completion claims, and preserve all intentional provider/product deferrals.\n\n## Repository and source material\n\n- Worktree: `/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch`\n- Branch: `feat/records-agent-launch`\n- Prior plans and evidence:\n  - `docs/superpowers/plans/2026-08-23-records-agent-launch-gap-closure.md`\n  - `docs/records-agent-launch-final-report.md`\n  - `docs/superpowers/ledgers/2026-08-23-records-agent-local-complete/ledger.md`\n- Original UI package: `/Users/evanhuang/Downloads/# Brickspect v2 Design Brief____Title_ Brickspect Records Agent Launch__.zip`\n- Primary package references: `design-spec.md`, `Brickspect v2.dc.html`, screenshots 01–11, and `screenshots/REVIEW-PROMPT.md`.\n\nBegin with `git status --short` and preserve all user changes. Never disable or bypass pre-commit hooks, tests, authorization checks, provider gates, CAS, or idempotency controls.\n\n## Local 9B provider contract\n\nUse the RTX 3070 text-only gateway for live Copilot/provider validation:\n\n```env\nAI_PROVIDER=local\nAI_PROVIDER_FALLBACKS=\nLOCAL_LLM_BASE_URL=http://192.168.93.107:8082/v1\nLOCAL_LLM_API_KEY=none\nLOCAL_LLM_MODEL=qwopus3.5-9b-coder-mtp\nLOCAL_LLM_TIMEOUT_MS=300000\n```\n\nConnection requirements:\n\n- Model ID: exactly `qwopus3.5-9b-coder-mtp`.\n- Base URL from this Mac: `http://192.168.93.107:8082/v1`.\n- No gateway authentication; use `none` only where an SDK requires a key.\n- Liveness probe: `GET http://192.168.93.107:8082/v1/models`. Never probe `/health`.\n- The first request after idle may take about 10 seconds; use a 300-second timeout.\n- For raw chat-completions requests, send top-level:\n\n```json\n{\n  \"model\": \"qwopus3.5-9b-coder-mtp\",\n  \"max_tokens\": 6144,\n  \"temperature\": 0,\n  \"chat_template_kwargs\": { \"enable_thinking\": false }\n}\n```\n\n- For an SDK, put `chat_template_kwargs` in `extra_body`.\n- Treat empty `message.content` as failure; record `finish_reason` and retry with a larger token budget rather than accepting a blank answer.\n- Do not parallelize live 9B calls. The gateway serializes requests and may cold-load after ten idle minutes.\n- Deterministic suites must remain network-free. Live local-model tests stay explicitly opt-in.\n- Existing live validation entry points include `scripts/validate-local-llm.ts` and `src/app/api/chat/__tests__/local-live.test.ts`; update them if the product stream contract changes.\n\nPreflight before live validation:\n\n```bash\ncurl --fail --silent --show-error http://192.168.93.107:8082/v1/models\n```\n\nIf off-LAN, use `ssh -L 8082:localhost:8082 gpu` and temporarily set the base URL to `http://localhost:8082/v1`. Do not commit machine-specific `.env.local` values.\n\n## Scope boundaries\n\nKeep these deferred and honest:\n\n- Live Recorder automation remains blocked until its source contract and environment gate are approved.\n- Additional live county adapters, production worker hosting, distributed rate limiting, deployment, real mail, RentCast, and Value-Add remain separate work.\n- Financials remains the recorded agent-pending/owner-document decision; do not invent financial data or a new import product without a new product decision.\n- Comps must remain empty or agent-pending when no defensible source row exists.\n\n## Task 1 — Repair live Copilot proposal streaming\n\n### Problem\n\n`records-copilot-provider.tsx` consumes tool-output stream parts but drops the structured `propose_action` result. The assistant message therefore lacks `proposal` until a reload or seeded fixture supplies it.\n\n### Implementation\n\n- Inspect the exact stream-part shape produced by the current AI SDK and `readCopilotStream` before editing.\n- Add a narrow validated parser for `propose_action` tool output. Reuse the canonical proposal schema and fingerprint rules; do not maintain a second permissive shape.\n- Attach a valid proposal to the in-memory assistant message as soon as its tool output arrives.\n- Persist the same validated proposal through the existing assistant-message persistence path.\n- Ignore malformed, unknown, oversized, or unauthorized proposal output and expose a bounded error state without enabling confirmation.\n- Preserve text streaming, tool activity, abort/incomplete behavior, and plain assistant messages.\n- Keep tools read-only; only the separate confirmed action endpoint may mutate data.\n\n### Tests\n\n- Parser/unit test for valid and malformed tool outputs.\n- Provider test exercising real stream parts from text delta through `tool-output-available` and asserting immediate `message.proposal`.\n- Persistence/reload test proving the proposal representation is stable.\n- Component/E2E test proving the confirmation card appears without reload.\n- Negative tests: malformed output, unknown action, interrupted stream, stale revision, tampered fingerprint, duplicate confirmation, and authorization failure all execute zero unintended writes.\n- Keyboard Tab-cycle, Escape, and mobile confirmation coverage.\n\n### Live 9B proof\n\nAfter deterministic tests pass, run the opt-in local 9B chat test with the configuration above. Exercise a prompt that yields one allowlisted `propose_action`, verify non-empty streamed text/tool output, verify the confirmation card appears, and do not confirm against non-fixture data. Record elapsed time, model ID, and result without recording prompts containing PII.\n\n### Acceptance\n\nA valid proposal from a live stream appears immediately and survives reload. No unconfirmed, malformed, stale, tampered, duplicate, or cross-user proposal mutates state.\n\n## Task 2 — Enforce county capability in screening\n\n### Implementation\n\n- Add canonical county capability to every screening-row contract using the same registry as property detail and coverage APIs.\n- Disable screen and re-screen controls for `NOT_COVERED`, planned/agent-pending, and unknown counties.\n- Render the design-approved not-covered/waitlist state instead of an executable screening action.\n- Enforce the identical rule in screening creation and retry APIs. UI disabling is not authorization.\n- Ensure unsupported attempts create no screening run, agent task, event, action item, or projection.\n- Add county/coverage to the screening table. Add client/thumbnail only if supported by real existing data; otherwise document their omission rather than fabricating values.\n- Correct “disqualifys” and audit nearby screening copy.\n\n### Tests\n\n- Supported Cuyahoga screen and re-screen behavior remains unchanged.\n- Planned, unsupported, and unknown county rows render no executable screen action.\n- API zero-write tests for create and retry across all unavailable capability states.\n- Stale capability/revision and cross-user tests.\n- Desktop/mobile table behavior and keyboard operation.\n\n### Acceptance\n\nNo unavailable county can be screened through UI or API, and the user sees an explicit coverage reason and next action.\n\n## Task 3 — Remove state-only Cuyahoga routing and reconcile legacy records\n\n### Implementation\n\n- Remove or narrow the state-only `isCountySupported` contract. The Cuyahoga provider must require explicit normalized Cuyahoga identity or a verified migration signal.\n- Change provider input/selection so an Ohio address alone can never select Cuyahoga.\n- Reconcile legacy properties that have no normalized county but possess a confirmed Cuyahoga snapshot:\n  1. Prefer explicit normalized county.\n  2. Allow verified existing source provenance only as a bounded migration signal.\n  3. Persist normalized county through an idempotent migration/reconciliation path.\n  4. Never infer county from state alone.\n- Make property detail, county mutation routes, worker selection, coverage, screening, and recorded-document routes use the same result.\n- Add explicit coverage guards to recorded-document search, refresh, confirm, and related enqueue paths.\n\n### Tests\n\n- Any Ohio/non-Cuyahoga address is rejected at the provider boundary.\n- Explicit Cuyahoga remains accepted.\n- Unknown county remains unknown and creates zero work.\n- Legacy confirmed Cuyahoga provenance reconciles consistently and idempotently.\n- Contradictory explicit county versus legacy provenance fails closed and is surfaced for review.\n- Recorded-document search/refresh/confirm zero-write tests for planned, unsupported, and unknown properties.\n\n### Acceptance\n\nNo executable path can route a property to Cuyahoga based on state alone, and legacy confirmed records produce one consistent coverage result across every route and UI.\n\n## Task 4 — Complete the trust/provenance presentation contract\n\n### Implementation\n\n- Replace URL-only provenance helpers with one typed presentation contract covering:\n  - trust/status state,\n  - provider mode (`fixture`, `live`, `cached`, `manual`, `modeled` where applicable),\n  - source identity and safe link label,\n  - confidence as a percentage or explicit unavailable value,\n  - freshness/as-of timestamp and stale/reverify behavior,\n  - searched scope/index count for empty or incomplete results.\n- Keep domain records authoritative; the presentation mapper must not infer facts or confidence.\n- Apply the contract consistently to county records, recorded documents, screening, dashboard/feed cards, agent task links, owner requests/mail, and deep-dive summaries.\n- Move required record-level metadata close to the row it qualifies; one generic footer is insufficient.\n- Change recorded-document empty copy to identify the searched indices/scope and date. Distinguish “none found in searched indices” from “search incomplete.”\n- Keep fixture `.example` links visibly demo/non-official.\n- Preserve bounded unknown states and prohibit clearance claims based merely on completed tasks.\n\n### Tests\n\n- Table-driven mapper tests covering every supported state/mode combination.\n- Component contract tests on every required surface.\n- Fixture versus live link/source treatment.\n- Unknown confidence and missing freshness behavior.\n- Empty-complete versus search-incomplete copy.\n- Regression scan for ambiguous “all clear” or official wording on fixture links.\n\n### Acceptance\n\nEvery record-derived presentation communicates source, mode, state, and freshness without overstating authority. Confidence is shown only when it exists and is always a percentage.\n\n## Task 5 — Make Copilot action auditing durable\n\n### Implementation\n\n- Stop fire-and-forget action-audit writes.\n- Define the execution contract so a confirmed action cannot silently succeed without a durable audit outcome.\n- Prefer a server-side durable execution record with explicit states such as `accepted`, `executing`, `succeeded`, and `failed`, keyed idempotently by proposal fingerprint/confirmation ID.\n- Re-check owner, target, action allowlist, revision, and eligibility before execution.\n- Redact sensitive inputs before persistence.\n- Ensure retries return the existing terminal outcome rather than duplicating action effects.\n- If atomic coupling to the domain mutation is impossible, document and test the recovery/reconciliation behavior.\n\n### Tests\n\n- Audit persistence failure cannot produce an unrecorded successful mutation.\n- Duplicate confirmation returns one action and one audit lifecycle.\n- Crash/retry between accepted and succeeded reconciles safely.\n- Redaction, cross-user, stale revision, and malformed proposal tests.\n\n### Acceptance\n\nEvery attempted confirmation has a durable, owner-scoped, redacted outcome, and every successful domain action can be traced to exactly one accepted confirmation.\n\n## Task 6 — Correct demo seed state and prove idempotency\n\n### Implementation\n\n- Remove the invalid stored county status `searching` unless an end-to-end schema/state-machine change explicitly adds it.\n- Prefer representing work in progress through the existing valid task/search model and derive public status from that model.\n- Ensure the seed covers supported, planned, blocked/search-incomplete, and not-covered states without invalid domain values.\n- Keep stable IDs for properties, tasks, feed items, actions, requests, and runs.\n- Make seed documentation use the exact Records Agent seed command, worker command, route crawl, and screenshot audit commands.\n\n### Tests\n\n- Schema/type test rejects unsupported stored statuses.\n- Public API/UI test renders the intended in-progress state from valid seeded records.\n- Run reset + seed twice against the Firestore emulator and compare IDs/document counts and representative payload hashes.\n- Run the UI audit tour and verify all 11 reference screen categories or an explicitly documented deferred state.\n\n### Acceptance\n\nThe demo seed contains only valid domain states, is idempotent against real emulator writes, and reproducibly drives the documented QA screens.\n\n## Task 7 — Authentication, theme, shell, and task semantics cleanup\n\n### Implementation\n\n- Separate development bypass from Google authentication in the UI. A visible “Continue with Google” control must always execute Google auth; expose a separately labeled “Continue in demo mode” control only when development bypass is enabled.\n- Force the recorded product decision that dark mode is unsupported: use light theme consistently and stop advertising `light dark` until dark surfaces are implemented. Do not delete reusable future tokens unnecessarily.\n- Assign recorded-document search work to the Records Agent lane, not Search Agent.\n- Replace generic `Property {id}` task labels with a real address/title when available, retaining a bounded fallback.\n- Decide and document whether the shell field is Copilot-only or global search. Align label, behavior, and design copy; do not label a chat-only action as general property/record search.\n\n### Tests\n\n- Development Google and demo controls invoke distinct paths and have accurate labels.\n- Production never exposes development bypass.\n- Theme metadata/provider behavior is consistently light.\n- Agent lane and property-label tests.\n- Omnibox accessible-name and behavior tests.\n\n### Acceptance\n\nEvery visible control performs its labeled action, launch theme behavior is internally consistent, and task ownership/labels accurately describe the underlying work.\n\n## Task 8 — Runbook and documentation correctness\n\n### Implementation\n\n- Replace global `pkill -f \"run-agent-worker\"` with termination of only the recorded worker process group/tree. Preserve unrelated workers.\n- Correct the Recorder gate variable everywhere to `RECORDER_AUTOMATION_APPROVED`.\n- Update `src/app/api/test-routes.md` and closeout docs to current provider chain, UI-message streaming behavior, exact local-stack commands, Records demo seed, worker startup, local 9B live validation, and route/UI audit commands.\n- Document the local 9B connection contract from this plan without committing credentials beyond the intentional no-auth value `none`.\n- Ensure the runbook probes `/v1/models` at the configured base URL; it must not use `/health` or the retired port 8090.\n\n### Tests\n\n- Shell test proving `stop` kills recorded process descendants and leaves an unrelated `run-agent-worker` process alive.\n- Documentation command smoke checks where safe.\n- Environment-variable spelling regression test or shared constant where practical.\n\n### Acceptance\n\nThe runbook affects only processes it owns, and every documented command/variable matches executable code.\n\n## Task 9 — Full verification and closeout\n\nRun focused diagnostics and tests after each task. At the end:\n\n1. `git diff --check`\n2. LSP diagnostics on every edited source file.\n3. Type-check.\n4. ESLint and scoped Prettier.\n5. Complete unit suite.\n6. Complete integration suite serially where required.\n7. Focused Records Agent Playwright suites.\n8. Records route crawl and UI interaction audit.\n9. Firestore seed-twice rehearsal.\n10. Local 9B `/v1/models` preflight, `scripts/validate-local-llm.ts`, opt-in local chat test, and one live streamed proposal exercise.\n11. County rejection and zero-write rehearsal.\n12. Copilot duplicate/audit-failure recovery rehearsal.\n13. Runbook unrelated-worker preservation rehearsal.\n\nRecord exact commands, exits, suite/test counts, local model ID, and bounded non-sensitive live-test evidence in the ledger and final report. Do not call cloud fallbacks during local-provider proof; set `AI_PROVIDER_FALLBACKS=` explicitly. Restore generated files and leave a clean worktree with no secrets or test artifacts.\n\n## Execution strategy\n\nUse one fresh focused implementation agent per task or smaller independent slice. Suitable mechanical work for the local 9B coding agent includes isolated tests, typed mappers, copy cleanup, documentation, and bounded UI changes. Keep architecture-sensitive work—provider routing, durable Copilot auditing, migrations, and authorization—in the primary implementation session, with independent verification afterward.\n\nDo not run multiple local 9B requests concurrently. Do not let a broad exploration agent consume the implementation budget. Each implementer must receive exact owned files, required behavior, forbidden changes, and one focused verification command.\n\n## Definition of done\n\n- Live streamed proposals render immediately, persist, and confirm through exactly one authorized action.\n- Unsupported/planned/unknown counties cannot screen or enqueue county/Recorder work through any UI or API.\n- Cuyahoga provider selection never relies on state alone; legacy confirmed records reconcile consistently.\n- Provenance is complete and consistent across every record-derived surface.\n- Copilot action outcomes are durably auditable and idempotent.\n- Demo data uses valid states and is idempotent against real emulator writes.\n- Authentication labels, theme behavior, task ownership, and shell behavior are accurate.\n- Runbook shutdown is process-owned and documentation matches code.\n- Deterministic suites pass, live local 9B validation passes with the exact 3070 gateway contract, final review finds no unresolved actionable issue, and closeout evidence is updated.\n"}],"isError":false,"timestamp":1788195851088}}
{"type":"message","id":"210fc8e7","parentId":"f98006cb","timestamp":"2026-08-31T17:04:11.088Z","message":{"role":"toolResult","toolCallId":"call_qbkRr8a80SQ7CCr3IfQAFT4w|fc_00c8a41726bc552a016a95b40af5f487d187e998c7a2c25a0d","toolName":"read","content":[{"type":"text","text":"# Records Agent — post-audit completion closeout (2026-08-23 plan)\n\nThis document closes the nine-task completion plan in\n`docs/superpowers/plans/2026-08-23-records-agent-post-audit-completion.md`.\nIt records what each task changed, what was verified at closeout, and the\nresidual (deliberate) state of the local stack. The per-task design\nrationale lives in section 10 of\n`docs/records-agent-launch-final-report.md`; this document is the\nverification record.\n\n## Commits (oldest → newest, this closeout pass)\n\n| Task                                    | Commit    | Subject                                                     |\n| --------------------------------------- | --------- | ----------------------------------------------------------- |\n| 1 — live Copilot proposal streaming     | `346765c` | repair proposal persistence + in-flight attachment          |\n| 2 — county capability in screening      | `ae7c143` | shared `resolveCountyCoverage` gate, zero-write             |\n| 3 — state-only Cuyahoga removal         | `3b273a6` | registry-only provider selection, idempotent reconcile      |\n| format                                  | `760710c` | prettier normalization of in-flight files                   |\n| 4 — trust/provenance presentation       | `7654baa` | typed `records-provenance` contract, consumers              |\n| 5 — durable Copilot action auditing     | `ae6f77a` | claim-before-execute execution records, `audit_unavailable` |\n| 6 — demo seed correctness + idempotency | `1484465` | valid-model-only seed, policy-derived runs, time anchor     |\n| 7 — auth/theme/task semantics           | `1b2976e` | one light theme, WCAG contrast test, retry reset            |\n| 8 — runbook/documentation               | `1a4301f` | final report corrected, section 10 commands                 |\n\n## Verification at closeout (this branch, emulator-only)\n\n### Static\n\n- `npx tsc --noEmit` — **0 errors**.\n- `npx eslint .` — **0 errors**, 45 warnings (the pre-existing advisory\n  set; none introduced by this pass).\n- `npx prettier --check .` — the repo carries **pre-existing\n  repo-wide formatting drift** (the `origin/main` worktree fails 109\n  files under the same pinned prettier 3.6.2; this branch fails 44,\n  all from earlier branch work or the base). Every file written or\n  edited in this nine-task pass was formatted at commit time. A\n  repo-wide `prettier --write` was deliberately NOT run on a launch\n  branch; it is a standalone housekeeping commit when the base is\n  green.\n\n### Unit\n\n- `npx jest --selectProjects unit` — **96 suites passed / 1 skipped;\n  1208 tests passed / 2 skipped** (baseline before this pass: 87\n  suites / 1068 tests; the pass adds the copilot-proposal,\n  copilot-actions, seed, retry-semantics, theme-contrast, and\n  recorded-documents config suites).\n\n### Live rehearsal (local stack, emulator only)\n\nStack brought up with `scripts/records-local-stack.sh start`\n(Firestore emulator via docker compose on 8095, project\n`demo-brickspect-dashboard`; dev server 3210 with dev auth; agent\nworker). The MCP server (8090 — the Crexi MCP server, **not** the\nmodel gateway) and the local 9B model gateway were absent; per the\nrunbook's design the stack starts anyway and fixture mode is\nunaffected.\n\nFor live chat rehearsals the model gateway's connection contract is:\n\n| Setting  | Value                                     |\n| -------- | ----------------------------------------- |\n| Base URL | `http://192.168.93.107:8082/v1`           |\n| Model id | `qwopus3.5-9b-coder-mtp`                  |\n| API key  | `none` (intentionally auth-less)          |\n| Liveness | `GET {base}/models` — **never** `/health` |\n| Timeout  | 300 s (cold start after idle takes ~10 s) |\n\nConfigured in `.env.local` via `AI_PROVIDER=local`,\n`LOCAL_LLM_BASE_URL`, `LOCAL_LLM_API_KEY=none`, and\n`LOCAL_LLM_MODEL`. `AI_PROVIDER_FALLBACKS=openrouter` is the\nconfigured cloud fallback — live-only proofs override it with an\nempty `AI_PROVIDER_FALLBACKS=` per invocation so a gateway failure\ncannot silently hit a cloud provider. The runbook reports (but does\nnot require) gateway reachability at start time.\n\n**Seed idempotency, proven over the wire** (not just by unit test): a\nthrowaway harness (`.records-local-stack/hash-seed-state.ts`,\ngitignored) hashed the entire demo user subtree — 30 documents across\nthe nine user-level collections plus property subcollections,\nkey-sorted stable JSON, sha256. Sequence:\n\n1. `npm run seed:records-demo` (first seed — creates the anchor)\n2. hash → `d3f277268da45ada803daeba7f6aad7595e2c21b24cd9fa5e9b8e2aa29453b62`\n   (30 docs; anchor `1788110915419` = 2026-08-30T17:28:35.419Z)\n3. `npm run seed:records-demo` again (reset + re-write; anchor\n   preserved — the seeder's own log shows the same anchor timestamp)\n4. hash → **identical** `d3f27726...` (30 docs; same anchor)\n\nTwo consecutive live seeds produce byte-identical emulator state; the\nanchor is created once and preserved across resets (rotate with\n`-- --fresh-anchor`).\n\n**Live 9B rehearsals (re-verification closeout).** The 9B gateway\n(`AI_PROVIDER=local`, `AI_PROVIDER_FALLBACKS=` empty so nothing could\nreach a cloud provider) was up for these runs — the \"gateway absent\"\nnote above describes the earlier closeout run only. All three live\nexercises used dev-bypass auth (`ALLOW_DEV_AUTH=true`, user\n`local-dev-user`); the gitignored exercise scripts live in\n`.records-local-stack/`.\n\n1. **Live `propose_action` streaming (Task 1 proof).**\n   `.records-local-stack/live-proposal-exercise.ts` POSTed `/api/chat`\n   with a prompt instructing the model to call `propose_action` with\n   fixed arguments (`actionType=county_confirm`,\n   `targetId=demo-cuyahoga-ambiguous`, one summary; **no revision and\n   no fingerprint in the prompt**). The UI stream carried the tool\n   events (`tool-input-available`, then `tool-output-available`); the\n   tool result (JSON-stringified by the route) carried\n   `proposal: true` and a 64-hex fingerprint. The script recomputed\n   that fingerprint with an independent sha256 over\n   `canonicalProposalString` — it matched, which the model could not\n   have produced on its own, so the SDK had genuinely executed the\n   server tool. The exchange persisted under\n   `users/local-dev-user/copilotThreads/{threadId}/messages`; the\n   bounded retry produced 11 threads, every assistant message quoting\n   the same server-computed fingerprint\n   `9d591537…92fca6`. The script never called the execute endpoint.\n2. **Screening county rejection is zero-write (Task 2 proof).**\n   `.records-local-stack/live-screening-rehearsal.ts` POSTed\n   `/api/screening` for `demo-portage-uncovered` (Portage County —\n   uncovered). Result: HTTP **422**\n   `{error: 'not_covered', rejected: [{propertyId, coverage}]}` — the\n   zero-write gate fails closed **before** `enqueueTask`. A\n   stable-sorted hash of the demo user's entire subtree (32 docs) was\n   **byte-identical before and after** the call.\n3. **Execute-twice durable audit (Task 5 proof).**\n   `.records-local-stack/live-execute-twice.ts` POSTed\n   `/api/copilot/proposals/execute` twice for `county_refresh` on\n   `demo-cuyahoga-confirmed` (record revision 3 — the demo's only\n   executable county action; the ambiguous record's 2-candidate state\n   makes `county_confirm` ineligible by design). Call 1 → **200\n   `executed`**, exactly one county task enqueued (0 → 1); call 2\n   (same fingerprint, same idempotency key) → **200 `executed`** — a\n   REPLAY of the terminal record, **no re-enqueue** (1 → 1). The\n   durable record\n   `users/local-dev-user/copilotActionExecutions/{fingerprint}`\n   (`2b875fcf…0282cbe`) was terminal: `state=succeeded`,\n   `code=executed`, `action=county_refresh`, `attempts=1` — claimed\n   before the domain action, finalized after, and untouched by the\n   duplicate.\n\n### Playwright records suite\n\n`npm run test:playwright:records` (bounded runner, own `next dev`\nwebServer on 3210, emulator only): **270 passed / 0 failed in 23.4m**\nacross all six viewport projects — the unauthenticated route crawl\n(42), the deterministic interaction flows (48), and the authenticated\nUI audit tour (180: login, dashboard, properties list, all six demo\nproperties × the four deep-dive tabs, the screening page with the six\nseeded run states, the agents page with the seeded task queue) — every\npage under the hard failure policy (no failed resources, no JS page\nerrors, no horizontal overflow, zero axe WCAG A/AA violations,\nexception table empty). Runner exit 0; the worker it spawned stopped\ncleanly on SIGTERM (lease released, no stray `failed` task — the\nshutdown path this pass pinned). One runbook quirk hit and fixed\nalong the way: the suite must own port 3210 itself — the bounded\nrunner's webServer refuses a pre-started dev server (`already used …\nset reuseExistingServer:true`), so the runbook's dev/worker must be\nstopped first while the docker emulator stays up.\n\n## Residual state, deliberately kept\n\n- **Known nit 5 (chat-session toolCall audit rows)** remains\n  self-bound as documented in the final report's \"Known nits\" — the\n  _execute_ path is what this pass made durable; the session-level\n  audit of the chat stream is unchanged.\n- **Live Recorder automation** remains gated on\n  `docs/records/cuyahoga-recorder-source-contract.md`\n  (`approved: false`); no live county/recorder network was used at\n  any point in this closeout.\n- **Rent-roll import (M5)** remains deferred by product decision.\n- **The repo-wide prettier drift** is a base-repo housekeeping item,\n  not a launch blocker (see Static above).\n- **Dark mode** is now structurally absent (provider, tokens, and\n  variants all removed; the theme-contrast test fails the build if\n  any of them reappear) — the earlier \"kept as future\n  infrastructure\" wording is corrected in the final report.\n\n## Commands to reproduce this closeout\n\n```sh\nscripts/records-local-stack.sh start     # emulator + dev server + worker\nnpm run seed:records-demo                # idempotent demo seed\nnpm run worker:agent                     # one worker pass over the queue\nnpm run test:unit                        # unit project\nnpm run test:playwright:records          # full records e2e suite\nnpx tsc --noEmit && npx eslint .         # static gates\nbash scripts/__tests__/records-local-stack-stop.sh\n                                         # runbook stop/isolation test\n# live 9B rehearsals (dev server on 3210 + emulator on 8095; scripts\n# are gitignored under .records-local-stack/):\nGCP_PROJECT_ID=demo-brickspect-dashboard \\\nFIRESTORE_EMULATOR_HOST=localhost:8095 \\\nnpx tsx .records-local-stack/live-proposal-exercise.ts\nGCP_PROJECT_ID=demo-brickspect-dashboard \\\nFIRESTORE_EMULATOR_HOST=localhost:8095 \\\nnpx tsx .records-local-stack/live-screening-rehearsal.ts\nGCP_PROJECT_ID=demo-brickspect-dashboard \\\nFIRESTORE_EMULATOR_HOST=localhost:8095 \\\nnpx tsx .records-local-stack/live-execute-twice.ts\n```\n"}],"isError":false,"timestamp":1788195851088}}
{"type":"message","id":"e9b9fced","parentId":"210fc8e7","timestamp":"2026-08-31T17:04:11.088Z","message":{"role":"toolResult","toolCallId":"call_bju7ijt7nqrxU2It0rJanugp|fc_00c8a41726bc552a016a95b40af5fc87d1a721d3154334daf7","toolName":"read","content":[{"type":"text","text":"# Records Agent — local-complete final report\n\nStatus: COMPLETE (local scope). Branch `feat/records-agent-launch`, worktree\n`.worktrees/records-agent-launch`. This report records what was built, the\nexact verification evidence, the recovery rehearsals, the remaining external\ngates, and the intentional deferrals.\n\n## 1. What \"local-complete\" means here\n\nEverything a developer can verify on a laptop now works end to end against\nlocal infrastructure only:\n\n- **County records (Cuyahoga)** — live GIS is the real source; local mode\n  serves deterministic fixtures behind the same provider interface\n  (`COUNTY_RECORDS_MODE=fixture`), with a revision/CAS contract so a live\n  and a fixture source are interchangeable at the boundary.\n- **Recorded documents (Recorder)** — the manual-review workflow (search →\n  triage → confirm) is fully implemented against fixtures. **Live Recorder\n  automation is NOT implemented**: it stays gated on\n  `docs/records/cuyahoga-recorder-source-contract.md` (currently\n  `approved: false`) AND an explicit environment gate. Nothing in the\n  default verification touches the Recorder.\n- **Screening** — deterministic, versioned policy; manual legacy verdicts\n  migrate to immutable `legacyImported` runs; every verdict is now a\n  replayable, attributable run rather than a mutable field.\n- **Agent task queue** — durable, lease-bound, cross-user worker; typed\n  actions; command dashboard with cancel/retry/priority under CAS.\n- **Domain events + projections** — transactional outbox; projector with\n  leases, bounded retries, idempotent (deterministic-id) projections into\n  `feedItems`/`actionItems`; replay and reconciliation CLIs.\n- **Owner-document requests** — draft → explicit owner approval\n  (content-hash-bound) → fixture-mail send with per-attempt idempotency;\n  no real mail is ever sent in local mode.\n- **Persistent global Copilot** — threads persisted per user, an\n  Admin-SDK-only tool registry (default-deny allowlist, redacted audit,\n  8KB-bound results, deep-link validation), a global panel with the\n  `NEXT_PUBLIC_COPILOT_DISABLED=true` rollback flag (removes the UI,\n  never the data).\n- **Deep-dive / property / navigation / Comps** — `?tab=` deep links that\n  survive auth bounces, honest freshness on third-party data, an honest\n  comps empty state (RentCast is on the roadmap, never labeled live),\n  atomic track-and-open, and a bounded (10s) server-side Crexi call so an\n  unreachable source degrades instead of hanging.\n- **Opt-in live validation** — `check-county-live.ts` (env-gated canary\n  allowlist; both canaries verified PASS against the live layer this\n  session) and `check-recorder-live.ts` (dual gate: contract approval +\n  env; refuses with exit 2 while unapproved).\n\n## 2. The local stack\n\n`scripts/records-local-stack.sh` is the runbook: `start | status | reset |\nstop`.\n\n- `start` — Firestore emulator (docker compose, project\n  `demo-brickspect-dashboard`, port 8095) → MCP server check-only on 8090\n  (refuses to start it — remediation belongs to mcp-server-go) → optional\n  9B model probe → dev server on DEDICATED port 3210 (`dev:bypass` env:\n  `ALLOW_DEV_AUTH=true`, `GOOGLE_CLOUD_PROJECT_ID=`,\n  `GOOGLE_CLOUD_PROJECT=demo-brickspect-dashboard`, emulator host, fixture\n  scenario env) with an in-command port-freshness gate → agent worker.\n- `stop` — kills only the PIDs the runbook recorded.\n- `reset` — stop + `docker compose down -v` + wipe `state/` and\n  `test-results/` + start.\n\nConstraint handled by design: Next 16 allows only ONE `next dev` per\nworktree (the `.next/dev` lock); the runbook never runs two.\n\n## 3. Default verification (all offline)\n\nNo external network, no paid provider, no live Recorder, no live model.\n\n| Check                  | Command                                                                                                   | Result                                 |\n| ---------------------- | --------------------------------------------------------------------------------------------------------- | -------------------------------------- |\n| Diff integrity         | `git diff --check`                                                                                        | clean                                  |\n| Type-check             | `npm run type-check`                                                                                      | exit 0                                 |\n| Lint                   | `npm run lint`                                                                                            | 0 errors / 50 warnings (baseline)      |\n| Prettier (touched set) | scoped `npx prettier --check`                                                                             | clean                                  |\n| Unit                   | `npx jest --selectProjects unit`                                                                          | 962 passed / 2 skipped                 |\n| Integration            | `npx jest --selectProjects integration --maxWorkers=1`                                                    | 15/15 suites, 112 passed / 3 skipped   |\n| Records e2e            | `npm run test:playwright:agent -- property-deep-dive county-records records-dashboard --project=chromium` | 20/20 (twice: warm + fresh post-reset) |\n| Route crawl            | `npm run test:playwright:records`                                                                         | 42/42, three consecutive runs          |\n\nPlaywright is bounded by design: direct `npx playwright` is guard-disabled\nin the configs; `npm run test:playwright:agent` / `test:playwright:records`\nrun under `scripts/run-playwright-agent.mjs` (process-tree timeout,\n`PLAYWRIGHT_HTML_OPEN=never`).\n\n**Route crawl** (`tests/records-e2e/route-crawl.spec.ts`): 7 routes × 6\nviewports. Hard-fails on failed document/script/style/image/font resources,\nJS page errors, viewport overflow, and unexplained console 404s (reconciled\nagainst captured XHR/fetch 404s); API 404s are informational (by-design\nhonest states). `@axe-core/playwright` runs WCAG 2.1 A+AA on every page;\nthe exception list is empty. The crawl's findings drove three real fixes\nin the login page (two contrast values, one 375px overflow).\n\n## 4. Recovery and operational rehearsals\n\nAll against the emulator only; one-off scripts in the gitignored\n`.records-local-stack/rehearsal/` directory.\n\n- **A — Legacy verdict migration.** dry-run → 43-doc pre-apply dump →\n  apply (backup-first) → verify (run written `origin: legacyImported`,\n  verdict cleared, reason preserved) → idempotent re-apply (0) → restore\n  once from the backup (post-restore dry-run identical to pre-apply).\n  Fixed a rehearsal-discovered quirk: an empty apply no longer clobbers\n  the backup (additive merge, first importedAt wins).\n- **B — Worker crash / lease.** SIGKILL residue state (live lease, dead\n  owner): a live worker never claims a live lease (observed 12s, 0\n  claims); after expiry it reclaims, completes, and releases.\n- **C — Projection crash / replay / reconcile.** Crashed claimed event\n  re-projected only after lease expiry (deterministic feed doc, no\n  duplicates on replay). Reconciliation found and repaired 20 real\n  drift cases (feed docs deleted by earlier spec cleanup while events\n  stayed `projected`); end state 21/21/0.\n- **D — Cancel/requeue CAS + immutability.** Stale revision rejected;\n  cancel → requeue → worker completion all under CAS; succeeded tasks\n  reject both cancel and retry and stay byte-stable.\n- **E — Fixture-mail idempotency.** Double send with one idempotency key\n  → exactly one outbox record; reconciliation confirms; fresh attempt →\n  fresh record. PASS.\n- **F — Copilot flag rollback.** With `NEXT_PUBLIC_COPILOT_DISABLED=true`,\n  the button takes the legacy navigation path and no panel ever mounts;\n  the control (flag off) opens the panel; thread data survives both\n  states.\n\n## 5. External gates and deferrals (intentional)\n\n- **Task 5B — live Recorder automation.** Gated on explicit approval in\n  `docs/records/cuyahoga-recorder-source-contract.md` (`approved: false`)\n  AND an environment gate. `check-recorder-live.ts` refuses (exit 2)\n  until both exist. Fixture/manual behavior is the local-complete\n  contract.\n- **Production readiness** — distributed rate limiting, worker hosting,\n  scheduler, metrics, backups, secrets/networking, production mail, and\n  deployment rollback are documented in\n  `docs/superpowers/plans/records-agent-production-readiness.md` and\n  deliberately out of local scope.\n- **Capability expansions (non-blocking)** — additional counties\n  (`records-agent-additional-counties.md`) and RentCast comps\n  (`records-agent-rentcast-comps.md`).\n\n## 6. Commits (oldest → newest)\n\n`aab5b1e`, `19009ae` (Task 8) · `b04de81`, `2cb9bbf` (Task 9) · `b5e2066`,\n`ffbfc99` (Task 10) · `e62d0e6`, `3838642` (Task 11) · `3192f41`,\n`9858e99` (Task 12) · **`8a5b840` (Task 13 implementation — runbook,\nbounded-runner wrapper, serial agent config + records crawl, and all\nindependent-review fixes)** + this docs commit (ledger 13.5/13.6,\nfinal report, plans).\n\n## 7. Launch gap closure (2026-08-23, second pass)\n\nThe v2 Records Agent Launch design package was diffed against the\nlocal-complete build above; the gaps it identified were closed in six\ncommits (oldest → newest: `0f95e3b`, `5e0eb01`, `236fff3`, `e1f5ede`,\n`b4a5616`, `4a4e8f9`). What changed, and the decisions made:\n\n1. **County routing is fail-closed (M1).** County coverage is resolved\n   from an explicit registry keyed on the property's county identity —\n   never inferred from state or address, never defaulted to a covered\n   county. Unknown (null) → `unknown`; planned → `planned` (queued, no\n   county work); everything else → `not_covered`. ALL county routes\n   (resolve/confirm/refresh, county-backed search/confirm/retry, owner\n   financials, screening) gate on the resolved coverage and answer a\n   typed 422 with ZERO writes; the worker re-checks at run time\n   (`unsupported_county` / `county_changed` → blocking, non-retryable).\n   Zero-write API tests cover every non-live path. The UI shows the\n   honest state: deep-dive banner + county chip, a properties-list\n   county pill, and a dashboard coverage card (county-grouped counts\n   plus the roadmap).\n2. **Provenance is always labeled (M2).** A shared contract module\n   (`src/lib/records-provenance.ts`) decides every source label: live\n   county source, demo fixture (`.example` links are never presented as\n   official records), modeled (RentCast, roadmap), manual (owner-\n   provided). The forbidden copy \"all clear\" is banned by a regression\n   test; fixture document links read \"Demo document (.example — not an\n   official record)\".\n3. **Copilot proposals execute (M3).** A typed server dispatcher\n   (`/api/copilot/proposals/execute`) runs exactly one domain action\n   for an approved, matching proposal: county confirm/refresh, task\n   cancel/retry, owner-request draft/send — each delegating to the\n   existing CAS-protected routes under the proposal's revision. The\n   proposal carries a sha256 fingerprint stamped at proposal time;\n   tampered, stale, cross-user, duplicate, or not-allowed confirmations\n   execute nothing (typed 400/409/404). Every execute attempt lands in\n   a durable per-user execution record (upgraded post-audit — see\n   section 10). The panel's Confirm/Dismiss buttons are keyboard-\n   accessible with pending/success/failure states.\n4. **Authentication matches its labels (M4).** \"Continue with Google\"\n   now calls `signInWithPopup` with a `GoogleAuthProvider` — it had\n   silently called the email/password path (a false label); the dev\n   bypass is an explicit, separate dev-only control. The demo-\n   credentials footer is now dev-only. A real, keyboard-accessible\n   Sign out button sits in the app shell. `?next=` deep links are\n   restored on login and restricted to same-origin absolute paths\n   (protocol-relative and external URLs fall back to `/dashboard`).\n5. **Financials product gate (M5).** The rent-roll import workflow is\n   DEFERRED (product decision, recorded here and in the plan): no\n   import UI is shipped; the API is retained but dormant. The\n   Financials tab says \"On the agent roadmap — owner-provided, not\n   modeled\" and the owner-request states (not requested / drafting /\n   draft ready / sent) are the live surface. No fabricated numbers\n   anywhere.\n6. **Shell, zoom, keyboard, overview (M6).** Mobile pinch zoom restored\n   (`maximumScale` removed; the viewport metadata is now its own\n   assertable module); navigation icons are intentional lucide glyphs\n   (aria-hidden, label = accessible name, `aria-current` on the active\n   view); the Copilot panel is 380px on desktop and closes on Escape;\n   Overview shows the honest location treatment (verified address +\n   \"map preview not available yet\" — no invented coordinates).\n7. **Reproducible demo state (M7).** `npm run seed:records-demo`\n   builds the full representative Records Agent surface into the local\n   emulator under the dev-bypass user (deterministic ids, reset-then-\n   write idempotency, all strings DEMO-labeled, zero-write honored for\n   non-live counties). Six properties cover every screen category:\n   confirmed / ambiguous (confirmation-required) / search-in-progress\n   Cuyahoga fixtures, planned Summit, uncovered Portage, unknown county\n   — with matching screening runs, agent tasks, and owner requests.\n   (Corrected post-audit: the \"searching\" county status was never a\n   valid model value — the in-progress demo property is now a\n   confirmed record whose in-flight work lives in a\n   `search_incomplete` recorded-document search run and its blocked\n   task, so every seeded document is valid against its type; seeded\n   screening runs are produced by the real policy function, not a\n   parallel derivation; and a stable per-user time anchor makes\n   re-seeds byte-identical, with `--fresh-anchor` to rotate it. Exact\n   commands in the seeder header and section 10.)\n\n**Dark mode — decision:** not supported at launch, and now structurally\nimpossible to regress. The Records Agent surfaces are light-only by\ndesign; post-audit, the entire dark-mode layer was removed — the\n`next-themes` `ThemeProvider` from the app layout, the `.dark` token\nblock, `html.dark` color-scheme, stray `dark:` utility variants, and\nthe unused `glass-dark` classes — leaving a single light token set.\nA theme-contrast test pins the remaining tokens to WCAG (body text\nAAA, brand accent and muted text AA, button foreground on the brand\nsurface) and fails if any `.dark` selector, `dark:` variant, or theme\nprovider reappears.\n\n**Verification after gap closure** (supersedes the section-3 table for\nthis state): diff check clean · type-check exit 0 · lint 0 errors ·\nunit 1065 passed / 2 skipped (87 suites) · integration 112 passed /\n3 skipped (15 suites, serial) · e2e project 16/16 · Playwright route\ncrawl re-run on this state: **42/42** (3.4m, axe exception list\nempty).\n\n**Final review of the gap-closure diff** (`code_review`, high effort)\nfound three real defects, all fixed in `18bc8f8`: (a) the demo\nseeder discarded its commit promises (reset/write race, premature\nsuccess) — now awaited, reset strictly before write; (b) demo\nfeed/action items stored ISO strings where the readers require\nFirestore `Timestamp`s (seeded dashboard reads would 500) — now\nTimestamps, verified live through the real readers; (c) the chat\npersistence extractor only recognized the legacy `tool-call`/\n`tool-result` pair, but AI SDK 5 emits one unified `tool-${name}`\npart per tool execution — a real propose_action response would\npersist neither proposal nor fingerprint — the extractor now\nnormalizes the unified parts and the request schema accepts them\n(new tests cover extraction, auditing, and error states).\n\n## 8. Known nits\n\nDocumented limitations found during the independent review slices\n(kept intentional — none affects the local-complete contract):\n\n1. **Worker lease is never renewed** (invariants lens). A worker claims a\n   task with a 30s lease and never calls `renewTaskLease` (no callers\n   exist in `src/`). A live-mode run longer than 30s can therefore be\n   re-claimed and re-run by another worker; the revision CAS added to\n   `completeRecordedSearch` guarantees the stale run can never overwrite\n   the fresh one, but the duplicate work is not eliminated. A heartbeat\n   is defense-in-depth and belongs to production readiness.\n2. **One-shot migration race** (invariants lens). The\n   `migrate-watchlist-verdicts` CLI checks for an existing run and then\n   writes; a narrow window between check and apply could let a second\n   invocation double-apply. Bluntly bounded: upserts are idempotent, the\n   backup merge is additive/never-clobbering, and the script is a\n   dev-only one-shot.\n3. **Drift detector array window** (drift lens). `shapeDiff` compares\n   array elements up to the shorter (fixture) length; live elements\n   beyond that are never shape-checked. Deliberate — element-count\n   differences are data, not shape (documented in the file header).\n4. **Shared recorder source id** (privacy/provenance lens). The\n   fixture and live recorder providers share `sourceId =\n'cuyahoga-recorder'` because they stand in for the same real-world\n   source; the fixture/live distinction is carried by the parent run's\n   `mode` field. This intentionally differs from the county convention\n   (distinct fixture/live source ids).\n5. **Copilot self-reported audit** (Copilot security lens). The\n   messages-POST path redacts client-supplied `toolCalls[].input`\n   with the same `redactForAudit` redactor as the server path (fixed in\n   this pass), but a client can still assert arbitrary tool names or\n   statuses in its own session's audit rows — self-bound, audited, and\n   not executable.\n6. **Orphan thread heal** (Copilot security lens). A POST with a\n   client-chosen `threadId` heals the thread document (same transaction\n   as the message, so messages are never orphaned). A client could seed\n   junk thread documents in its own namespace; cross-user access is\n   impossible (all paths are `users/{uid}`-scoped). Turning this into a\n   404 was deliberately rejected: the normal new-thread flow completes\n   the stream before the client's explicit thread-create lands, and a\n   404 there would drop real messages.\n7. **E2E flaky-spec adjudication.** Mid-closeout, three\n   `agents-dashboard-task8.spec.ts` / `properties-watchlist.spec.ts`\n   failures rotated between runs (cancel → 404, missing lane row, stats\n   delta). Root cause: the base Playwright config's local default\n   (`fullyParallel: true`, `workers: undefined` = CPU/2) ran tests\n   _within one spec file_ concurrently, violating the Task 8 spec's\n   documented `--workers=1` requirement — a later test's seed sweep\n   deleted an earlier test's just-seeded task. Fixed structurally in\n   `playwright.agent.config.ts` (`fullyParallel: false`,\n   `workers: 1`); both specs pass standalone and after `reset`. Still\n   genuinely flaky on the local stack independent of this branch:\n   `mobile-navigation.spec.ts` and\n   `desktop-viewport-responsive-font.spec.ts`.\n8. **One re-screen per property after deploy** (review lens D). The\n   screening input signature gained the recorded search's completion\n   time (`recordedAsOf`) so a re-search with new documents under an\n   unchanged status is new work; runs persisted with the older\n   two-part signature no longer match, so the next screening event per\n   property performs one re-screen. Deliberate (new inputs are new\n   work) and self-limiting.\n\n## 9. Phase B — full E2E and UI-component audit (2026-08-28)\n\nAfter the gap-closure verification passed, a second, user-mandated pass\nwas run: every feature and every UI component exercised end-to-end on\nthe local stack, with a hard failure policy (failed page resources, JS\npage errors, horizontal overflow, WCAG A/AA via axe-core, unexplained\nconsole errors). This section records what the audit found and fixed.\n\n**What the audit consisted of**\n\n- The existing Records Agent Playwright specs (agent config, port 3100),\n  run on a fresh emulator; and a new records-config suite (port 3210):\n  `route-crawl.spec.ts` (unauthenticated crawl of every route × 6\n  viewport projects), `ui-audit-tour.spec.ts` (authenticated tour of the\n  demo-seeded experience: login, dashboard, properties list, every demo\n  property in all four deep-dive tabs, screening, agents — same hard\n  checks + full-page screenshots per page), and\n  `interaction-audit.spec.ts` (deterministic flows: `?next=` restore and\n  rejection, sign-out, copilot panel lifecycle, the county-assertion\n  write path, tab deep links).\n- The crawl's shared machinery (`crawlRoute`, the exception table, the\n  404 reconciliation) moved from the spec into `tests/records-e2e/crawl-lib.ts`\n  (Playwright forbids test files importing test files); the demo seed is\n  ensured by the records suite's global setup via the seeder's\n  `ensureDemoSeed()` (always reset-then-write, so audits stay\n  deterministic). The records run's wall-clock budget was raised from\n  15 to 50 minutes (250 tests × 6 viewport projects).\n\n**Bugs the audit found and fixed**\n\n1. **Stale pre-M1 test seeds.** Five agent specs (`county-records`,\n   `property-deep-dive`, `owner-requests`, `recorded-documents`,\n   `screening`) seeded properties without a county — before M1, county\n   was optional; after M1 the missing county is `unknown` and every\n   county route answers the typed 422 with zero writes, so the worker\n   round-trips never started and the specs timed out. Each seed now\n   asserts an explicit county (Cuyahoga for the live paths; the honest\n   not-covered case seeds Daupin County explicitly and asserts the\n   honest copy — no \"clear\", no Check button, no county record).\n2. **Dev-bypass session died on every hard navigation** (reload, deep\n   link). The bypass set React state only, with no Firebase session\n   behind it, so any full page load dropped the user to /login and the\n   auth gate bounced them back. The auth context now persists the\n   bypass with a `localStorage` marker: set by `devBypass`, restored by\n   the auth init in development (including when the Firebase service is\n   unavailable — the client Firebase config in this repo is\n   placeholder-only by design, so this path is the common one), cleared\n   on sign-out and always overruled by a real Firebase session. Unit\n   tests cover restore, sign-out, and the real-session override.\n3. **Sign-out threw when the Firebase service was absent**\n   (\"Authentication service not available\" — surfaced in the dev log as\n   \"Logout failed\") and never cleared a bypass user. `handleSignOut`\n   now clears the persisted marker and the local state, degrades\n   gracefully when no service is present, and always resolves, so the\n   shell's sign-out control works in every local state.\n4. **Test-to-test data leakage.** The county-assertion interaction test\n   mutated the seeded `demo-unknown-county` property, which the later\n   tour (same run, same seed) then read. The test now creates a\n   dedicated property via the API and deletes it in `finally` — the\n   demo seed stays pristine for every other test.\n5. **Accessibility (WCAG A/AA) — the tour's main harvest.** The\n   unauthenticated crawl never sees the authenticated surfaces, so this\n   was untested territory; the tour's axe runs caught, on every\n   authenticated page:\n   - **Contrast.** ~90 text colors failing 4.5:1 on the light card/\n     sidebar backgrounds — most broadly the muted gray `#9CA3AF`\n     (2.3:1) in ~80 places, the \"NO PHOTO\" placeholder gray on its\n     `#F3F4F6` tile (4.32:1), the search-pill label on `#F5F6F7`\n     (4.47:1), inactive agent names (2.47:1), inactive-agent green\n     (2.2:1), pending-task gray, and the brand accent `#E63946`\n     (4.06:1) in the \"Brick**spect**\" wordmark on both the sidebar and\n     the login hero. All darkened to passing members of the same\n     palette families (muted → `#6B7280`, slate → `#475569`, green →\n     `#166534`, the wordmark → the brand's primary red `#B30029`,\n     6.9:1). Ternary-branch colors the first sweep's `color:`-anchored\n     pass missed were caught by a second, line-context sweep.\n   - **Links inside text.** The deep-dive breadcrumb (Dashboard /\n     Properties), the \"Back to Properties\" link, and the agent-queue\n     empty-state \"Agent activity on the dashboard\" link were un-\n     underlined links embedded in sentences — all now underlined\n     (WCAG link-in-text-block), including the sidebar's roadmap link.\n     Verified element-by-element against the running app (computed\n     styles + contrast math) before the final re-run; the crawl's\n     exception table remains empty (no unreviewed exemptions).\n6. **Tooling.** The committed `.tmp/design-brief/` design-package\n   artifact and the gitignored `.records-local-stack/` rehearsal\n   scripts stopped polluting lint (`eslint.config.mjs` ignores); the\n   stale assistant-era `auth-priority-fix-verification.spec.ts`\n   (asserts a removed `window.__ASSISTANT_CLOUD_CONFIG__` architecture\n   and needs a manually authenticated Firebase session the local stack\n   cannot provide) is skipped with a documented reason pointing at the\n   coverage that replaced it; the redundant `provenanceLabel` helper\n   (no callers — the UI labels come from the data's source fields and\n   `documentLinkLabel`) was removed from `records-provenance.ts`; the\n   viewport re-export in `layout.tsx` is bound through a local constant.\n\n**Verification (final state, 2026-08-28)**\n\n- Records audit suite (`npm run test:playwright:records`, fresh\n  emulator, bounded runner): **270 passed / 0 failed** across all six\n  viewport projects — crawl (42), interaction flows (48), and the\n  authenticated tour (180: login, dashboard, properties list, six\n  demo properties × four tabs, screening, agents), every page under\n  the hard failure policy with **zero axe WCAG A/AA violations**\n  (the exception table stays empty). First run 23.5m; re-run 24.4m\n  on the final tree after the demo-seed doc-id fix, same result.\n- Focused Records Agent Playwright (agent config, fresh emulator):\n  county-records, property-deep-dive, owner-requests, recorded-\n  documents, screening, copilot, records-dashboard — **156 passed / 0\n  failed** (14.8m).\n- Unit: **1068 passed / 2 skipped (90 suites)**. Integration (serial,\n  fresh emulator): **112 passed / 3 skipped (15/15 suites)**. Jest\n  e2e project: **16/16**. `tsc --noEmit` 0; ESLint 0 errors (45\n  warnings, all pre-existing advisory set); `git diff --check` clean.\n- Visual pass over the full tour screenshot set (all six viewport\n  projects): every page renders its data and honest states correctly\n  (all four demo county states, the fixture provenance chips, the\n  screening verdicts, the agent lanes, the financials deferrals) with\n  no layout breakage at 320–1440px.\n- No external network, no live county/recorder source, no production\n  mail: the run used the fixture providers and the emulator only.\n\n### Deferrals (intentional, unchanged)\n\nLive Recorder automation remains gated on\n`docs/records/cuyahoga-recorder-source-contract.md` (`approved:\nfalse`); production readiness and the two non-blocking expansion\nplans remain out of local scope. Rent-roll import (M5) remains\ndeferred by product decision. The assistant-era\n`auth-priority-fix-verification.spec.ts` stays skipped (its asserted\n`window.__ASSISTANT_CLOUD_CONFIG__` architecture no longer exists;\nits coverage lives in the dev-bypass persistence tests and the\ninteraction audit's `?next=` rejection tests).\n\n## 10. Post-audit completion (2026-08-23 post-audit plan)\n\nThe post-launch audit (\"Records Agent Post-Launch Audit\", 2026-08-23)\nfound the shipped behavior to be structurally sound but with verified\ngaps in exactly the places a real first user would hit them. This\ncloseout pass (nine tasks) closed them on this branch, oldest →\nnewest: `346765c`, `ae7c143`, `3b273a6`, `7654baa`, `ae6f77a`,\n`1484465`, `1b2976e` (plus format `760710c`). What changed, and why\nit is now structurally impossible to regress:\n\n1. **Copilot proposal streaming repaired (Task 1).** The live Copilot\n   response now persists the proposed-action part through the same\n   isomorphic module (`src/lib/copilot-proposal.ts`) the UI renders —\n   the earlier extractor only recognized the legacy `tool-call`/`tool-\nresult` pair, so a real propose_action response persisted neither\n   the proposal nor its fingerprint. The fingerprint verification is\n   pluggable, and an in-flight proposal attaches to the stream instead\n   of being lost when the client reconnects.\n2. **County capability enforced in screening (Task 2).** Screening\n   resolves county coverage through the single shared\n   `resolveCountyCoverage` registry resolver and gates BEFORE any\n   write (`enqueueTask` etc. never runs for an uncovered county) —\n   the old path derived coverage from parallel logic that could\n   enqueue work a non-live county provider can never satisfy.\n3. **State-only Cuyahoga legacy removed (Task 3).** Provider selection\n   is registry-only: a property with a county identity but no verified\n   county record is reconciled idempotently to its honest state —\n   the state-string fallback that silently routed Cuyahoga-shaped\n   addresses to a live provider is gone (a contradiction between a\n   verified county and a state-only claim is a review signal, not a\n   routing hint).\n4. **Trust/provenance presentation contract completed (Task 4).**\n   `src/lib/records-provenance.ts` is now a typed contract (49 asserts\n   in its test): every source label, every `asOf` date, and every\n   confidence value renders through it; the county-records and\n   recorded-documents sections, the ConfidenceTag, the screening page\n   (per-reason sublines with `completedAt`), and the owner-financials\n   label all consume it; the \"all clear\"-class copy is banned by a\n   regression test.\n5. **Copilot action auditing made durable (Task 5).** `src/lib/\ncopilot-actions.ts` rewritten: each execute request is claimed into\n   a durable record `users/{uid}/copilotActionExecutions/{fingerprint}`\n   via atomic `doc.create()` BEFORE the action runs (claim-before-\n   execute); the same record is finalized with the outcome (executed /\n   gate-rejection / `audit_unavailable`). A 5-minute in-flight grace\n   makes a retried duplicate a no-op instead of a double-execution;\n   a claim or finalize failure answers a distinct 503\n   (`audit_unavailable`) rather than a silent success; gate rejections\n   (the action existed but a domain gate refused it) are recorded, not\n   dropped; and every payload passes a regex redactor before storage.\n   (Known-nit 5, the self-reported _chat-session_ toolCall audit rows,\n   remains as documented — the execute path is what is now durable.)\n6. **Demo seed corrected and proven idempotent (Task 6).**\n   `scripts/seed-records-demo.ts` rewritten (12-test suite): every\n   seeded document is valid against its type (no `searching` county\n   status — see the M7 correction above), all six screening runs are\n   produced by the real `evaluateScreening` policy (a unit test asserts\n   seeded-run == policy-output for every property, so the two can\n   never drift), and a stable per-user time anchor\n   (`users/{uid}/demoSeedMeta/anchor`, preserved across resets; rotate\n   with `-- --fresh-anchor`) makes consecutive seeds byte-identical —\n   asserted by a double-build test, not merely claimed.\n7. **Auth / theme / task semantics (Task 7).** Authentication is\n   Firebase via the auth context (there is no NextAuth or middleware)\n   and the login page is `/login`. This pass separates the local\n   development bypass from the two real authentication actions: the\n   \"Continue with Google\" button now executes the Google provider path\n   in _every_ environment, the email/password form executes the real\n   Firebase sign-in in both development and production, and a third,\n   visually distinct \"Continue in demo mode\" control (dashed outline,\n   local-tool gray — not a variation of the two real actions) renders\n   **only** when `NODE_ENV=development`; it is the sole path to the\n   dev bypass, and `devBypass()` is itself NODE_ENV-gated, so the\n   production build cannot reach it. The old \"Demo build — any\n   credentials work\" note is gone: every visible control now performs\n   exactly its labeled action, and the unit tests pin that contract\n   (the production render must not contain the demo control). Theme:\n   dark mode removed entirely (see the decision above, with its WCAG\n   contrast contract test). The shell search field is documented and\n   labeled Copilot-only (\"Ask the records copilot…\" opens the chat\n   panel — never presented as a general property/record search). Manual\n   retry now starts a FRESH attempt cycle: `retryTask` resets the\n   attempt budget, backoff clock, stale error, and result, and\n   re-queues the same document; an exhausted (failed/blocked at\n   `maxAttempts`) or already-succeeded task is refused — cancel is the\n   way to start over. `releaseTaskLease` (worker shutdown) was already\n   correct — it returns the task to `claimed` for immediate reclaim\n   and never invents a `failed` — and is now pinned by the retry test\n   suite's neighbors. Lane attribution and task labels: recorded-\n   document search now counts under the Records Agent lane (it is\n   county-records work, not a general search) and the Search Agent\n   lane reports an honest zero (\"no live work types\"); the queue's\n   property link shows the watchlist title (else street address) joined\n   in from `/api/agent-tasks`, with the generic `Property {id}` kept\n   only as the bounded fallback for properties carrying neither.\n8. **This section (Task 8).** Runbook/documentation correctness: the\n   stale statements in this report (M3 audit, M7 seed model, theme\n   decision) corrected, and the exact local-stack commands recorded\n   here once instead of being spread across scripts.\n\n**Exact local-stack commands** (all from the repo root;\n`scripts/seed-records-demo.ts`'s header carries the same list):\n\n```sh\nscripts/records-local-stack.sh start   # the runbook: docker-compose\n                                       # Firestore emulator (project\n                                       # demo-brickspect-dashboard, port\n                                       # 8095) → dev server on 3210 →\n                                       # agent worker\nscripts/records-local-stack.sh reset   # stop + docker compose down -v\n                                       # + state wipe + start (fresh\n                                       # demo rehearsal)\n\nnpm run seed:records-demo              # reset + seed the six-property\n                                       # demo (idempotent, byte-identical\n                                       # re-seeds)\nnpm run seed:records-demo -- --fresh-anchor   # rotate the demo time\n                                       # anchor for a fresh demo\nnpm run worker:agent                   # one-shot agent worker pass\n                                       # (claims queued tasks)\nnpm run test:playwright:records        # records-config Playwright suite\n                                       # (route crawl, interaction flows,\n                                       #  authenticated UI audit tour,\n                                       #  screenshots per viewport)\nnpm run test:playwright:agent          # focused Records Agent specs\nnpm run test:unit                      # jest unit project\n```\n\n**Verification at this state:** `tsc --noEmit` clean · ESLint 0\nerrors (pre-existing advisory set unchanged) · `prettier --check`\nclean · unit project **96 suites / 1208 tests passed** (2 skipped;\nincludes the new seed, retry-semantics, theme-contrast, and\nrecorded-documents config suites).\nThe full verification record for this pass — exact counts, the live\nseed-idempotency proof, the local 9B provider contract (with the three\nlive 9B rehearsals: `propose_action` streaming, the screening\nzero-write rejection, and the execute-twice durable audit), and the\nresidual deferrals — is in\n`docs/records-agent-post-audit-closeout-2026-08-23.md`.\n"}],"isError":false,"timestamp":1788195851088}}
