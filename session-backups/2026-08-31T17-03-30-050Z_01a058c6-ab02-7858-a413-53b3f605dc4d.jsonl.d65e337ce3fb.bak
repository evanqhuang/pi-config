{"type":"message","id":"419895ee","parentId":"a5cf2837","timestamp":"2026-08-31T17:39:45.166Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-8ab67c1491111017","toolName":"read","content":[{"type":"text","text":"'use client';\n\nimport { useState } from 'react';\nimport type { CountyIdentity } from '@/types/records-dashboard';\nimport type { CountyCoverage } from '@/lib/county-records/capabilities';\n\n/**\n * County coverage UI (M1): the honest presentation of a property's county\n * capability state.\n *\n * `CoveragePill` — the small chip used in the deep-dive header and list\n * rows (screenshot 11: \"COUNTY: LORAIN COUNTY\").\n * `CountyCoverageBanner` — the full section shown when coverage is not\n * live: the per-reason honest message plus the ONLY way a county enters\n * the system — an explicit user assertion (PATCH). It never offers a\n * \"clear\"/\"no issues\" outcome, and it never infers coverage from state.\n */\n\nconst PILL_BASE: React.CSSProperties = {\n  display: 'inline-block',\n  padding: '3px 9px',\n  borderRadius: 999,\n  fontSize: 10.5,\n  fontWeight: 700,\n  letterSpacing: '.06em',\n  textTransform: 'uppercase',\n  border: '1px solid #E5E7EB',\n  background: '#fff',\n  color: '#6B7280',\n};\n\nexport function CoveragePill({\n  county,\n  coverage,\n}: {\n  county: CountyIdentity | null;\n  coverage: CountyCoverage;\n}) {\n  if (county) {\n    // Known county: the chip shows the name in every coverage state —\n    // the coverage state itself is the banner/pill modifier below.\n    if (coverage.status === 'live') {\n      return (\n        <span style={PILL_BASE} data-testid=\"coverage-pill-live\">\n          County: {county.name}\n        </span>\n      );\n    }\n    return (\n      <span\n        style={{\n          ...PILL_BASE,\n          border: '1px dashed #D1D5DB',\n          color: \"#6b7280\",\n        }}\n        data-testid=\"coverage-pill-not-covered\"\n      >\n        Not covered — {county.name}\n      </span>\n    );\n  }\n  return (\n    <span\n      style={{ ...PILL_BASE, border: '1px dashed #D1D5DB', color: \"#6b7280\" }}\n      data-testid=\"coverage-pill-unknown\"\n    >\n      County unverified\n    </span>\n  );\n}\n\n/**\n * The full not-covered / planned / unknown section. Renders the honest\n * per-reason message (the design's \"no ambiguous 'clear', ever\") and —\n * when no county is set yet — the explicit-assertion form.\n */\nexport function CountyCoverageBanner({\n  property,\n  coverage,\n  onCountySet,\n}: {\n  property: { id: string; state: string | null };\n  coverage: CountyCoverage;\n  /** Called after a successful county assertion (the parent re-fetches). */\n  onCountySet?: () => void | Promise<void>;\n}) {\n  const [value, setValue] = useState('');\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  async function handleSetCounty(e: React.FormEvent) {\n    e.preventDefault();\n    const name = value.trim();\n    if (!name || busy) return;\n    setBusy(true);\n    setError(null);\n    try {\n      const res = await fetch(\n        `/api/properties/${encodeURIComponent(property.id)}`,\n        {\n          method: 'PATCH',\n          headers: { 'content-type': 'application/json' },\n          body: JSON.stringify({ county: { name } }),\n          cache: 'no-store',\n        }\n      );\n      if (!res.ok) {\n        const body = (await res.json().catch(() => null)) as {\n          error?: string;\n        } | null;\n        throw new Error(body?.error ?? `Failed (${res.status})`);\n      }\n      await onCountySet?.();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : 'Failed to set county');\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const stateSuffix = property.state ? `, ${property.state}` : '';\n\n  let title: string;\n  let body: React.ReactNode;\n  switch (coverage.status) {\n    case 'not_covered':\n      title = `We don't cover ${coverage.county.name}${stateSuffix} yet`;\n      body = (\n        <>\n          No county or recorder source is connected for this county, so there is\n          no county data and no way to mark it clear — no ambiguous\n          &ldquo;clear&rdquo;, ever.{' '}\n          {coverage.county.code === 'lorain-oh' ? (\n            <>Lorain County is not on the current coverage roadmap.</>\n          ) : (\n            <>\n              We add counties in order of demand — keep this property tracked\n              and it stays in the running.\n            </>\n          )}\n        </>\n      );\n      break;\n    case 'planned':\n      title = `Records coverage for ${coverage.county.name}${stateSuffix} is planned${\n        coverage.eta ? ` for ${coverage.eta}` : ''\n      }`;\n      body = (\n        <>\n          The county source is on the roadmap but not live, so nothing has been\n          checked — and we will not show a result we haven&apos;t verified.\n          Screening for this property stays blocked until the coverage goes\n          live.\n        </>\n      );\n      break;\n    default:\n      // unknown\n      title = 'This property has no verified county yet';\n      body = (\n        <>\n          Coverage can only be determined from a confirmed county — we never\n          infer it from the state. Set the county below and we &apos;ll check\n          what we cover.\n        </>\n      );\n  }\n\n  const showForm =\n    coverage.status === 'unknown' ||\n    (coverage.status === 'not_covered' && coverage.county.code !== 'lorain-oh');\n\n  return (\n    <section\n      aria-label=\"County coverage\"\n      data-testid=\"county-coverage-banner\"\n      style={{\n        background: '#fff',\n        border: '1px solid #E5E7EB',\n        borderRadius: 14,\n        padding: '14px 16px',\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 10,\n      }}\n    >\n      <div\n        style={{\n          display: 'flex',\n          alignItems: 'center',\n          gap: 10,\n          flexWrap: 'wrap',\n        }}\n      >\n        <span\n          style={{\n            ...PILL_BASE,\n            border: '1px dashed #D1D5DB',\n            color: \"#6b7280\",\n          }}\n        >\n          {coverage.status === 'planned' ? 'Agent-pending' : 'Not covered'}\n        </span>\n        <h2\n          style={{\n            margin: 0,\n            fontSize: 14.5,\n            fontWeight: 600,\n            color: '#111827',\n          }}\n        >\n          {title}\n        </h2>\n      </div>\n      <p\n        style={{\n          margin: 0,\n          fontSize: 13,\n          lineHeight: 1.55,\n          color: '#6B7280',\n          maxWidth: 640,\n        }}\n      >\n        {body}\n      </p>\n      {showForm && (\n        <form\n          onSubmit={handleSetCounty}\n          style={{\n            display: 'flex',\n            gap: 8,\n            alignItems: 'center',\n            flexWrap: 'wrap',\n          }}\n        >\n          <label\n            htmlFor={`set-county-${property.id}`}\n            style={{ fontSize: 12.5, color: '#6B7280' }}\n          >\n            County\n          </label>\n          <input\n            id={`set-county-${property.id}`}\n            data-testid=\"set-county-input\"\n            value={value}\n            onChange={(e) => setValue(e.target.value)}\n            placeholder='e.g. \"Cuyahoga County\"'\n            style={{\n              border: '1px solid #CBD5E1',\n              borderRadius: 8,\n              padding: '7px 10px',\n              fontSize: 13,\n              width: 220,\n            }}\n            aria-label=\"Set the property's county\"\n          />\n          <button\n            type=\"submit\"\n            disabled={busy || !value.trim()}\n            data-testid=\"set-county-submit\"\n            style={{\n              border: '1px solid #E5E7EB',\n              background: busy ? '#F3F4F6' : '#fff',\n              borderRadius: 8,\n              padding: '7px 12px',\n              fontSize: 12.5,\n              fontWeight: 600,\n              color: '#111827',\n              cursor: busy ? 'wait' : 'pointer',\n            }}\n          >\n            {busy ? 'Saving…' : 'Set county'}\n          </button>\n          {error && (\n            <span role=\"alert\" style={{ fontSize: 12, color: '#B42318' }}>\n              {error}\n            </span>\n          )}\n        </form>\n      )}\n    </section>\n  );\n}\n"}],"isError":false,"timestamp":1788197985166}}
{"type":"message","id":"0df6d3e8","parentId":"419895ee","timestamp":"2026-08-31T17:40:22.466Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Next, update this file to support the `review` status:\n\n1. `CoveragePill`: Add a review variant — \"County needs review — {name}\" with a warning color tone (amber). The pill currently only distinguishes between live and not-covered. Add a review branch before the generic not-covered branch:\n```tsx\nif (coverage.status === 'review') {\n  return (\n    <span style={{...PILL_BASE, border: '1px solid #F59E0B', color: '#92400E', background: '#FFFBEB'}} data-testid=\"coverage-pill-review\">\n      County review — {county.name}\n    </span>\n  );\n}\n```\n\n2. `CountyCoverageBanner`: switch on coverage.status — add a 'review' case:\n```tsx\ncase 'review':\n  title = `This property's county needs review`;\n  body = (\n    <>\n      {coverage.contradiction.explicit.name} is set, but a confirmed parcel proves it is in {coverage.contradiction.provenance.name}. Until a human resolves which county is correct, county work for this property is paused.\n    </>\n  );\n  break;\n```\nAnd for the chip label: `{coverage.status === 'planned' ? 'Agent-pending' : coverage.status === 'review' ? 'Needs review' : 'Not covered'}`.\n\nshowForm for review: should the form be shown? A user trying to re-set the county to the provenance county would resolve it — yes, let's show the form for review too (that's the resolution mechanism: the human asserts the correct county). showForm = unknown || (not_covered && not lorain) || review.\n\nNote that the deep-dive page (property/[id]/page.tsx) displays the banner when coverage.status !== 'live' — review is handled by the switch. Let me check how the deep-dive page uses the banner (line 619 pill; banner condition). The deep-dive already fetches coverage from /api/properties/[id], which now returns review — so it should be handled automatically via the switch.\n\nAlright, let me apply the edits to the banner file.\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-829f65ec636b6d28","name":"edit","arguments":{"edits":[{"newText":"  if (county) {\n    // Known county: the chip shows the name in every coverage state —\n    // the coverage state itself is the banner/pill modifier below.\n    if (coverage.status === 'live') {\n      return (\n        <span style={PILL_BASE} data-testid=\"coverage-pill-live\">\n          County: {county.name}\n        </span>\n      );\n    }\n    if (coverage.status === 'review') {\n      // Fail-closed review: the explicit county and a confirmed parcel\n      // disagree — visibly distinct from a plain not-covered state.\n      return (\n        <span\n          style={{\n            ...PILL_BASE,\n            border: '1px solid #F59E0B',\n            color: '#92400E',\n            background: '#FFFBEB',\n          }}\n          data-testid=\"coverage-pill-review\"\n        >\n          County review — {county.name}\n        </span>\n      );\n    }\n    return (","oldText":"  if (county) {\n    // Known county: the chip shows the name in every coverage state —\n    // the coverage state itself is the banner/pill modifier below.\n    if (coverage.status === 'live') {\n      return (\n        <span style={PILL_BASE} data-testid=\"coverage-pill-live\">\n          County: {county.name}\n        </span>\n      );\n    }\n    return ("},{"newText":"  let title: string;\n  let body: React.ReactNode;\n  switch (coverage.status) {\n    case 'review':\n      // Fail-closed: an explicit county and the county a confirmed parcel\n      // proves disagree. Naming both, pausing county work, and offering the\n      // explicit-assertion form — the only way a human resolves it.\n      title = 'This property\\u2019s county needs review';\n      body = (\n        <>\n          The county is set to {coverage.contradiction.explicit.name}, but a\n          confirmed parcel proves this property is in{' '}\n          {coverage.contradiction.provenance.name}. County work is paused\n          until a human confirms which county is correct — set the county\n          below to resolve it.\n        </>\n      );\n      break;\n    case 'not_covered':","oldText":"  let title: string;\n  let body: React.ReactNode;\n  switch (coverage.status) {\n    case 'not_covered':"},{"newText":"  const showForm =\n    coverage.status === 'unknown' ||\n    coverage.status === 'review' ||\n    (coverage.status === 'not_covered' && coverage.county.code !== 'lorain-oh');","oldText":"  const showForm =\n    coverage.status === 'unknown' ||\n    (coverage.status === 'not_covered' && coverage.county.code !== 'lorain-oh');"},{"newText":"          {coverage.status === 'planned'\n            ? 'Agent-pending'\n            : coverage.status === 'review'\n            ? 'Needs review'\n            : 'Not covered'}","oldText":"          {coverage.status === 'planned' ? 'Agent-pending' : 'Not covered'}"}],"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/components/records-dashboard/county-coverage-banner.tsx"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":87654,"output":1291,"cacheRead":0,"cacheWrite":0,"reasoning":475,"totalTokens":88945,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788197985170,"responseId":"chatcmpl-80ce410f15e67ebe","rawStopReason":"tool_calls"}}
