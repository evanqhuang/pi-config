{"type":"message","id":"90362e9e","parentId":"1f2b1129","timestamp":"2026-08-31T17:45:01.569Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-b048edb45317474c","toolName":"bash","content":[{"type":"text","text":"123:export interface RecordedSearch {\n124-  searchId: string;\n125-  propertyId: string;\n126-  /** The county record revision the search was scoped to (0 = none yet). */\n127-  countyRecordRevision: number;\n128-  status: RecordedSearchStatus;\n129-  /**\n130-   * Which mode produced it (fixture | live). A PREDICTION of the active\n131-   * environment while `queued`; the provider's own mode from `running`\n132-   * onward (persisted at start, and authoritatively at completion).\n133-   */\n134-  mode: 'fixture' | 'live';\n135-  /**\n136-   * Version of the index config the completion rule was computed from —\n137-   * written at completion (the version that actually produced the status),\n138-   * seeded at enqueue.\n139-   */\n140-  configVersion: number;\n141-  startedAt: string | null;\n142-  completedAt: string | null;\n143-  /** Per-index results — the coverage ledger. */\n--\n154:export interface RecordedSearchNotFound {\n155-  status: 'not_started';\n156-  searchId: null;\n157-  propertyId: string;\n158-  manualNextSteps: string[];\n159-}\n160-\n161-/** What the list/search routes return. */\n162:export type RecordedSearchResponse = RecordedSearch | RecordedSearchNotFound;\n163-\n164-/** The query a provider is asked to answer. */\n165-export interface RecordedSearchQuery {\n166-  parcelId: string | null;\n167-  parcelIdFormatted: string | null;\n168-  address: string;\n169-  /** Fixture-mode scenario selector (dev/tests only; the live path ignores it). */\n170-  scenario?: string;\n171-  /** Bounded per-index document cap (never unbounded). */\n172-  limit: number;\n173-}\n174-\n175-/** What a provider returns for one index. */\n176-export interface ProviderIndexOutcome {\n177-  id: string;\n178-  label: string;\n179-  required: boolea