 propertyId: 'prop-001',\n      run: { runId: 'sr:prop-001:1:aa', verdict: 'PURSUE' },\n    });\n    // `coverage` is additive too: a county-less property with no county\n    // record resolves to the honest `unknown` note (never a covered county).\n    expect(body.coverage['prop-001']).toEqual({\n      status: 'unknown',\n      county: null,\n      message: expect.stringContaining('no county identified'),\n    });\n  });\n\n\n[203 more lines in file. Use offset=104 to continue.]"}],"isError":false,"timestamp":1788203134484}}
