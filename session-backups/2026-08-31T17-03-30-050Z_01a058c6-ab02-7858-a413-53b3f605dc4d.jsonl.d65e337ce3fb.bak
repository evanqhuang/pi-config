s feature trees directly.)\n+ */\n+export async function requireRecordedProperty(\n+  request: NextRequest,\n+  params: Promise<{ id: string }>\n+): Promise<WatchedPropertyAuth | NextResponse> {\n+  const auth = await requireWatchedProperty(request, params);\n+  return auth;\n+}\n+\n+/**\n  * The canonical coverage guard for recorded-document READS (the collection\n  * list and the search poll). It resolves coverage from EXACTLY the same\n  * inputs the search enqueue gate uses — the explicit county plus the\n  * confirmed-snapshot provenance — so a read can never disagree with what\n@@ -62,7 +77,29 @@\n ): Promise<{\n   authoritative: boolean;\n   coverage: ReturnType<typeof coverageNote>;\n }> {\n-  const property = await requireWatchedProperty.__placeholder__;\n-  throw new Error('unused');\n+  const [property, record] = await Promise.all([\n+    getWatchlistItem(user.id, propertyId),\n+    getCountyRecord(user.id, propertyId),\n+  ]);\n+  if (!property) {\n+    // The route auth already 404'd for an unwatched property; this branch\n+    // is defensive only and fails closed.\n+    return {\n+      authoritative: false,\n+      coverage: {\n+        status: 'unknown',\n+        county: null,\n+        message: 'This property has no county identified yet.',\n+      },\n+    };\n+  }\n+  const coverage = resolveCountyCoverage(\n+    property.county ?? null,\n+    record?.snapshot?.provenance?.sourceId ?? null\n+  );\n+  return {\n+    authoritative: coverage.status === 'live',\n+    coverage: coverageNote(coverage),\n+  };\n }\n","firstChangedLine":13},"isError":false,"timestamp":1788198403871}}
{"type":"message","id":"b61d8a19","parentId":"89e66d76","timestamp":"2026-08-31T17:47:08.114Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"The advisory (ast-grep:redundant-state) is informational only, no action needed. Continuing work: wire the guard into the two GET routes.\n\n1. recorded-documents/route.ts GET (root):\n- After loading the latest search or not_started, compute the guard and spread it into the response.\n\nCurrent root GET:\n```ts\n    if (!search) {\n      return NextResponse.json(notStartedPayload(property), { headers: NO_STORE });\n    }\n    return NextResponse.json(search, { headers: NO_STORE });\n```\nNew:\n```ts\n    const guard = await recordedReadGuard(user, property.id);\n    if (!search) {\n      return NextResponse.json({ ...notStartedPayload(property), ...guard }, { headers: NO_STORE });\n    }\n    return NextResponse.json({ ...search, ...guard }, { headers: NO_STORE });\n```\nWait — the order: guard fields after the spread → in case of a name collision, the guard's fields win; there's no collision (search has no `coverage`/`authoritative` fields).\n\nHmm, one consideration: the root GET is also what the UI uses on initial load; adding the guard there means the UI's notification will also be shown on the collection view.\n\n2. searches/[searchId]/route.ts GET:\n- Current:\n```ts\n    if (!search) return NextResponse.json(notStartedPayload(property), { headers: NO_STORE });\n    return NextResponse.json(search, { headers: NO_STORE });\n```\n- New: same pattern with the guard.\n\nAlso, regarding `RecordedSearchGuardedResponse` — the return type of the GET function is inferred by NextResponse.json; no explicit annotation needed.\n\nLet me apply both edits.\n","thinkingSignature":"reasoning"},{"type":"text","text":"\n\nAdvisory noted, no action. Wiring the guard into both read routes:\n\n"},{"type":"toolCall","id":"chatcmpl-tool-9819bc781283d1ad","name":"edit","arguments":{"edits":[{"newText":"import { NO_STORE, notStartedPayload, recordedReadGuard } from './shared';","oldText":"import { NO_STORE, notStartedPayload } from './shared';"},{"newText":"    // Read the LATEST search for the property (there is no stored\n    // collection document; the UI presents the most recent run).\n    const search = await getLatestRecordedSearch(user.id, property.id);\n    // The canonical coverage guard: identical inputs to the search gate.\n    // A stale county-specific result stays retrievable but is never\n    // presented as current authoritative data (additive fields; the\n    // stored document itself is untouched).\n    const guard = await recordedReadGuard(user, property.id);\n    if (!search) {\n      return NextResponse.json(\n        { ...notStartedPayload(property), ...guard },\n        { headers: NO_STORE }\n      );\n    }\n    return NextResponse.json({ ...search, ...guard }, { headers: NO_STORE });","oldText":"    // Read the LATEST search for the property (there is no stored\n    // collection document; the UI presents the most recent run).\n    const search = await getLatestRecordedSearch(user.id, property.id);\n    if (!search) {\n      return NextResponse.json(notStartedPayload(property), { headers: NO_STORE });\n    }\n    return NextResponse.json(search, { headers: NO_STORE });"}],"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/app/api/properties/[id]/recorded-documents/route.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":106921,"output":782,"cacheRead":0,"cacheWrite":0,"reasoning":377,"totalTokens":107703,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788198404392,"responseId":"chatcmpl-b81b71839754f727","rawStopReason":"tool_calls"}}
