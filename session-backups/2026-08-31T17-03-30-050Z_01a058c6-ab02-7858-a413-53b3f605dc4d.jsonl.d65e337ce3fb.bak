{"type":"message","id":"d6a89309","parentId":"a1cb0926","timestamp":"2026-08-31T19:00:37.593Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-bc34ea98bc876fb1","toolName":"read","content":[{"type":"text","text":"  beforeEach(() => {\n    jest.clearAllMocks();\n    (getUserFromRequest as jest.Mock).mockResolvedValue({ id: 'u1' });\n    (getWatchlistItem as jest.Mock).mockResolvedValue(WATCH_ITEM);\n    (checkRateLimit as jest.Mock).mockReturnValue({\n      allowed: true,\n      limit: 10,\n      remaining: 9,\n      resetTime: new Date(0),\n    });\n    (getCountyRecord as jest.Mock).mockResolvedValue(storedRecord());\n    (enqueueCountyTaskIfCurrent as jest.Mock).mockResolvedValue(queued());\n  });\n\n  it('enqueues county refresh and returns the durable task reference', async () => {\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(202);\n    expect(await response.json()).toEqual({\n      taskId: 'task-refresh-1',\n      taskRevision: 5,\n      stateRevision: 2,\n      created: false,\n    });\n    expect(enqueueCountyTaskIfCurrent).toHaveBeenCalledWith(\n      'u1',\n      'prop-001',\n      'county_refresh',\n      {\n        expectedRevision: 2,\n        county: { code: 'cuyahoga-oh', name: 'Cuyahoga County' },\n      },\n      2\n    );\n    expectNoStore(response);\n  });\n\n  it('returns the canonical conflict when enqueue observes a stale record', async () => {\n    const current = storedRecord({ revision: 3 });\n    (enqueueCountyTaskIfCurrent as jest.Mock).mockResolvedValue({\n      stale: current,\n      task: null,\n      created: false,\n      recordRevision: 3,\n    });\n\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(409);\n    expect(await response.json()).toEqual({\n      error: 'county_record_changed',\n      message: 'County record changed; reload and try again.',\n      state: { state: 'loaded', revision: 3, snapshot: SNAPSHOT },\n    });\n    expectNoStore(response);\n  });\n\n  it('returns 404 when no county record exists', async () => {\n    (getCountyRecord as jest.Mock).mockResolvedValue(null);\n\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(404);\n    expect(await response.json()).toEqual({\n      error: 'No county record for this property',\n    });\n    expect(enqueueCountyTaskIfCurrent).not.toHaveBeenCalled();\n  });\n\n  it('returns the canonical conflict when the observed revision is stale', async () => {\n    const current = storedRecord({ revision: 3 });\n    (getCountyRecord as jest.Mock).mockResolvedValue(current);\n\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(409);\n    expect(await response.json()).toEqual({\n      error: 'county_record_changed',\n      message: 'County record changed; reload and try again.',\n      state: { state: 'loaded', revision: 3, snapshot: SNAPSHOT },\n    });\n    expect(enqueueCountyTaskIfCurrent).not.toHaveBeenCalled();\n  });\n\n  it('returns 409 when the record is not confirmed', async () => {\n    (getCountyRecord as jest.Mock).mockResolvedValue(\n      storedRecord({\n        status: 'confirmation_required',\n        snapshot: null,\n        candidates: [],\n      })\n\n[12 more lines in file. Use offset=200 to continue.]"}],"isError":false,"timestamp":1788202837593}}
