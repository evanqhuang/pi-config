{"type":"message","id":"0d5ce30b","parentId":"164e47a3","timestamp":"2026-08-31T17:50:32.118Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-b1eb523a72a7060a","toolName":"bash","content":[{"type":"text","text":"        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ expectedRevision: countyRevision ?? 0 }),\n      });\n      const payload: unknown = await response.json();\n      if (\n        response.status === 202 &&\n        typeof payload === 'object' &&\n        payload !== null &&\n        'searchId' in payload &&\n        typeof payload.searchId === 'string'\n      ) {\n        queued = true;\n        setNotice('Record search queued — running in the background…');\n        startPolling(payload.searchId);\n        return;\n      }\n      if (\n        response.status === 409 &&\n        typeof payload === 'object' &&\n        payload !== null &&\n        'error' in payload &&\n        payload.error === 'county_record_changed'\n      ) {\n        setConflicted(true);\n        setNotice(\n          'County records changed since you last looked. Reload the property, then search again.'\n        );\n        return;\n      }\n      setError(\n        errorMessage(\n          payload,\n          'The recorded-document search could not be started.'\n        )\n      );\n    } catch {\n      setError('The recorded-document search could not be started.');\n    } finally {\n      postInFlightRef.current = false;\n      if (!queued) setBusy(false);\n    }\n  }, [busy, conflicted, countyRevision, endpoint, startPolling]);\n\n  const recordedSearch = search?.status === 'not_started' ? null : search;\n  const showManualFallback = !loading && search?.status !== 'complete';\n  const canRetry =\n    search?.status === 'complete' ||\n    search?.status === 'search_incomplete' ||\n    search?.status === 'failed';\n\n  return (\n    <div style={{ minWidth: 0, ...WRAP }}>\n      <section\n        aria-labelledby=\"recorded-search-heading\"\n        style={{\n          borderTop: '1px solid #E5E7EB',\n          background: '#FAFAFA',\n          ...WRAP,\n        }}\n      >\n        <div style={{ padding: '18px 16px', ...WRAP }}>\n          {/* h2, not h3: on the deep-dive due-diligence tab of a\n              searching property there is no intermediate h2, so h3\n              would skip a level (axe heading-order). */}\n          <h2\n            id=\"recorded-search-heading\"\n            style={{\n              margin: '0 0 8px',\n              fontSize: 15,\n              color: '#111827',\n              ...WRAP,\n            }}\n          >\n            Recorded documents\n          </h2>\n\n          {loading && !search && (\n            <p\n              role=\"status\"\n              style={{ margin: 0, color: '#6B7280', fontSize: 13, ...WRAP }}\n            >\n              Loading recorded documents…\n            </p>\n          )}\n\n          {notice && (\n            <p\n              role=\"status\"\n              style={{\n                margin: '0 0 12px',\n                color: '#4B5563',\n"}],"isError":false,"timestamp":1788198632118}}
