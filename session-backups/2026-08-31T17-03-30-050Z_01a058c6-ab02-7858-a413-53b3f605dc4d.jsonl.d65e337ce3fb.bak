{"type":"message","id":"e10bb33e","parentId":"60e7d20e","timestamp":"2026-08-31T17:27:01.084Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-afc499403af70ed8","toolName":"read","content":[{"type":"text","text":"describe('resolveCountyCoverage — county contradictions (review signal)', () => {\n  it('explicit Summit + a confirmed Cuyahoga parcel → planned with a recorded contradiction; Cuyahoga never routes', () => {\n    const r = resolveCountyCoverage(\n      { code: 'summit-oh', name: 'Summit County' },\n      'cuyahoga-arcgis'\n    );\n    // The explicit county wins (planned, blocked) — the provenance county\n    // never overrides it — and the mismatch is recorded for review.\n    expect(r.status).toBe('planned');\n    if (r.status !== 'planned') throw new Error('unreachable');\n    expect(r.county.code).toBe('summit-oh');\n    expect(r.contradiction).toEqual({\n      explicit: { code: 'summit-oh', name: 'Summit County' },\n      provenance: { code: 'cuyahoga-oh', name: 'Cuyahoga County' },\n    });\n  });\n\n  it('explicit Cuyahoga + a confirmed Cuyahoga parcel → live, no contradiction', () => {\n    const r = resolveCountyCoverage(CUYAHOGA, 'cuyahoga-fixture');\n    expect(r.status).toBe('live');\n    expect(r.contradiction ?? null).toBeNull();\n  });\n\n  it('no explicit county + a confirmed Cuyahoga parcel → live backfill, no contradiction', () => {\n    const r = resolveCountyCoverage(null, 'cuyahoga-arcgis');\n    expect(r.status).toBe('live');\n    expect(r.contradiction ?? null).toBeNull();\n  });\n\n  it('a bare county slug and the registry slug are the same county (no false contradiction)', () => {\n    const r = resolveCountyCoverage(\n      { code: 'cuyahoga', name: 'Cuyahoga County' },\n      'cuyahoga-arcgis'\n    );\n    expect(r.status).toBe('live');\n    expect(r.contradiction ?? null).toBeNull();\n  });\n\n  it('an explicit not-covered county + a confirmed Cuyahoga parcel → not_covered with a contradiction', () => {\n    const r = resolveCountyCoverage(\n      { code: 'lorain-oh', name: 'Lorain County' },\n      'cuyahoga-arcgis'\n    );\n    expect(r.status).toBe('not_covered');\n    expect(r.contradiction).toEqual({\n      explicit: { code: 'lorain-oh', name: 'Lorain County' },\n      provenance: { code: 'cuyahoga-oh', name: 'Cuyahoga County' },\n    });\n  });\n});\n\ndescribe('countyForSourceId', () => {\n  it('maps both Cuyahoga source ids to Cuyahoga', () => {\n    expect(countyForSourceId('cuyahoga-arcgis')).toEqual(CUYAHOGA);\n    expect(countyForSourceId('cuyahoga-fixture')).toEqual(CUYAHOGA);\n  });\n\n  it('returns null for unknown sources', () => {\n    expect(countyForSourceId(null)).toBeNull();\n    expect(countyForSourceId('cuyahoga-recorder' as never)).toBeNull();\n\n[100 more lines in file. Use offset=241 to continue.]"}],"isError":false,"timestamp":1788197221084}}
