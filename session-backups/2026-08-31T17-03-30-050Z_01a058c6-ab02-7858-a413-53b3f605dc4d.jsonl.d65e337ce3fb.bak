{"type":"message","id":"48197155","parentId":"5ee0780c","timestamp":"2026-08-31T17:48:41.316Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-92046eb528b71a17","toolName":"bash","content":[{"type":"text","text":"  propertyId,\n  parcelId,\n  parcelIdFormatted,\n  countyRevision,\n}: RecordedDocumentsSectionProps) {\n  const [search, setSearch] = useState<RecordedSearchResponse | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [busy, setBusy] = useState(false);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [conflicted, setConflicted] = useState(false);\n  const pollTimerRef = useRef<ReturnType<typeof setInterval> | null>(null);\n  const activeSearchIdRef = useRef<string | null>(null);\n  const pollInFlightRef = useRef(false);\n  const postInFlightRef = useRef(false);\n\n  const endpoint = `/api/properties/${encodeURIComponent(propertyId)}/recorded-documents`;\n\n  const stopPolling = useCallback(() => {\n    if (pollTimerRef.current) {\n      clearInterval(pollTimerRef.current);\n      pollTimerRef.current = null;\n    }\n    activeSearchIdRef.current = null;\n    pollInFlightRef.current = false;\n  }, []);\n\n  useEffect(() => stopPolling, [stopPolling]);\n\n  const loadState = useCallback(async () => {\n    try {\n      const response = await fetch(endpoint, { cache: 'no-store' });\n      const payload: unknown = await response.json();\n      if (!response.ok) {\n        setError(\n          errorMessage(payload, 'Recorded documents could not be loaded.')\n        );\n        return;\n      }\n      if (isSearchResponse(payload)) {\n        setSearch(payload);\n        setError(null);\n      } else {\n        setError('Recorded documents could not be loaded.');\n      }\n    } catch {\n      setError('Recorded documents could not be loaded.');\n    } finally {\n      setLoading(false);\n    }\n  }, [endpoint]);\n\n  useEffect(() => {\n    void loadState();\n  }, [loadState]);\n\n  const startPolling = useCallback(\n    (searchId: string) => {\n      if (activeSearchIdRef.current === searchId && pollTimerRef.current)\n        return;\n      stopPolling();\n      activeSearchIdRef.current = searchId;\n      setBusy(true);\n\n      const poll = async () => {\n        if (pollInFlightRef.current) return;\n        pollInFlightRef.current = true;\n        try {\n          const response = await fetch(\n            `${endpoint}/searches/${encodeURIComponent(searchId)}`,\n            { cache: 'no-store' }\n          );\n          if (response.status !== 200) return;\n          const payload: unknown = await response.json();\n          if (!isSearchResponse(payload) || payload.status === 'not_started')\n            return;\n          setSearch(payload);\n          if (TERMINAL_STATUSES.has(payload.status)) {\n            stopPolling();\n            setNotice(null);\n            await loadState();\n            setBusy(false);\n          }\n        } catch {\n          // A transient poll failure is retried by the interval.\n        } finally {\n          pollInFlightRef.current = false;\n        }\n      };\n\n      void poll();\n      pollTimerRef.current = setInterval(() => void poll(), 2_500);\n    },\n    [endpoint, loadState, stopPolling]\n  );\n\n  useEffect(() => {\n    if (isActiveSearch(search)) startPolling(search.searchId);\n  }, [search, startPolling]);\n\n  const requestSearch = useCallback(async () => {\n    if (postInFlightRef.current || busy || conflicted) return;\n    postInFlightRef.current = true;\n    setBusy(true);\n    setError(null);\n    setNotice(null);\n    let queued = false;\n    try {\n      const response = await fetch(`${endpoint}/search`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n"}],"isError":false,"timestamp":1788198521316}}
