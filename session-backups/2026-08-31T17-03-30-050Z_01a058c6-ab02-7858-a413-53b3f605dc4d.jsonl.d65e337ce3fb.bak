{"type":"message","id":"7a8e5c2e","parentId":"f565e3a6","timestamp":"2026-08-31T17:15:19.856Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-a8b04365a1a72386","toolName":"read","content":[{"type":"text","text":"'use client';\n\nimport { useCallback, useEffect, useRef, useState } from 'react';\nimport { RecordedDocumentsManualReview } from '@/components/records-dashboard/recorded-documents-manual-review';\nimport {\n  documentLinkLabel,\n  emptyResultsMessage,\n  presentRecordedDocument,\n  presentSearchScope,\n} from '@/lib/records-provenance';\nimport type {\n  RecordedDocument,\n  RecordedIndexResult,\n  RecordedIndexStatus,\n  RecordedSearch,\n  RecordedSearchResponse,\n} from '@/types/recorded-documents';\n\nexport interface RecordedDocumentsSectionProps {\n  propertyId: string;\n  parcelId: string | null;\n  parcelIdFormatted: string | null;\n  countyRevision: number | null;\n}\n\nconst WRAP = { overflowWrap: 'anywhere' } as const;\nconst TERMINAL_STATUSES = new Set(['complete', 'search_incomplete', 'failed']);\nconst SEARCH_STATUSES = new Set([\n  'not_started',\n  'queued',\n  'running',\n  'complete',\n  'search_incomplete',\n  'failed',\n]);\n\nfunction isSearchResponse(value: unknown): value is RecordedSearchResponse {\n  return (\n    typeof value === 'object' &&\n    value !== null &&\n    'status' in value &&\n    typeof value.status === 'string' &&\n    SEARCH_STATUSES.has(value.status)\n  );\n}\n\nfunction errorMessage(payload: unknown, fallback: string): string {\n  if (\n    typeof payload === 'object' &&\n    payload !== null &&\n    'error' in payload &&\n    typeof payload.error === 'string'\n  ) {\n    return payload.error;\n  }\n  return fallback;\n}\n\nfunction statusStyle(status: RecordedIndexStatus) {\n  switch (status) {\n    case 'complete':\n      return { background: '#DCFCE7', color: '#166534' } as const;\n    case 'blocked':\n    case 'failed':\n      return { background: '#FEE2E2', color: '#991B1B' } as const;\n    case 'pending':\n      return { background: '#FEF3C7', color: '#92400E' } as const;\n    case 'not_applicable':\n      return { background: '#F3F4F6', color: '#4B5563' } as const;\n  }\n}\n\nfunction label(value: string): string {\n  return value.split('_').join(' ');\n}\n\nfunction elapsed(startedAt: string | null): string {\n  if (!startedAt) return 'elapsed time unavailable';\n  const started = Date.parse(startedAt);\n  if (Number.isNaN(started)) return 'elapsed time unavailable';\n  const seconds = Math.max(0, Math.floor((Date.now() - started) / 1_000));\n  if (seconds < 60) return `${seconds}s elapsed`;\n  const minutes = Math.floor(seconds / 60);\n  return `${minutes}m ${seconds % 60}s elapsed`;\n}\n\nfunction ActionButton({\n  label: buttonLabel,\n  busy,\n  disabled,\n  onClick,\n}: {\n  label: string;\n  busy: boolean;\n  disabled: boolean;\n  onClick: () => void;\n}) {\n  const isDisabled = busy || disabled;\n  return (\n    <button\n      type=\"button\"\n      disabled={isDisabled}\n      onClick={onClick}\n      style={{\n        border: 0,\n        borderRadius: 8,\n        background: isDisabled ? '#9CA3AF' : '#8F1736',\n        color: '#fff',\n        padding: '8px 12px',\n        fontSize: 13,\n        fontWeight: 700,\n        cursor: isDisabled ? (busy ? 'wait' : 'not-allowed') : 'pointer',\n      }}\n    >\n      {busy ? 'Searching recorded documents…' : buttonLabel}\n    </button>\n  );\n}\n\nfunction StatusChip({ status }: { status: RecordedIndexStatus }) {\n  return (\n    <span\n      style={{\n        display: 'inline-block',\n        borderRadius: 99,\n        padding: '3px 7px',\n        fontSize: 10.5,\n        fontWeight: 700,\n        textTransform: 'uppercase',\n        ...statusStyle(status),\n        ...WRAP,\n      }}\n    >\n      {label(status)}\n    </span>\n  );\n}\n\nfunction CoverageLedger({\n  indexes,\n  status,\n}: {\n  indexes: RecordedIndexResult[];\n  status: string;\n}) {\n  const scope = presentSearchScope({ status, indexes });\n  return (\n    <section\n      aria-labelledby=\"recorded-coverage-heading\"\n      style={{ borderTop: '1px solid #E5E7EB', padding: '16px', ...WRAP }}\n    >\n      <h4\n        id=\"recorded-coverage-heading\"\n        style={{ margin: '0 0 10px', fontSize: 14, color: '#111827', ...WRAP }}\n      >\n        Coverage ledger{' '}\n        <span style={{ color: '#6B7280', fontSize: 12 }}>\n          — {scope.summary}\n        </span>\n      </h4>\n      <div style={{ display: 'grid', gap: 8 }}>\n        {indexes.map((index) => (\n          <div\n            key={index.id}\n            style={{\n              display: 'grid',\n              gridTemplateColumns: 'minmax(130px, 1fr) auto auto',\n              alignItems: 'center',\n              gap: 8,\n              border: '1px solid #F0F1F2',\n              borderRadius: 8,\n              padding: '9px 10px',\n              fontSize: 12.5,\n              color: '#374151',\n              ...WRAP,\n            }}\n          >\n            <strong style={WRAP}>{index.label}</strong>\n            <StatusChip status={index.status} />\n            <span style={{ color: '#6B7280', whiteSpace: 'nowrap' }}>\n              {index.docCount} {index.docCount === 1 ? 'document' : 'documents'}\n            </span>\n            {index.blockerReason && (\n              <span\n                style={{\n                  gridColumn: '1 / -1',\n                  color: '#991B1B',\n                  fontSize: 12,\n                  ...WRAP,\n                }}\n              >\n                {index.blockerReason}\n              </span>\n            )}\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n\n[498 more lines in file. Use offset=201 to continue.]"}],"isError":false,"timestamp":1788196519856}}
