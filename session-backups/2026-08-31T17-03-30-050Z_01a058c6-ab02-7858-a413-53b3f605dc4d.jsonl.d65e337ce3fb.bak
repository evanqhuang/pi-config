{"type":"message","id":"0bafcb9a","parentId":"0bf96f82","timestamp":"2026-08-31T18:36:35.664Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-a0962a0fb8314350","toolName":"bash","content":[{"type":"text","text":"    scenarioOption(ctx)\n  );\n  if (snapshot === null) {\n    const info: CountyRecordsErrorInfo = {\n      code: 'parcel_gone',\n      message: publicMessageFor('parcel_gone'),\n    };\n    // Best effort, like the route: the old snapshot stays in place.\n    await recordCountyRefreshFailure(\n      uid,\n      propertyId,\n      info,\n      current.revision\n    ).catch((error) =>\n      console.warn(\n        `[agent-worker] best-effort refresh-failure record failed: ${String(error)}`\n      )\n    );\n    throw new WorkerBlockedError(\n      'parcel_gone',\n      publicMessageFor('parcel_gone')\n    );\n  }\n\n  const saved = await saveCountySnapshot(\n    uid,\n    propertyId,\n    snapshot,\n    input.expectedRevision,\n    casOptionsFor(task)\n  );\n  if (!saved) {\n    throw new WorkerBlockedError(\n      'state_mismatch',\n      'The record changed shape mid-run; reload and try again.'\n    );\n  }\n  return { eventType: 'county_record_refreshed', record: saved };\n}\n\n/**\n * recorded_documents_search (Task 5): run the recorded-documents provider\n * against the property's confirmed parcel (or its watchlist address) and\n * store the normalized search run. The run's top-level status follows the\n * required-index completion rule; this task produces NO county domain\n * event — the search run is its own state.\n */\nasync function runRecordedDocumentsSearch(\n"}],"isError":false,"timestamp":1788201395664}}
