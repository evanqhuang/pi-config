{"type":"message","id":"836f1ae9","parentId":"d6709ab8","timestamp":"2026-08-31T19:37:56.578Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-9fd06d0c9dbcd9a7","toolName":"read","content":[{"type":"text","text":"describe('redaction, cross-user, malformed proposals', () => {\n  it('a delegated-route error carrying an email and a URL is redacted in the record', async () => {\n    (getOwnerRequest as jest.Mock).mockResolvedValue(\n      ownerRequest({ status: 'approved', revision: 9 })\n    );\n    (sendRoute as jest.Mock).mockResolvedValue({\n      ok: false,\n      status: 409,\n      json: async () => ({\n        error:\n          'Provider error — contact owner@example.com or see https://provider.example/status for details',\n      }),\n    } as never);\n    const req = makeRequest(\n      proposal({\n        actionType: 'owner_request_send',\n        targetId: 'or:prop-1',\n        revision: 9,\n      })\n    );\n\n    const res = await executeCopilotAction('u1', req);\n    expect(res.code).toBe('ineligible');\n\n    const record = stored('u1', req.fingerprint);\n    const message = String(record?.message ?? '');\n    expect(message).toContain('[redacted-email]');\n    expect(message).toContain('[redacted-url]');\n    expect(message).not.toContain('owner@example.com');\n    expect(message).not.toContain('https://');\n  });\n\n  it('redactSensitive scrubs emails, URLs, and long opaque tokens', () => {\n    const out = redactSensitive(\n      'contact a.b+tag@mail.example.co.uk at https://x.example.com/a?b=1 and ' +\n        'x'.repeat(120)\n    );\n    expect(out).toContain('[redacted-email]');\n    expect(out).toContain('[redacted-url]');\n    expect(out).toContain('[redacted-token]');\n    expect(out).not.toContain('mail.example.co.uk');\n    expect(out.length).toBeLessThanOrEqual(500);\n  });\n\n  it('records are owner-scoped: another user starts their own lifecycle', async () => {\n    // u1 confirms and the action succeeds.\n    (getWatchlistItem as jest.Mock).mockImplementation((uid: string) =>\n      uid === 'u1' ? Promise.resolve(watchlistItem()) : Promise.resolve(null)\n    );\n    (getCountyRecord as jest.Mock).mockImplementation((uid: string) =>\n      uid === 'u1' ? Promise.resolve(countyRecord()) : Promise.resolve(null)\n    );\n    const req = makeRequest(\n      proposal({\n        actionType: 'county_confirm',\n        targetId: 'prop-1',\n        revision: 7,\n      })\n    );\n\n    const asU1 = await executeCopilotAction('u1', req);\n    expect(asU1.code).toBe('executed');\n\n    // u2 sends the SAME fingerprint (they never see u1's record — the\n    // collection is under users/{uid}); for u2 the property is not\n    // theirs, so this is an unauthorized rejection of their own.\n    const asU2 = await executeCopilotAction('u2', req);\n    expect(asU2.code).toBe('unauthorized');\n\n    expect(enqueueCountyTaskIfCurrent).toHaveBeenCalledTimes(1); // u1 only\n    expect(mockStore.size).toBe(2);\n    expect(stored('u1', req.fingerprint)?.state).toBe('succeeded');\n    expect(stored('u2', req.fingerprint)?.state).toBe('failed');\n    expect(stored('u2', req.fingerprint)?.code).toBe('unauthorized');\n  });\n\n  it('a stale revision settles the record as failed with the stale code', async () => {\n    (getWatchlistItem as jest.Mock).mockResolvedValue(watchlistItem());\n    (getCountyRecord as jest.Mock).mockResolvedValue(\n      countyRecord({ revision: 8 })\n    );\n    const req = makeRequest(\n      proposal({\n        actionType: 'county_refresh',\n        targetId: 'prop-1',\n        revision: 7,\n      })\n    );\n\n    const res = await executeCopilotAction('u1', req);\n    expect(res.code).toBe('stale');\n    const record = stored('u1', req.fingerprint);\n    expect(record?.state).toBe('failed');\n    expect(record?.code).toBe('stale');\n    expect(record?.action).toBeNull();\n  });\n});\n\n// --- body parsing -------------------------------------------------------------\n\n\n[64 more lines in file. Use offset=959 to continue.]"}],"isError":false,"timestamp":1788205076578}}
