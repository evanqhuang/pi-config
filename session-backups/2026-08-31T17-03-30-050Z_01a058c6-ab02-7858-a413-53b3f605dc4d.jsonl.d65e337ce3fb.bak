records-agent-launch/src/types/recorded-documents.ts","/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/types/screening.ts"],"lastVerificationCommand":"rtk git commit -m \"County coverage: fail-closed review state, transactional county reconcile, and read-surface guard\n\n- Add a fail-closed review coverage state: when the explicit county and\n  a confirmed parcel's provenance prove different counties, every\n  surface (property detail, list, coverage, screening, mutation routes,\n  worker) reports the contradiction and pauses county work instead of\n  routing on either side.\n- Resolve coverage from the same canonical inputs everywhere: the\n  explicit county plus the confirmed snapshot's provenance source id.\n  Provenance is a migration signal only — never inferred from\n  state/address.\n- Replace the non-atomic county backfill with a transactional\n  reconcileWatchlistCounty: idempotent on same-base matches, never\n  overwrites an explicit assertion, and the worker logs (not fails) a\n  reconcile miss so a durable confirm is never rolled back.\n- Give recorded-document reads an additive guard: stored results stay\n  retrievable but are flagged non-authoritative (with a typed coverage\n  note) whenever coverage is no longer live.\n- Tests: unit matrices for the resolver and the reconcile transaction,\n  route-agreement and zero-write tests across the detail/list/coverage/\n  recorded/confirm/refresh surfaces, and a Firestore-emulator\n  integration suite covering auto-confirm reconcile, idempotency, and\n  the review-blocked zero-write path.\"","lastVerificationOutcome":"success","recentFailedCommandCount":0}},"id":"d94ce73c","parentId":"be0b243a","timestamp":"2026-08-31T19:30:37.671Z"}
{"type":"message","id":"eb1ac936","parentId":"d94ce73c","timestamp":"2026-08-31T19:30:37.672Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-b10158f12744ac8e","toolName":"checkpoint_notes","content":[{"type":"text","text":"Notes checkpoint committed: /Users/evanhuang/.pi/agent/notes/9b3f771d-b43a-45a1-a4e6-1cad29d7d7c4/NOTES.md (generation 42, sha256 9c29a56867c6)"}],"details":{"notesPath":"/Users/evanhuang/.pi/agent/notes/9b3f771d-b43a-45a1-a4e6-1cad29d7d7c4/NOTES.md","generation":42,"hash":"9c29a56867c63e9df32a71c893e4ad21b49c4bb0a35e75f241600b173b7bab29"},"isError":false,"timestamp":1788204637672}}
{"type":"message","id":"f1cdc8bc","parentId":"eb1ac936","timestamp":"2026-08-31T19:30:40.921Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"I need to investigate this further. Let me check the details.\n\nThe advisory is advisory only — no action needed. Checkpoint 42 has been committed. Next: WU3. Read `src/lib/copilot-actions.ts` (the current implementation).\n","thinkingSignature":"reasoning"},{"type":"toolCall","id":"chatcmpl-tool-bbbc42ef18ff1fcf","name":"read","arguments":{"path":"/Users/evanhuang/brickspect/dashboard/.worktrees/records-agent-launch/src/lib/copilot-actions.ts"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":83364,"output":103,"cacheRead":0,"cacheWrite":0,"reasoning":54,"totalTokens":83467,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788204637677,"responseId":"chatcmpl-b0007d17db47e0ab","rawStopReason":"tool_calls"}}
{"type":"message","id":"3ffc3bbf","parentId":"f1cdc8bc","timestamp":"2026-08-31T19:30:40.942Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-bbbc42ef18ff1fcf","toolName":"read","content":[{"type":"text","text":"/**\n * Copilot action dispatcher (M3) — the ONLY server-side path that\n * executes a confirmed copilot proposal.\n *\n * Contract (design brief: \"no ambiguous clear, ever\" applies to actions\n * too):\n *\n *   - the allowlist is the allowlist: an action type that is not in\n *     COPILOT_ACTION_ALLOWLIST executes NOTHING (unknown types are\n *     rejected before any read or write, and proposal-only types —\n *     manual/offline work — have no server-side action at all);\n *   - the fingerprint binds the proposal the user actually saw: the\n *     confirm request must echo the sha256 of\n *     `${actionType}|${targetId}|${revision}|${summary}` exactly as\n *     computed by `proposalFingerprint` (the same function the\n *     `propose_action` tool stamps onto the streamed card). Any drift —\n *     a reworded summary, a swapped target — is `tampered` and executes\n *     NOTHING;\n *   - ownership, revision, and eligibility are re-checked SERVER-SIDE\n *     at execution time (the proposal payload is model-generated input\n *     and is never trusted);\n *   - a confirmed proposal invokes EXACTLY ONE authorized domain action\n *     through the same seam the dedicated endpoint uses (the county\n *     enqueue, cancelTask/retryTask, or the owner-request route\n *     handlers), each already idempotent/CAS-checked — a duplicate\n *     confirmation finds the world has moved and executes nothing;\n *   - every attempted confirmation gets a DURABLE, owner-scoped,\n *     redacted execution record (copilotActionExecutions), keyed by\n *     the proposal fingerprint, with explicit states: accepted →\n *     executing → succeeded/failed. The record is claimed BEFORE the\n *     domain action runs, so a persistence failure can never produce an\n *     unrecorded successful mutation; a terminal record is replayed on\n *     duplicate confirmations (one confirmation → one action, one\n *     lifecycle); a crash between accepted and succeeded leaves a\n *     non-terminal record that a later retry reclaims and reconciles\n *     (safe because every domain seam is idempotent/CAS-keyed).\n */\nimport { createHash } from 'crypto';\nimport { NextRequest } from 'next/server';\nimport { z } from 'zod';\nimport {\n  getCountyRecord,\n  enqueueCountyTaskIfCurrent,\n} from '@/lib/firestore/county-records';\nimport { getWatchlistItem } from '@/lib/firestore/properties';\nimport { cancelTask, retryTask } from '@/lib/firestore/agent-tasks';\nimport {\n  AgentTaskRevisionConflictError,\n  AgentTaskStateError,\n} from '@/types/agent-tasks';\nimport {\n  resolveCountyCoverage,\n  notCoveredPayload,\n} from '@/lib/county-records/capabilities';\nimport { getFirestoreDb } from '@/lib/firebase/admin';\nimport { getOwnerRequest } from '@/lib/firestore/owner-requests';\nimport { POST as draftOwnerRequest } from '@/app/api/properties/[id]/owner-requests/[requestId]/draft/route';\nimport { POST as sendOwnerRequest } from '@/app/api/properties/[id]/owner-requests/[requestId]/send/route';\nimport type { OwnerRequest } from '@/types/owner-requests';\nimport {\n  COPILOT_ACTION_ALLOWLIST as CANONICAL_ALLOWLIST,\n  COPILOT_PROPOSAL_ONLY as CANONICAL_PROPOSAL_ONLY,\n  COPILOT_ACTION_TYPES as CANONICAL_ACTION_TYPES,\n  type ExecutableCopilotAction as CanonicalExecutable,\n  canonicalProposalString,\n} from '@/lib/copilot-proposal';\n\n// The canonical action-type contract lives in copilot-proposal.ts\n// (isomorphic — the client stream parser and the tool schema source\n// the same lists). These re-exports keep the existing server-side\n// import surface stable.\nexport const COPILOT_ACTION_ALLOWLIST = CANONICAL_ALLOWLIST;\nexport const COPILOT_PROPOSAL_ONLY = CANONICAL_PROPOSAL_ONLY;\nexport const COPILOT_ACTION_TYPES = CANONICAL_ACTION_TYPES;\nexport type ExecutableCopilotAction = CanonicalExecutable;\n\n/** The proposal as it was streamed (what the user saw and confirmed). */\nexport interface CopilotProposal {\n  actionType: string;\n  targetId: string;\n  /** The revision the proposal was made against (null when unknown). */\n  revision: number | null;\n  summary: string;\n}\n\n/** Lowercase hex sha256 over an arbitrary string (server-side hasher). */\nexport function sha256Hex(text: string): string {\n  return createHash('sha256').update(text).digest('hex');\n}\n\n/**\n * The tamper-binding fingerprint: sha256 over the canonical proposal\n * string (copilot-proposal.ts is the single source of the format).\n * The `propose_action` tool stamps this onto the streamed card; the\n * confirm request must echo it.\n */\nexport function proposalFingerprint(p: CopilotProposal): string {\n  return sha256Hex(canonicalProposalString(p));\n}\n\nexport interface CopilotExecuteRequest {\n  proposal: CopilotProposal;\n  /** Echoed fingerprint of `proposal` — must match exactly. */\n  fingerprint: string;\n  /**\n   * Caller-stable key (the UI sends the message id). Stored on the\n   * execution record for traceability; the domain idempotency keys are\n   * derived from the proposal itself so retries stay deterministic.\n   */\n  idempotencyKey: string;\n  /** The authenticated HTTP request (used for endpoint delegation). */\n  httpRequest: NextRequest;\n}\n\nexport type CopilotActionCode =\n  | 'executed'\n  | 'not_allowed'\n  | 'tampered'\n  | 'unauthorized'\n  | 'stale'\n  | 'ineligible'\n  | 'interrupted'\n  | 'audit_unavailable'\n  | 'failure';\n\nexport interface CopilotExecuteResult {\n  code: CopilotActionCode;\n  message: string;\n  /** Present for `executed`: which single domain action was invoked. */\n  action?: string;\n}\n\nconst executeRequestSchema = z.object({\n  proposal: z.object({\n    actionType: z.string().min(1).max(64),\n    targetId: z.string().min(1).max(200),\n    revision: z.number().int().nonnegative().nullable().optional(),\n    summary: z.string().min(10).max(500),\n  }),\n  fingerprint: z.string().regex(/^[a-f0-9]{64}$/),\n  idempotencyKey: z.string().min(8).max(200),\n});\n\nexport type ParsedCopilotExecuteRequest = z.infer<\n  typeof executeRequestSchema\n> & {\n  proposal: CopilotProposal;\n};\n\n/**\n * Parse a raw execute body. `revision: undefined` normalizes to\n * `null` (an unknown revision can never CAS, so the dispatcher treats\n * it as stale for actions that require one).\n */\nexport function parseCopilotExecuteRequest(raw: unknown):\n  | {\n      ok: true;\n      value: ParsedCopilotExecuteRequest;\n    }\n  | { ok: false; error: string } {\n  const parsed = executeRequestSchema.safeParse(raw);\n  if (!parsed.success) {\n    return {\n      ok: false,\n      error: parsed.error.issues[0]?.message ?? 'Invalid body',\n    };\n  }\n  return {\n    ok: true,\n    value: {\n      ...parsed.data,\n      proposal: {\n        ...parsed.data.proposal,\n        revision: parsed.data.proposal.revision ?? null,\n      },\n    },\n  };\n}\n\n/** Lifecycle of a durable execution record (see the module header). */\nexport type CopilotActionState =\n  | 'accepted'\n  | 'executing'\n  | 'succeeded'\n  | 'failed';\n\n/**\n * The durable per-confirmation record. Redacted by construction: no\n * parcel addresses, no recipient emails, no draft text — only the\n * action type, target id, fingerprint, the caller key, and outcome\n * phrases.\n */\nexport interface CopilotActionExecution {\n  actionType: string;\n  targetId: string;\n  fingerprint: string;\n  idempotencyKey: string;\n  state: CopilotActionState;\n  /** Terminal outcome code (null until the record is terminal). */\n  code: CopilotActionCode | null;\n  /** Redacted outcome message (empty until the record is terminal). */\n  message: string;\n  /** Which domain action ran (null until executed). */\n  action: string | null;\n  acceptedAt: string;\n  updatedAt: string;\n  /** How many times this confirmation has been (re)claimed. */\n  attempts: number;\n}\n\nconst EXECUTIONS_COLLECTION = 'copilotActionExecutions';\n\n/**\n * A non-terminal record younger than this is treated as genuinely\n * in-flight (a concurrent confirmation); older than this it is\n * considered crashed and is reclaimable by a retry. Five minutes covers\n * the slowest domain seam (the mail send) with wide margin.\n */\nexport const IN_FLIGHT_GRACE_MS = 5 * 60 * 1000;\n\n/**\n * Scrub anything that could be a secret or personal input out of a\n * message before it is persisted: email addresses, URLs, and very long\n * opaque tokens. Outcome messages are fixed phrases by construction,\n * but delegated-route error text is external input and gets scrubbed\n * too.\n */\nexport function redactSensitive(text: string): string {\n  return text\n    .replace(/[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}/gi, '[redacted-email]')\n    .replace(/https?:\\/\\/\\S+/gi, '[redacted-url]')\n    .replace(/\\S{80,}/g, '[redacted-token]')\n    .slice(0, 500);\n}\n\nfunction nowIso(): string {\n  return new Date().toISOString();\n}\n\nfunction executionDocRef(\n  db: ReturnType<typeof getFirestoreDb>,\n  uid: string,\n  fingerprint: string\n) {\n  return db\n    .collection('users')\n    .doc(uid)\n    .collection(EXECUTIONS_COLLECTION)\n    .doc(fingerprint);\n}\n\n/**\n * A record is \"freshly in-flight\" while it is non-terminal and younger\n * than the grace window. Non-terminal records that are older (or whose\n * timestamp is unusable) are crashed and may be reclaimed by a retry.\n */\nfunction isFreshInFlight(\n  record: CopilotActionExecution,\n  nowMs: number = Date.now()\n): boolean {\n  if (record.state !== 'accepted' && record.state !== 'executing') {\n    return false;\n  }\n  const updated = Date.parse(record.updatedAt ?? '');\n  return !Number.isNaN(updated) && nowMs - updated < IN_FLIGHT_GRACE_MS;\n}\n\nfunction isTerminal(record: CopilotActionExecution): boolean {\n  return record.state === 'succeeded' || record.state === 'failed';\n}\n\n/** Map a terminal record back to the result a duplicate gets replayed. */\nfunction replayResult(record: CopilotActionExecution): CopilotExecuteResult {\n  const code =\n    record.code ?? (record.state === 'succeeded' ? 'executed' : 'failure');\n  return {\n    code,\n    message: record.message || 'This confirmation was already processed.',\n    action: record.action ?? undefined,\n  };\n}\n\n/**\n * Persist a TERMINAL execution record for a gate-level rejection\n * (allowlist / tamper). Uses the same idempotent claim semantics as\n * the execution path: an existing terminal record is replayed, a fresh\n * in-flight one yields interrupted, everything else becomes terminal\n * with this gate's outcome.\n */\nasync function recordGateOutcome(\n  uid: string,\n  req: CopilotExecuteRequest,\n  code: CopilotActionCode,\n  message: string\n): Promise<CopilotExecuteResult> {\n  const { proposal, fingerprint, idempotencyKey } = req;\n  const result: CopilotExecuteResult = { code, message };\n  try {\n    const docRef = executionDocRef(getFirestoreDb(), uid, fingerprint);\n    const got = await docRef.get();\n    if (got.exists) {\n      const record = got.data() as CopilotActionExecution;\n      if (isTerminal(record)) return replayResult(record);\n      if (isFreshInFlight(record)) {\n        return {\n          code: 'interrupted',\n          message:\n            'The same confirmation is already in flight; nothing new was started.',\n        };\n      }\n      // Stale non-terminal: settle it with this gate's outcome.\n      await docRef.update({\n        state: 'failed',\n        code,\n        message: redactSensitive(message),\n        action: null,\n        updatedAt: nowIso(),\n      });\n    } else {\n      const t = nowIso();\n      await docRef.create({\n        actionType: proposal.actionType,\n        targetId: proposal.targetId,\n        fingerprint,\n        idempotencyKey,\n        state: 'failed',\n        code,\n        message: redactSensitive(message),\n        action: null,\n        acceptedAt: t,\n        updatedAt: t,\n        attempts: 1,\n      });\n    }\n  } catch (error) {\n    // A gate rejection executed nothing, so nothing is lost by a failed\n    // audit write — but the caller must not be told a clean rejection.\n    console.error('Failed to record copilot action gate outcome:', error);\n    return {\n      code: 'audit_unavailable',\n      message:\n        'The confirmation could not be durably recorded, so no outcome was applied; retry the confirmation.',\n    };\n  }\n  return result;\n}\n\n/**\n * Claim the durable execution record for a confirmation, idempotently\n * keyed by the proposal fingerprint:\n *\n *   - no record yet            → create it as `accepted` (the claim is\n *                                what makes every later domain action\n *                                traceable to exactly one confirmation);\n *   - terminal record          → replay it (duplicate confirmation);\n *   - fresh non-terminal       → interrupted (concurrent in-flight);\n *   - stale non-terminal       → reclaim it (crash recovery) and count\n *                                the attempt.\n *\n * If the create races with a concurrent claim (the doc appears in the\n * meantime) the result is re-read and re-decided. A claim that cannot\n * be persisted at all returns `null` — the caller MUST refuse to\n * execute (no durable record ⇒ no unrecorded mutation).\n */\nasync function claimExecution(\n  uid: string,\n  req: CopilotExecuteRequest\n): Promise<\n  | { kind: 'proceed' }\n  | { kind: 'replay'; result: CopilotExecuteResult }\n  | { kind: 'interrupted'; result: CopilotExecuteResult }\n  | { kind: 'unavailable' }\n> {\n  const { proposal, fingerprint, idempotencyKey } = req;\n  const docRef = executionDocRef(getFirestoreDb(), uid, fingerprint);\n\n  const decide = (\n    record: CopilotActionExecution | null\n  ):\n    | { kind: 'fresh' }\n    | { kind: 'replay'; result: CopilotExecuteResult }\n    | { kind: 'interrupted'; result: CopilotExecuteResult }\n    | { kind: 'reclaim'; record: CopilotActionExecution } => {\n    if (!record) return { kind: 'fresh' };\n    if (isTerminal(record)) {\n      return { kind: 'replay', result: replayResult(record) };\n    }\n    if (isFreshInFlight(record)) {\n      return {\n        kind: 'interrupted',\n        result: {\n          code: 'interrupted',\n          message:\n            'The same confirmation is already in flight; nothing new was started.',\n        },\n      };\n    }\n    return { kind: 'reclaim', record };\n  };\n\n  const got = await docRef.get();\n  let decision = decide(\n    got.exists ? (got.data() as CopilotActionExecution) : null\n  );\n\n  if (decision.kind === 'fresh') {\n    try {\n      const t = nowIso();\n      await docRef.create({\n        actionType: proposal.actionType,\n        targetId: proposal.targetId,\n        fingerprint,\n        idempotencyKey,\n        state: 'accepted',\n        code: null,\n        message: '',\n        action: null,\n        acceptedAt: t,\n        updatedAt: t,\n        attempts: 1,\n      });\n      return { kind: 'proceed' };\n    } catch (error) {\n      // Either we lost the create race (a concurrent claim landed) or\n      // persistence is genuinely down. Re-read and re-decide; if there\n      // is still no record, persistence failed and execution is refused.\n      const again = await docRef.get();\n      decision = decide(\n        again.exists ? (again.data() as CopilotActionExecution) : null\n      );\n      if (decision.kind === 'fresh') {\n        console.error(\n          'Failed to claim copilot action execution record:',\n          error\n        );\n        return { kind: 'unavailable' };\n      }\n    }\n  }\n\n  if (decision.kind === 'replay')\n    return { kind: 'replay', result: decision.result };\n  if (decision.kind === 'interrupted') {\n    return { kind: 'interrupted', result: decision.result };\n  }\n  if (decision.kind === 'reclaim') {\n    await docRef.update({\n      state: 'executing',\n      updatedAt: nowIso(),\n      attempts: (decision.record.attempts ?? 1) + 1,\n    });\n    return { kind: 'proceed' };\n  }\n  return { kind: 'unavailable' };\n}\n\n/**\n * Execute a confirmed copilot proposal: exactly one authorized domain\n * action, or nothing — and never without a durable execution record.\n */\nexport async function executeCopilotAction(\n  uid: string,\n  req: CopilotExecuteRequest\n): Promise<CopilotExecuteResult> {\n  const { proposal, fingerprint } = req;\n\n  // 0) Allowlist — before ANY read. Unknown types and proposal-only\n  //    types execute nothing by design; the rejection is still recorded\n  //    durably (every attempted confirmation has an outcome).\n  if (\n    !COPILOT_ACTION_TYPES.includes(\n      proposal.actionType as (typeof COPILOT_ACTION_TYPES)[number]\n    )\n  ) {\n    return recordGateOutcome(\n      uid,\n      req,\n      'not_allowed',\n      'This action type is not on the copilot allowlist; nothing was executed.'\n    );\n  }\n  if (\n    COPILOT_PROPOSAL_ONLY.includes(\n      proposal.actionType as (typeof COPILOT_PROPOSAL_ONLY)[number]\n    )\n  ) {\n    return recordGateOutcome(\n      uid,\n      req,\n      'not_allowed',\n      'This action is manual work — there is nothing to run server-side, so nothing was executed.'\n    );\n  }\n\n  // 1) Tamper check — the echoed fingerprint must match the proposal\n  //    exactly as the user saw it.\n  if (proposalFingerprint(proposal) !== fingerprint) {\n    return recordGateOutcome(\n      uid,\n      req,\n      'tampered',\n      'The proposal no longer matches what you confirmed; nothing was executed. Ask the copilot to re-propose.'\n    );\n  }\n\n  // 2) Claim the durable record BEFORE any domain read or write. If the\n  //    claim cannot be persisted, nothing executes (the acceptance bar:\n  //    an audit persistence failure cannot produce an unrecorded\n  //    successful mutation).\n  const claim = await claimExecution(uid, req);\n  if (claim.kind === 'replay') return claim.result;\n  if (claim.kind === 'interrupted') return claim.result;\n  if (claim.kind === 'unavailable') {\n    return {\n      code: 'audit_unavailable',\n      message:\n        'This confirmation could not be durably recorded, so nothing was executed; retry the confirmation.',\n    };\n  }\n\n  // 3) Mark executing (best-effort — the record already exists, which is\n  //    what the contract requires; a crash here leaves a reclaimable\n  //    `accepted` record).\n  const docRef = executionDocRef(getFirestoreDb(), uid, fingerprint);\n  try {\n    await docRef.update({ state: 'executing', updatedAt: nowIso() });\n  } catch {\n    // The durable record exists as `accepted`; continue.\n  }\n\n  // 4) Dispatch — one authorized domain action per type. Ownership,\n  //    revision, and eligibility are all re-checked here (the proposal\n  //    payload is model-generated input and is never trusted).\n  let result: CopilotExecuteResult;\n  try {\n    result = await dispatchAction(uid, proposal, req);\n  } catch (error) {\n    // The internal marker means the proposal can no longer be applied\n    // safely (missing or moved revision) — a clean 'stale'.\n    result =\n      error instanceof StaleProposalError\n        ? { code: 'stale', message: error.message }\n        : {\n            code: 'failure',\n            message:\n              error instanceof Error\n                ? error.message\n                : 'The action could not be completed.',\n          };\n  }\n\n  // 5) Finalize the durable record (awaited — no fire-and-forget). The\n  //    state is `succeeded` only for an executed action; every other\n  //    outcome settles the record as `failed` with its outcome code.\n  const state: CopilotActionState =\n    result.code === 'executed' ? 'succeeded' : 'failed';\n  try {\n    await docRef.update({\n      state,\n      code: result.code,\n      message: redactSensitive(result.message),\n      action: result.action ?? null,\n      updatedAt: nowIso(),\n    });\n  } catch (error) {\n    // The domain action may have run but its record is stuck\n    // non-terminal. Return a distinct, non-clean outcome; the retry\n    // reclaims the stale record and the idempotent/CAS seams make the\n    // second attempt a safe no-op (documented recovery path).\n    console.error('Failed to finalize copilot action execution record:', error);\n    return {\n      code: 'audit_unavailable',\n      message:\n        'The action may have been applied but its audit record could not be finalized; retry the confirmation to reconcile.',\n    };\n  }\n  return result;\n}\n\n/**\n * The dispatch switch: one authorized domain action per allowlisted\n * type. Throws StaleProposalError when the proposal can no longer be\n * applied safely.\n */\nasync function dispatchAction(\n  uid: string,\n  proposal: CopilotProposal,\n  req: CopilotExecuteRequest\n): Promise<CopilotExecuteResult> {\n  switch (proposal.actionType as ExecutableCopilotAction) {\n    case 'county_confirm':\n    case 'county_refresh':\n      return await countyAction(uid, proposal);\n\n    case 'task_cancel':\n    case 'task_retry':\n      return await taskAction(uid, proposal);\n\n    case 'owner_request_draft':\n      return await ownerRequestAction(uid, proposal, req, draftOwnerRequest, {\n        body: { expectedRevision: requireRevision(proposal) },\n        route: 'draft',\n      });\n\n    case 'owner_request_send':\n      return await ownerRequestAction(uid, proposal, req, sendOwnerRequest, {\n        body: {\n          expectedRevision: requireRevision(proposal),\n          // A stable key bound to the proposal — the mail provider\n          // and the send-attempt record both use it, which is what\n          // makes a duplicate confirmation a no-op, never a second\n          // email.\n          idempotencyKey: `copilot:send:${proposal.targetId}:${proposal.revision ?? 'none'}`,\n        },\n        route: 'send',\n      });\n  }\n\n  // Unreachable: the switch covers every allowlisted type.\n  return {\n    code: 'not_allowed',\n    message:\n      'This action type has no server-side action; nothing was executed.',\n  };\n}\n\n/**\n * Owner-request actions need a revision to CAS against; a proposal\n * without one can never be applied safely.\n */\nfunction requireRevision(proposal: CopilotProposal): number {\n  if (proposal.revision === null) {\n    // Signal: the dispatcher short-circuits via the thrown marker.\n    throw new StaleProposalError(\n      'This proposal does not name a revision, so it cannot be applied safely; nothing was executed.'\n    );\n  }\n  return proposal.revision;\n}\n\n/** Internal marker: a proposal that cannot CAS (missing/stale revision). */\nexport class StaleProposalError extends Error {}\n\n/**\n * county_confirm / county_refresh — the same enqueue seam the dedicated\n * endpoints use (revision-CAS + idempotency key), with the same\n * eligibility rules. A confirm with more than one candidate is NOT\n * executed: picking a parcel is a human decision.\n */\nasync function countyAction(\n  uid: string,\n  proposal: CopilotProposal\n): Promise<CopilotExecuteResult> {\n  const propertyId = proposal.targetId;\n\n  const item = await getWatchlistItem(uid, propertyId);\n  if (!item) {\n    return {\n      code: 'unauthorized',\n      message: 'That property is not in your watchlist; nothing was executed.',\n    };\n  }\n\n  const record = await getCountyRecord(uid, propertyId);\n  if (!record) {\n    return {\n      code: 'ineligible',\n      message:\n        'There is no county record to act on yet; run a resolution first.',\n    };\n  }\n\n  // The M1 coverage gate, re-checked at execution time.\n  const coverage = resolveCountyCoverage(\n    item.county ?? null,\n    record.snapshot?.provenance?.sourceId ?? null\n  );\n  if (coverage.status !== 'live') {\n    return { code: 'ineligible', message: notCoveredPayload(coverage).message };\n  }\n\n  // Revision check: the proposal must name the record's current\n  // revision. A null proposal revision can never CAS.\n  if (proposal.revision === null || record.revision !== proposal.revision) {\n    throw new StaleProposalError(\n      'The county record changed since this proposal; nothing was executed. Re-run it from the property page.'\n    );\n  }\n\n  if (proposal.actionType === 'county_confirm') {\n    if (record.status !== 'confirmation_required' || !record.resolvedAddress) {\n      return {\n        code: 'ineligible',\n        message:\n          'No candidates are pending confirmation for this parcel; nothing was executed.',\n      };\n    }\n    if (!record.candidates || record.candidates.length !== 1) {\n      return {\n        code: 'ineligible',\n        message:\n          'Several candidates are pending — choosing a parcel is a human decision, so confirm it on the property page.',\n      };\n    }\n    const objectId = record.candidates[0].objectId;\n    const result = await enqueueCountyTaskIfCurrent(\n      uid,\n      propertyId,\n      'county_confirm',\n      {\n        expectedRevision: record.revision,\n        objectId,\n        address: record.resolvedAddress,\n        county: coverage.county,\n      },\n      record.revision\n    );\n    if (result.stale) {\n      throw new StaleProposalError(\n        'The county record changed while this action was being applied; nothing was executed.'\n      );\n    }\n    return {\n      code: 'executed',\n      message: 'Parcel confirmation was enqueued.',\n      action: 'county_confirm',\n    };\n  }\n\n  // county_refresh\n  if (record.status !== 'confirmed') {\n    return {\n      code: 'ineligible',\n      message:\n        'Only a confirmed parcel can be refreshed; nothing was executed.',\n    };\n  }\n  const result = await enqueueCountyTaskIfCurrent(\n    uid,\n    propertyId,\n    'county_refresh',\n    { expectedRevision: record.revision, county: coverage.county },\n    record.revision\n  );\n  if (result.stale) {\n    throw new StaleProposalError(\n      'The county record changed while this action was being applied; nothing was executed.'\n    );\n  }\n  return {\n    code: 'executed',\n    message: 'Parcel refresh was enqueued.',\n    action: 'county_refresh',\n  };\n}\n\n/**\n * task_cancel / task_retry — the same CAS seams the dedicated routes\n * use. The proposal's revision is the CAS token; the world moving\n * (a duplicate confirmation, a concurrent cancel) throws inside the\n * transaction and executes nothing.\n */\nasync function taskAction(\n  uid: string,\n  proposal: CopilotProposal\n): Promise<CopilotExecuteResult> {\n  if (proposal.revision === null) {\n    throw new StaleProposalError(\n      'This proposal does not name a revision, so it cannot be applied safely; nothing was executed.'\n    );\n  }\n\n  try {\n    if (proposal.actionType === 'task_cancel') {\n      await cancelTask(uid, proposal.targetId, proposal.revision);\n    } else {\n      await retryTask(uid, proposal.targetId, proposal.revision);\n    }\n    return {\n      code: 'executed',\n      message: `Task ${proposal.targetId} ${proposal.actionType === 'task_cancel' ? 'canceled' : 'retried'}.`,\n      action: proposal.actionType,\n    };\n  } catch (error) {\n    if (error instanceof AgentTaskRevisionConflictError) {\n      // The world moved (duplicate confirmation or concurrent edit):\n      // the transaction rolled back — nothing executed.\n      throw new StaleProposalError(\n        'The task changed since this proposal; nothing was executed.'\n      );\n    }\n    if (error instanceof AgentTaskStateError) {\n      const msg = error.message ?? '';\n      if (/succeeded/i.test(msg)) {\n        return {\n          code: 'ineligible',\n          message:\n            'That task already finished; there is nothing left to ' +\n            (proposal.actionType === 'task_cancel' ? 'cancel' : 'retry') +\n            '.',\n        };\n      }\n      if (/attempt/i.test(msg)) {\n        return {\n          code: 'ineligible',\n          message:\n            'That task has used all of its retries; nothing was executed.',\n        };\n      }\n      throw new StaleProposalError(\n        'The task changed since this proposal; nothing was executed.'\n      );\n    }\n    if (error instanceof Error && /not found/i.test(error.message)) {\n      return {\n        code: 'unauthorized',\n        message: 'That task is not in your queue; nothing was executed.',\n      };\n    }\n    // Revision-conflict and other CAS errors: the world moved, the\n    // transaction rolled back — nothing executed.\n    throw new StaleProposalError(\n      'The task changed since this proposal; nothing was executed.'\n    );\n  }\n}\n\ninterface OwnerRequestDelegation {\n  body: Record<string, unknown>;\n  route: 'draft' | 'send';\n}\n\n/**\n * owner_request_draft / owner_request_send — delegated to the EXISTING\n * authenticated endpoint handlers (the single source of truth for the\n * state machine, the approval binding, and mail idempotency). The\n * dispatcher contributes the pre-gates (allowlist/fingerprint) and\n * maps their responses into the uniform result codes.\n */\nasync function ownerRequestAction(\n  uid: string,\n  proposal: CopilotProposal,\n  req: CopilotExecuteRequest,\n  route: (\n    request: NextRequest,\n    ctx: { params: Promise<{ id: string; requestId: string }> }\n  ) => Promise<import('next/server').NextResponse>,\n  delegation: OwnerRequestDelegation\n): Promise<CopilotExecuteResult> {\n  let expectedRevision: number;\n  try {\n    expectedRevision = requireRevision(proposal);\n  } catch (error) {\n    if (error instanceof StaleProposalError) {\n      return { code: 'stale', message: error.message };\n    }\n    throw error;\n  }\n  delegation.body.expectedRevision = expectedRevision;\n\n  // Ownership pre-gate: the request must exist for THIS user (the\n  // delegated route re-checks everything, this just fails fast without\n  // trusting the proposal's target).\n  const current: OwnerRequest | null = await getOwnerRequest(\n    uid,\n    proposal.targetId\n  );\n  if (!current) {\n    return {\n      code: 'unauthorized',\n      message: 'That owner request is not yours; nothing was executed.',\n    };\n  }\n\n  // Delegate: a fresh request carries the user's Authorization header\n  // and the ROUTE's own expected body (the original request's body is\n  // the execute payload — consumed already, and not this schema).\n  // The route re-authenticates and re-checks the full protocol.\n  const params = Promise.resolve({\n    id: current.propertyId,\n    requestId: proposal.targetId,\n  });\n  const headers = new Headers(req.httpRequest.headers);\n  const synthetic = new NextRequest(req.httpRequest.url, {\n    method: 'POST',\n    headers,\n    body: JSON.stringify(delegation.body),\n  });\n  const res = await route(synthetic, { params });\n\n  if (res.ok) {\n    return {\n      code: 'executed',\n      message:\n        delegation.route === 'draft'\n          ? 'The owner-request draft was started.'\n          : 'The owner request send was applied.',\n      action: proposal.actionType,\n    };\n  }\n\n  let body: Record<string, unknown> = {};\n  try {\n    body = (await res.json()) as Record<string, unknown>;\n  } catch {\n    // Non-JSON error body — fall through to the status mapping.\n  }\n\n  const err = typeof body.error === 'string' ? body.error : '';\n  if (res.status === 404) {\n    return {\n      code: 'unauthorized',\n      message: 'That owner request is not yours; nothing was executed.',\n    };\n  }\n  if (res.status === 409) {\n    if (/revision|changed/i.test(err)) {\n      return {\n        code: 'stale',\n        message: `The request changed since this proposal: ${err || 'revision conflict'}`,\n      };\n    }\n    if (delegation.route === 'send' && /sending|already/i.test(err)) {\n      return {\n        code: 'interrupted',\n        message: 'A send is already in flight; nothing new was started.',\n      };\n    }\n    return {\n      code: 'ineligible',\n      message:\n        err ||\n        'The request is not in a state where this can run; nothing was executed.',\n    };\n  }\n  return {\n    code: 'failure',\n    message: err || `The action failed (HTTP ${res.status}).`,\n  };\n}\n"}],"isError":false,"timestamp":1788204640942}}
{"type":"message","id":"c07ab7cd","parentId":"3ffc3bbf","timestamp":"2026-08-31T19:31:11.767Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now I understand the current implementation. WU3 gaps (from the audit plan):\n\n1. **`claimExecution` uses read-then-unconditional-update** — the reclaim path reads the doc, then `docRef.update()`s without any CAS. Two concurrent reclaimers can both pass `decide()` (both see the same stale non-terminal record), and both update → both proceed to dispatch. Fix: use `runTransaction`, and re-verify inside the transaction (get the doc within the tx; if a terminal record has appeared → replay; if a fresh in-flight one → interrupted; if stale non-terminal → update to `executing` with attempts+1; if no record → create with accepted). Firestore transactions guarantee isolation — concurrent create/update within the tx will conflict and retry, so at most one winner.\n\n2. **`recordGateOutcome` has the same read-then-update race** — same fix pattern via a transaction.\n\n3. **`targetId` and `idempotencyKey` are persisted verbatim as caller-controlled values** — audit gap: an attacker can put arbitrary strings (PII, huge payloads) into these fields, which get stored on the durable record. Fix: store a validated/canonicalized form:\n   - `targetId` → store a keyed hash? But the audit says \"store the validated canonical identifier or a keyed hash.\" What is the canonical form of targetId? It depends on the action type:\n     - county_*: propertyId (watchlist item ID — the shape is something like 'prop-...'? Actually it's a Crexi property ID).\n     - task_*: agent task ID.\n     - owner_request_*: owner request ID.\n   The cleanest, most honest approach consistent with the \"redact by construction\" policy: store a keyed sha256 hash of the targetId (HMAC or sha256 with a server secret) — but then the record becomes unreadable to operators. The audit says \"or a keyed hash\" — meaning either is acceptable. But is targetId PII? A property ID or task ID is an identifier, not PII. The concern from the audit (I don't have the exact wording on hand — let me check the plan doc for WU3 details). Let me read the WU3 section of the plan file.\n\n4. **No schemaVersion on the CopilotActionExecution doc** — add `schemaVersion: 1`.\n\nTo get the exact acceptance criteria, let me read the WU3 section of the audit plan doc.\n","thinkingSignature":"reasoning"},{"type":"text","text":"\n\nI've read through the current `copilot-actions.ts` file. Now I'll check the WU3 section of the audit plan to review the exact acceptance criteria.\n\n"},{"type":"toolCall","id":"chatcmpl-tool-a206b8768a90698d","name":"bash","arguments":{"command":"grep -n \"WU3\" docs/superpowers/plans/2026-08-23-records-agent-final-audit-gap-closure.md | head; echo ---; awk '/^## WU3|WU3:/{found=1} found{print} /^## WU4/{if(found) exit}' docs/superpowers/plans/2026-08-23-records-agent-final-audit-gap-closure.md | head -80"}}],"api":"openai-completions","provider":"qwen38-main","model":"qwen3.8-27b","usage":{"input":91624,"output":704,"cacheRead":0,"cacheWrite":0,"reasoning":537,"totalTokens":92328,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788204640947,"responseId":"chatcmpl-96156f5b067b6d32","rawStopReason":"tool_calls"}}
