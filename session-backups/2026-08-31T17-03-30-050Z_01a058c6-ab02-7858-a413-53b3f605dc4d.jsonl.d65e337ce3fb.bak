{"type":"message","id":"9f17bcb7","parentId":"d77799a2","timestamp":"2026-08-31T19:00:23.663Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-96ab09bef28825e8","toolName":"read","content":[{"type":"text","text":"  it('enqueues county confirmation with only stored candidate data', async () => {\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(202);\n    expect(await response.json()).toEqual({\n      taskId: 'task-confirm-1',\n      taskRevision: 2,\n      stateRevision: 3,\n      created: true,\n    });\n    expect(enqueueCountyTaskIfCurrent).toHaveBeenCalledWith(\n      'u1',\n      'prop-001',\n      'county_confirm',\n      {\n        expectedRevision: 3,\n        objectId: 420002,\n        address: ADDRESS,\n        county: { code: 'cuyahoga-oh', name: 'Cuyahoga County' },\n      },\n      3\n    );\n    expectNoStore(response);\n  });\n\n  it('returns the canonical conflict when enqueue observes a stale record', async () => {\n    const current = storedRecord({\n      status: 'confirmed',\n      revision: 4,\n      candidates: null,\n      snapshot: SNAPSHOT,\n    });\n    (enqueueCountyTaskIfCurrent as jest.Mock).mockResolvedValue({\n      stale: current,\n      task: null,\n      created: false,\n      recordRevision: 4,\n    });\n\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(409);\n    expect(await response.json()).toEqual({\n      error: 'county_record_changed',\n      message: 'County record changed; reload and try again.',\n      state: { state: 'loaded', revision: 4, snapshot: SNAPSHOT },\n    });\n    expectNoStore(response);\n  });\n\n  it('returns 404 when no county record exists', async () => {\n    (getCountyRecord as jest.Mock).mockResolvedValue(null);\n\n    const response = await POST(post(), params());\n\n    expect(response.status).toBe(404);\n    expect(await response.json()).toEqual({\n      error: 'No county record for this property',\n    });\n    expect(enqueueCountyTaskIfCurrent).not.toHaveBeenCalled();\n  });\n\n  it('returns the canonical conflict when the observed revision is stale', async () => {\n    const current = storedRecord({ revision: 4 });\n    (getCountyRecord as jest.Mock).mockResolvedValue(current);\n\n[46 more lines in file. Use offset=211 to continue.]"}],"isError":false,"timestamp":1788202823663}}
