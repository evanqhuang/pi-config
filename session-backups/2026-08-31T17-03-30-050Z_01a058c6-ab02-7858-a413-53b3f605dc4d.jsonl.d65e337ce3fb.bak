y v1 records, which carry the\n+   *  raw targetId/idempotencyKey and remain readable — the replay and\n+   *  in-flight checks depend only on state and timestamps. */\n+  schemaVersion?: number;\n   actionType: string;\n-  targetId: string;\n+  /** v2: keyed hash of the caller's targetId (keyedIdentifierRef) —\n+   *  never the raw value. */\n+  targetRef?: string;\n+  /** v2: keyed hash of the caller's idempotency key. */\n+  keyRef?: string;\n+  /** v1 (legacy): raw caller-controlled values — read for backward\n+   *  compatibility; current code never writes them. */\n+  targetId?: string;\n+  idempotencyKey?: string;\n   fingerprint: string;\n-  idempotencyKey: string;\n   state: CopilotActionState;\n   /** Terminal outcome code (null until the record is terminal). */\n   code: CopilotActionCode | null;\n   /** Redacted outcome message (empty until the record is terminal). */\n@@ -209,9 +235,123 @@\n }\n \n const EXECUTIONS_COLLECTION = 'copilotActionExecutions';\n \n+/** Current execution-record schema (v2: identifiers stored as keyed refs). */\n+export const EXECUTION_SCHEMA_VERSION = 2;\n+\n /**\n+ * A keyed, irreversibly transformed reference to caller-supplied\n+ * identifier material. The hash is keyed by (owner, proposal\n+ * fingerprint, field), so the same input always maps to the same\n+ * reference for the same owner and proposal — the record stays\n+ * correlatable for traceability and idempotency — while the raw value\n+ * cannot be recovered from the audit store. A hostile or\n+ * model-generated input can no longer smuggle PII or secrets into a\n+ * durable record.\n+ */\n+export function keyedIdentifierRef(\n+  uid: string,\n+  fingerprint: string,\n+  field: 'target' | 'key',\n+  value: string\n+): string {\n+  return sha256Hex(`${uid}|${fingerprint}|${field}|${value}`);\n+}\n+\n+/**\n+ * Build the durable record as CURRENT code writes it (schema v2):\n+ * caller-controlled identifiers persist only as keyed refs (see\n+ * keyedIdentifierRef) — never verbatim.\n+ */\n+function buildExecutionRecord(\n+  uid: string,\n+  req: CopilotExecuteRequest,\n+  fields: {\n+    state: CopilotActionState;\n+    code: CopilotActionCode | null;\n+    message: string;\n+    action: string | null;\n+    attempts: number;\n+  }\n+) {\n+  const t = nowIso();\n+  return {\n+    schemaVersion: EXECUTION_SCHEMA_VERSION,\n+    actionType: req.proposal.actionType,\n+    targetRef: keyedIdentifierRef(\n+      uid,\n+      req.fingerprint,\n+      'target',\n+      req.proposal.targetId\n+    ),\n+    keyRef: keyedIdentifierRef(uid, req.fingerprint, 'key', req.idempotencyKey),\n+    fingerprint: req.fingerprint,\n+    ...fields,\n+    acceptedAt: t,\n+    updatedAt: t,\n+  };\n+}\n+\n+/**\n+ * Run a read-decide-write cycle against the execution record under a\n+ * Firestore transaction. The snapshot read inside the transaction is\n+ * what serializes concurrent writers: if the commit conflicts (the doc\n+ * changed after this transaction's snapshot), the SDK re-runs the\n+ * closure against the new state and re-decides. Replay/interrupted\n+ * outcomes stage no write, so an empty transaction commits as a no-op.\n+ * A failure that exhausts the SDK's retries resolves to `ok: false` —\n+ * the caller MUST treat that as \"nothing was durably recorded\".\n+ */\n+async function withExecutionRecord<T>(\n+  docRef: DocumentReference,\n+  fn: (\n+    tx: Transaction,\n+    record: CopilotActionExecution | null\n+  ) => T | Promise<T>\n+): Promise<{ ok: true; value: T } | { ok: false; error: unknown }> {\n+  try {\n+    const value = await getFirestoreDb().runTransaction(async (tx) => {\n+      const got = await tx.get(docRef);\n+      const record = got.exists ? (got.data() as CopilotActionExecution) : null;\n+      return await fn(tx, record);\n+    });\n+    return { ok: true, value };\n+  } catch (error) {\n+    return { ok: false, error };\n+  }\n+}\n+\n+/**\n+ * The claim decision table (pure): no record → fresh; terminal →\n+ * replay; fresh non-terminal → interrupted; stale non-terminal (crash)\n+ * → reclaim.\n+ */\n+function decideRecord(\n+  record: CopilotActionExecution | null\n+):\n+  | { kind: 'fresh' }\n+  | { kind: 'replay'; result: CopilotExecuteResult }\n+  | { kind: 'interrupted'; result: CopilotExecuteResult }\n+  | { kind: 'reclaim'; record: CopilotActionExecution } {\n+  if (!record) return { kind: 'fresh' };\n+  if (isTerminal(record)) {\n+    return { kind: 'replay', result: replayResult(record) };\n+  }\n+  if (isFreshInFlight(record)) {\n+    return {\n+      kind: 'interrupted',\n+      result: {\n+        code: 'interrupted',\n+        message:\n+          'The same confirmation is already in flight; nothing new was started.',\n+      },\n+    };\n+  }\n+  return { kind: 'reclaim', record };\n+}\n+\n+/**\n  * A non-terminal record younger than this is treated as genuinely\n  * in-flight (a concurrent confirmation); older than this it is\n  * considered crashed and is reclaimable by a retry. Five minutes covers\n  * the slowest domain seam (the mail send) with wide margin.\n@@ -281,68 +421,78 @@\n }\n \n /**\n  * Persist a TERMINAL execution record for a gate-level rejection\n- * (allowlist / tamper). Uses the same idempotent claim semantics as\n- * the execution path: an existing terminal record is replayed, a fresh\n- * in-flight one yields interrupted, everything else becomes terminal\n- * with this gate's outcome.\n+ * (allowlist / tamper). The read-decide-write runs inside one\n+ * transaction: an existing terminal record is replayed, a fresh\n+ * in-flight one yields interrupted, and a stale non-terminal (or\n+ * missing) record is settled with this gate's outcome. Two concurrent\n+ * settler race only through the transaction — the loser re-decides\n+ * against the winner's committed record (and replays it) instead of\n+ * double-writing.\n  */\n async function recordGateOutcome(\n   uid: string,\n   req: CopilotExecuteRequest,\n   code: CopilotActionCode,\n   message: string\n ): Promise<CopilotExecuteResult> {\n-  const { proposal, fingerprint, idempotencyKey } = req;\n   const result: CopilotExecuteResult = { code, message };\n-  try {\n-    const docRef = executionDocRef(getFirestoreDb(), uid, fingerprint);\n-    const got = await docRef.get();\n-    if (got.exists) {\n-      const record = got.data() as CopilotActionExecution;\n-      if (isTerminal(record)) return replayResult(record);\n-      if (isFreshInFlight(record)) {\n-        return {\n-          code: 'interrupted',\n+  const docRef = executionDocRef(getFirestoreDb(), uid, req.fingerprint);\n+  const outcome = await withExecutionRecord(docRef, (tx, record) => {\n+    if (record && isTerminal(record)) {\n+      return { kind: 'replay', result: replayResult(record) } as const;\n+    }\n+    if (record && isFreshInFlight(record)) {\n+      return {\n+        kind: 'interrupted',\n+        result: {\n+          code: 'interrupted' as const,\n           message:\n             'The same confirmation is already in flight; nothing new was started.',\n-        };\n-      }\n-      // Stale non-terminal: settle it with this gate's outcome.\n-      await docRef.update({\n+        },\n+      } as const;\n+    }\n+    // Stale non-terminal, or no record yet: settle it with this gate's\n+    // outcome inside the transaction.\n+    if (record) {\n+      tx.update(docRef, {\n         state: 'failed',\n         code,\n         message: redactSensitive(message),\n         action: null,\n         updatedAt: nowIso(),\n       });\n     } else {\n-      const t = nowIso();\n-      await docRef.create({\n-        actionType: proposal.actionType,\n-        targetId: proposal.targetId,\n-        fingerprint,\n-        idempotencyKey,\n-        state: 'failed',\n-        code,\n-        message: redactSensitive(message),\n-        action: null,\n-        acceptedAt: t,\n-        updatedAt: t,\n-        attempts: 1,\n-      });\n+      tx.create(\n+        docRef,\n+        buildExecutionRecord(uid, req, {\n+          state: 'failed',\n+          code,\n+          message: redactSensitive(message),\n+          action: null,\n+          attempts: 1,\n+        })\n+      );\n     }\n-  } catch (error) {\n+    return { kind: 'settled' } as const;\n+  });\n+\n+  if (!outcome.ok) {\n     // A gate rejection executed nothing, so nothing is lost by a failed\n     // audit write — but the caller must not be told a clean rejection.\n-    console.error('Failed to record copilot action gate outcome:', error);\n+    console.error(\n+      'Failed to record copilot action gate outcome:',\n+      outcome.error\n+    );\n     return {\n       code: 'audit_unavailable',\n       message:\n         'The confirmation could not be durably recorded, so no outcome was applied; retry the confirmation.',\n     };\n   }\n+  if (outcome.value.kind === 'replay') return outcome.value.result;\n+  if (outcome.value.kind === 'interrupted') return outcome.value.result;\n   return result;\n }\n \n /**\n@@ -356,12 +506,18 @@\n  *   - fresh non-terminal       → interrupted (concurrent in-flight);\n  *   - stale non-terminal       → reclaim it (crash recovery) and count\n  *                                the attempt.\n  *\n- * If the create races with a concurrent claim (the doc appears in the\n- * meantime) the result is re-read and re-decided. A claim that cannot\n- * be persisted at all returns `null` — the caller MUST refuse to\n- * execute (no durable record ⇒ no unrecorded mutation).\n+ * The create and reclaim transitions run inside ONE transaction each.\n+ * Firestore's snapshot-isolated read plus the commit-conflict retry is\n+ * what makes EXACTLY ONE concurrent caller win: two racing creates\n+ * cannot both land (the loser re-runs and sees the fresh in-flight\n+ * record), and two racing reclaims of a crashed record cannot both\n+ * proceed (the winner's commit stamps a fresh `updatedAt`, which the\n+ * loser's re-run classifies as in-flight). Losers return\n+ * interrupted/replay and never dispatch. A claim that cannot be\n+ * persisted at all returns `null` semantics — the caller MUST refuse\n+ * to execute (no durable record ⇒ no unrecorded mutation).\n  */\n async function claimExecution(\n   uid: string,\n   req: CopilotExecuteRequest\n@@ -370,89 +526,59 @@\n   | { kind: 'replay'; result: CopilotExecuteResult }\n   | { kind: 'interrupted'; result: CopilotExecuteResult }\n   | { kind: 'unavailable' }\n > {\n-  const { proposal, fingerprint, idempotencyKey } = req;\n-  const docRef = executionDocRef(getFirestoreDb(), uid, fingerprint);\n+  const docRef = executionDocRef(getFirestoreDb(), uid, req.fingerprint);\n \n-  const decide = (\n-    record: CopilotActionExecution | null\n-  ):\n-    | { kind: 'fresh' }\n-    | { kind: 'replay'; result: CopilotExecuteResult }\n-    | { kind: 'interrupted'; result: CopilotExecuteResult }\n-    | { kind: 'reclaim'; record: CopilotActionExecution } => {\n-    if (!record) return { kind: 'fresh' };\n-    if (isTerminal(record)) {\n-      return { kind: 'replay', result: replayResult(record) };\n-    }\n-    if (isFreshInFlight(record)) {\n-      return {\n-        kind: 'interrupted',\n-        result: {\n-          code: 'interrupted',\n-          message:\n-            'The same confirmation is already in flight; nothing new was started.',\n-        },\n-      };\n-    }\n-    return { kind: 'reclaim', record };\n-  };\n-\n-  const got = await docRef.get();\n-  let decision = decide(\n-    got.exists ? (got.data() as CopilotActionExecution) : null\n+  // Fast path outside the transaction: a terminal duplicate and a\n+  // fresh in-flight confirmation both end here with no write, and\n+  // neither needs isolation.\n+  const first = await docRef.get();\n+  const firstDecision = decideRecord(\n+    first.exists ? (first.data() as CopilotActionExecution) : null\n   );\n+  if (firstDecision.kind === 'replay')\n+    return { kind: 'replay', result: firstDecision.result };\n+  if (firstDecision.kind === 'interrupted')\n+    return { kind: 'interrupted', result: firstDecision.result };\n \n-  if (decision.kind === 'fresh') {\n-    try {\n-      const t = nowIso();\n-      await docRef.create({\n-        actionType: proposal.actionType,\n-        targetId: proposal.targetId,\n-        fingerprint,\n-        idempotencyKey,\n-        state: 'accepted',\n-        code: null,\n-        message: '',\n-        action: null,\n-        acceptedAt: t,\n-        updatedAt: t,\n-        attempts: 1,\n-      });\n-      return { kind: 'proceed' };\n-    } catch (error) {\n-      // Either we lost the create race (a concurrent claim landed) or\n-      // persistence is genuinely down. Re-read and re-decide; if there\n-      // is still no record, persistence failed and execution is refused.\n-      const again = await docRef.get();\n-      decision = decide(\n-        again.exists ? (again.data() as CopilotActionExecution) : null\n-      );\n-      if (decision.kind === 'fresh') {\n-        console.error(\n-          'Failed to claim copilot action execution record:',\n-          error\n+  // The racing paths (fresh create, stale reclaim) decide and write in\n+  // one transaction; the re-run-on-conflict semantics make the second\n+  // caller re-decide against the winner's committed state.\n+  const outcome = await withExecutionRecord(docRef, (tx, record) => {\n+    const decision = decideRecord(record);\n+    switch (decision.kind) {\n+      case 'fresh':\n+        tx.create(\n+          docRef,\n+          buildExecutionRecord(uid, req, {\n+            state: 'accepted',\n+            code: null,\n+            message: '',\n+            action: null,\n+            attempts: 1,\n+          })\n         );\n-        return { kind: 'unavailable' };\n-      }\n+        return { kind: 'proceed' } as const;\n+      case 'replay':\n+        return { kind: 'replay', result: decision.result } as const;\n+      case 'interrupted':\n+        return { kind: 'interrupted', result: decision.result } as const;\n+      case 'reclaim':\n+        tx.update(docRef, {\n+          state: 'executing',\n+          updatedAt: nowIso(),\n+          attempts: (decision.record.attempts ?? 1) + 1,\n+        });\n+        return { kind: 'proceed' } as const;\n     }\n-  }\n+  });\n \n-  if (decision.kind === 'replay')\n-    return { kind: 'replay', result: decision.result };\n-  if (decision.kind === 'interrupted') {\n-    return { kind: 'interrupted', result: decision.result };\n+  if (!outcome.ok) {\n+    console.error('Failed to claim copilot action execution record:', outcome.error);\n+    return { kind: 'unavailable' };\n   }\n-  if (decision.kind === 'reclaim') {\n-    await docRef.update({\n-      state: 'executing',\n-      updatedAt: nowIso(),\n-      attempts: (decision.record.attempts ?? 1) + 1,\n-    });\n-    return { kind: 'proceed' };\n-  }\n-  return { kind: 'unavailable' };\n+  return outcome.value;\n }\n \n /**\n  * Execute a confirmed copilot proposal: exactly one authorized domain\n","firstChangedLine":37},"isError":false,"timestamp":1788205464459}}
{"type":"message","id":"f920a6c0","parentId":"82195c87","timestamp":"2026-08-31T19:46:35.196Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Advisory only — no action needed. Notes:\n\n1. \"Unused export\" — `keyedIdentifierRef` and `EXECUTION_SCHEMA_VERSION` are exported but unused within the module; the test file will import them (keyedIdentifierRef for asserting ref values, EXECUTION_SCHEMA_VERSION for assertions). The Knip warnings about COPILOT_PROPOSAL_ONLY etc. are re-exports (pre-existing pattern — they existed before my changes; they're exported for the import surface). Not a problem.\n\n2. `switch-without-default` — the new switch inside the tx closure of claimExecution: all four union members are covered by `decision.kind` (exhaustive), so the default is unreachable; TS's exhaustiveness check guarantees it. The existing `dispatchAction` switch also has no default (the \"unreachable\" return after it). Advisory only.\n\n3. `no-console-except-error ×2` — my two console.error calls match the existing pattern (the old code also had console.error). Advisory only.\n\n4. `pass-through-wrapper ×1` — probably `withExecutionRecord`. Advisory only; this is an intentional isolation boundary.\n\nNext: update the test harness. Work needed:\n1. Add `runTransaction` to `createFakeDb` (with a serialization queue).\n2. Update the test at L688 (the raw idempotencyKey assertion → keyRef/schemaVersion/no raw values).\n3. The base of the `seedExecution` helper — it constructs v1-shaped records; keep this (for backward compatibility) but note that new records will be v2.\n4. Add new tests: concurrent reclaim, concurrent fresh claim, identifier redaction, v1 legacy replay, gate settle on a crashed record.\n\nLet me update the fake harness first. The current createFakeDb (from the read at L63-114):\n\n```ts\nfunction createFakeDb(over: FakeOptions = {}) {\n  const store = new Map<string, StoredRecord>();\n  const key = (uid: string, fp: string) => `${uid}:${fp}`;\n  const makeDoc = (uid: string, fp: string) => ({\n    get: async () => {...},\n    create: async (d) => {...},\n    update: async (d) => {...},\n    set: async (d) => {...},\n  });\n  const db = {\n    collection: (name) => {...},\n  };\n  return { db, store };\n}\n```\n\nNew version with runTransaction. The fake doc ref needs an identity for tx operations — give each doc a `__key` property. The tx object:\n\n```ts\nrunTransaction: async (fn) => {\n  // Serialize concurrent transactions like Firestore serializes\n  // conflicting writers: each run snapshots the store on its turn and\n  // sees everything committed before it; the commit-conflict retry the\n  // real SDK performs is modeled by re-snapshotting on each run.\n  let last: unknown;\n  const run = async () => {\n    const staged: Array<() => void> = [];\n    const tx = {\n      get: async (doc: { __key: string }) => {\n        const data = store.get(doc.__key);\n        return { exists: data !== undefined, data: () => data };\n      },\n      create: async (doc: { __key: string }, d: StoredRecord) => {\n        if (over.failCreate) throw new Error('persistence down');\n        staged.push(() => {\n          if (store.has(doc.__key)) throw new Error('document already exists');\n          store.set(doc.__key, { ...d });\n        });\n      },\n      update: async (doc: { __key: string }, d: StoredRecord) => {\n        staged.push(() => {\n          const current = store.get(doc.__key);\n          if (!current) throw new Error('document not found');\n          if (over.failFinalize && (d.state === 'succeeded' || d.state === 'failed')) {\n            throw new Error('persistence down');\n          }\n          store.set(doc.__key, { ...current, ...d });\n        });\n      },\n      set: async (doc: { __key: string }, d: StoredRecord) => {\n        staged.push(() => store.set(doc.__key, { ...d }));\n      },\n    };\n    const value = await fn(tx);\n    // Commit: apply the staged writes atomically.\n    for (const apply of staged) apply();\n    return value;\n  };\n  const p = txQueue.then(() => run());\n  txQueue = p.catch(() => {});\n  last = undefined; // (unnecessary)\n  return p;\n};\n```\n\nHmm, wait — the real Firestore semantics: if the closure throws, it retries (re-runs fn up to N times). If the commit fails, it retries. My fake: `fn(tx)` runs once per runTransaction call, and the serialization queue handles ordering. But to model failure injection with retries, I should add a retry loop: if `fn` or the commit throws, retry up to 3 times, and if still failing, throw the last error. This lets me model:\n- failCreate: every create commit fails → 3 retries → throw → withExecutionRecord catches → unavailable. ✓ (matches \"audit persistence failure produces no unrecorded mutation\")\n- failFinalize: a terminal update via docRef.update (step 5, not a tx) throws — unchanged. But also: a gate settle that stages a terminal update inside a tx → commit fails → retry → fails → throw → unavailable. In the new recordGateOutcome, a stale settle stages a terminal update inside a tx. If failFinalize is on, that fails — which matches the intent of the old behavior (failFinalize was meant to fail \"an update that moves the record to a terminal state\").\n\nNote: my fake's `failFinalize` check is done at staged-apply time (commit) and references `d.state` of the staged update — good.\n\nAlso, a docRef.get outside a tx in the fake: currently returns a snapshot of the store at call time. No issue.\n\nOne issue: `makeDoc`'s methods are currently bound to (uid, fp); I'll add a `__key` to the returned doc object. The fake doc object is also used directly by the implementation (`docRef.get()`, `docRef.update()` in step 3/5, `docRef.create()` in the old code — now only step 3's update and step 5's update remain outside a tx).\n\nWait — step 3 of executeCopilotAction does `docRef.update({state:'executing'...})` — a direct doc update (not a tx). The fake's doc.update handles that. ✓.\n\nNow, `txQueue`: needs to be declared inside createFakeDb: `let txQueue: Promise<unknown> = Promise.resolve();`.\n\nAlso, the fake db needs to keep the `collection` structure. And `makeDoc` returns a doc with `__key`.\n\nType of `fn`: the implementation passes `async (tx: Transaction, record) => ...` — the fake's tx is structurally compatible enough (get/create/update/set). The fake's `runTransaction` signature: `(fn: (tx: unknown) => Promise<unknown>)`. TS: the fake db object is assigned to `mockFakeDb: ReturnType<typeof createFakeDb>['db']`, and jest.mock returns `getFirestoreDb: () => mockFakeDb` — the actual code calls `db.runTransaction(async (tx) => {...})`, where tx is typed as Transaction (the real one). The mock is `getFirestoreDb: () => mockFakeDb` — TS inside the test doesn't type-check the mock against the real signature (it's a jest.mock factory; the implementation is imported and uses the real types). At runtime, the fake db just needs to have a `runTransaction` method. The closure receives the fake tx object. The fake tx needs `get`, `create`, `update`, `set` methods that match the call signatures. The real Transaction's `create(doc, data)`, `update(doc, data)`, `set(doc, data, options?)`, `get(doc)` — same shapes.\n\nBut a TypeScript subtlety inside the test file: `db.runTransaction = async (fn: (tx: unknown) => Promise<unknown>) => ...` — no problem within the test file's own types (the test's db is a plain object type, not Firestore).\n\nHowever — the implementation's closure does `tx.get(docRef)` and then `got.exists` / `got.data()`. My fake's tx.get returns `{ exists, data }` — matches. `tx.create(docRef, data)` — matches. `tx.update(docRef, data)` — matches.\n\nThe fake doc's `__key`: a plain property on the doc object. The implementation calls `tx.get(docRef)` passing the doc object it got from executionDocRef — same object, so `__key` is present. ✓\n\nAlso, existing tests call `mockStore` directly, and seedExecution writes raw v1 records into the store. Those continue to work (store is the same Map).\n\nOne more: the current test at L718 uses `createFakeDb({ failCreate: true })` and expects `audit_unavailable` with `mockStore.size === 0`. In the new implementation: claim → fast read (no record) → tx path → tx.create is staged → commit fails (failCreate) → retry 3x → throw → withExecutionRecord {ok:false} → unavailable → audit_unavailable, store empty. ✓ (my retry loop must not leave partial state — the staged writes only apply on commit, and the create commit is the first apply, which throws before setting anything. My staged create: `if (store.has) throw; store.set(...)` — if failCreate throws first, nothing gets set. ✓)\n\nTest at L781 (finalize failure after a successful mutation): failFinalize — the claim tx stages an 'accepted' create (non-terminal → commit OK) → step 3 docRef.update('executing') (non-terminal → OK) → dispatch → step 5 docRef.update terminal → failFinalize throws → audit_unavailable. ✓ unchanged.\n\nNext, let me also think about the \"concurrent reclaim\" test in the fake:\n- seedExecution(uid, fp, { state: 'executing', updatedAt: 10 minutes ago, attempts: 1, ... v1 fields }).\n- Two executeCopilotAction calls via Promise.all with the same request (county_confirm, live county, revision 7, one candidate).\n- Flow of each call: allowlist ✓, fingerprint ✓, claimExecution: fast read → the record is a stale non-terminal → not replay/interrupted → tx path.\n- Serialized in the fake: call A's tx runs first: snapshot (stale) → decide reclaim → stage update {executing, now, attempts 2} → commit → store is updated. Returns proceed.\n- Call B's tx runs next: snapshot → now updatedAt = A's now → fresh in-flight → interrupted (no write).\n- A continues: step 3 docRef.update executing (harmless re-write) → dispatch county_confirm → enqueueCountyTaskIfCurrent mock → executed → finalize update to terminal (non-failFinalize → OK).\n- Result: [executed, interrupted] in some order; enqueue called exactly once; record: state succeeded, attempts 2, schemaVersion 2, action county_confirm.\n\nConcurrent fresh claim test: no seed. A's tx: no record → stage create → commit → proceed. B's tx: snapshot → 'accepted' record with updatedAt = now → fresh → interrupted. Result: one executed, one interrupted; store size 1; record attempts 1.\n\nNote: in both concurrent tests, `makeRequest` is called twice → same request object shape; the fingerprint is the same.\n\nIdentifier redaction test:\n```ts\nconst p = proposal({ actionType: 'task_retry', targetId: 'victim@example.com', revision: 2 });\nconst req = makeRequest(p); // idempotencyKey 'ui:message-1'\n// retryTask mock resolves\nconst res = await executeCopilotAction('u1', req);\nexpect(res.code).toBe('executed');\nconst record = stored('u1', req.fingerprint);\nexpect(record?.schemaVersion).toBe(2);\nexpect(record?.targetRef).toMatch(/^[a-f0-9]{64}$/);\nexpect(record?.keyRef).toMatch(/^[a-f0-9]{64}$/);\nexpect(record).not.toHaveProperty('targetId');\nexpect(record).not.toHaveProperty('idempotencyKey');\nconst serialized = JSON.stringify(record);\nexpect(serialized).not.toContain('victim@example.com');\nexpect(serialized).not.toContain('ui:message-1');\n```\n\nv1 legacy replay test:\n```ts\nseedExecution('u1', fp, { state: 'succeeded', code: 'executed', message: 'Task task-1 retried.', action: 'task_retry' }); // v1 shape with raw targetId via the seedExecution base\nconst res = await executeCopilotAction('u1', makeRequest(p));\nexpect(res.code).toBe('executed'); // replayed\nexpect(retryTask).not.toHaveBeenCalled();\n```\nWait — the seedExecution base already includes a raw targetId/idempotencyKey and no schemaVersion → a perfect v1 record.\n\nGate settle on a crashed record (concurrent):\n- Seed a crashed record (stale executing).\n- Two concurrent TAMPERED confirmations (fingerprint mismatch). Both hit recordGateOutcome:\n  - A's tx: snapshot is a stale non-terminal (not terminal, not fresh) → stage a terminal failed/tampered update → commit.\n  - B's tx: snapshot → now the record is terminal → replay the tampered result.\n- Both return 'tampered'; the record: state failed, code tampered; attempts unchanged (1) — my gate settle does not touch attempts.\n\nAlso, a sequential replay test already exists (L803/829).\n\nOK — before the edit, a checkpoint deadline. Let me commit the checkpoint now: the copilot-actions.ts implementation edit was applied cleanly (LSP clean). Next: update the fake harness + tests.\n","thinkingSignature":"reasoning"},{"type":"text","text":"\n\nAdvisories only (exhaustive union switch, deliberate console.error, intentional isolation wrapper — all consistent with the module's existing patterns). The implementation edit landed clean. Checkpointing, then updating the test harness.\n\n"},{"type":"toolCall","id":"chatcmpl-tool-8342a30df11954a0","name":"checkpoint_notes","arguments":{"blockers":[],"completed":["WU1 complete + COMMITTED ac6ee29 (23 files; hooks clean; no AI attribution); tree clean except untracked plans doc","WU3 implementation edit APPLIED to src/lib/copilot-actions.ts (LSP clean): header crash-boundary note; Transaction/DocumentReference import from firebase-admin/firestore; CopilotActionExecution gains schemaVersion?/targetRef?/keyRef? + optional legacy targetId?/idempotencyKey?; EXECUTION_SCHEMA_VERSION=2; keyedIdentifierRef(uid,fp,'target'|'key',v)=sha256Hex(piped); buildExecutionRecord (v2 writes, never raw); withExecutionRecord over db.runTransaction (tx.get→decide; fresh→tx.create; reclaim→tx.update executing+attempts+1; replay/interrupted→no write; catch→unavailable); decideRecord moved to module scope; claimExecution = fast read outside tx (replay/fresh fast path) then tx claim; recordGateOutcome = tx (terminal→replay, fresh→interrupted, stale/absent→terminal-failed)"],"current":"WU3 TESTS NEXT (parent; worktree .worktrees/records-agent-launch @ ac6ee29, branch feat/records-agent-launch; emulator UP :8095). Target: src/lib/__test