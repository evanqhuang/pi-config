{"type":"message","id":"6e801eb3","parentId":"764a0f1b","timestamp":"2026-08-31T19:37:48.499Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-aa73268db8f1d3c2","toolName":"read","content":[{"type":"text","text":"function countyRecord(\n  over: Partial<StoredCountyRecord> = {}\n): StoredCountyRecord {\n  return {\n    schemaVersion: 1,\n    ownerUid: 'u1',\n    revision: 7,\n    createdAt: '2026-08-01T00:00:00.000Z',\n    status: 'confirmation_required',\n    resolvedAddress: {\n      street: '5180 broadview rd',\n      unit: null,\n      city: 'cleveland',\n      state: 'OH',\n      zip: '44143',\n    },\n    candidates: [\n      {\n        objectId: 123456,\n        parcelIdFormatted: '0038-123456-00',\n        address: '5180 Broadview Rd',\n        score: 0.97,\n      },\n    ] as unknown as StoredCandidate[],\n    snapshot: null,\n    unsupportedReason: null,\n    lastRefresh: null,\n    updatedAt: '2026-08-01T00:00:00.000Z',\n    ...over,\n  } as unknown as StoredCountyRecord;\n}\n\nconst ownerRequest = (over: Partial<OwnerRequest> = {}): OwnerRequest =>\n  ({\n    requestId: 'or:prop-1',\n    ownerUid: 'u1',\n    propertyId: 'prop-1',\n    kind: 'owner_letter',\n    status: 'not_requested',\n    revision: 3,\n    recipient: null,\n    draft: null,\n    approval: null,\n    sendAttempts: [],\n    providerMessageId: null,\n    nudgeCount: 0,\n    lastNudgeAt: null,\n    receipt: null,\n    lastError: null,\n    createdAt: '2026-08-01T00:00:00.000Z',\n    updatedAt: '2026-08-01T00:00:00.000Z',\n    ...over,\n  }) as unknown as OwnerRequest;\n\nfunction proposal(over: Partial<CopilotProposal> = {}): CopilotProposal {\n  return {\n    actionType: 'task_retry',\n    targetId: 'task-1',\n    revision: 2,\n    summary: 'Retry the blocked county confirm task.',\n    ...over,\n  };\n}\n\nfunction makeRequest(\n  p: CopilotProposal,\n  fingerprint?: string\n): CopilotExecuteRequest {\n  return {\n    proposal: p,\n    fingerprint: fingerprint ?? proposalFingerprint(p),\n    idempotencyKey: 'ui:message-1',\n    httpRequest: new NextRequest(\n      'http://localhost/api/copilot/proposals/execute',\n      {\n        method: 'POST',\n        headers: { authorization: 'Bearer test-token' },\n      }\n    ),\n  };\n}\n\nconst okResponse = (status = 200) => ({\n  ok: status < 400,\n  status,\n  json: async () => ({}),\n});\n\nfunction seedExecution(\n  uid: string,\n  fp: string,\n  record: Partial<CopilotActionExecution>\n) {\n  const base: CopilotActionExecution = {\n    actionType: 'task_retry',\n    targetId: 'task-1',\n    fingerprint: fp,\n    idempotencyKey: 'ui:message-1',\n    state: 'executing',\n    code: null,\n    message: '',\n    action: null,\n    acceptedAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    attempts: 1,\n    ...record,\n  };\n  mockStore.set(`${uid}:${fp}`, base as unknown as StoredRecord);\n}\n\nfunction stored(uid: string, fp: string) {\n  return mockStore.get(`${uid}:${fp}`) as\n    | (CopilotActionExecution & StoredRecord)\n    | undefined;\n}\n\nbeforeEach(() => {\n  jest.clearAllMocks();\n  ({ db: mockFakeDb, store: mockStore } = createFakeDb());\n  (getCountyRecord as jest.Mock).mockResolvedValue(null);\n  (getWatchlistItem as jest.Mock).mockResolvedValue(null);\n  (getOwnerRequest as jest.Mock).mockResolvedValue(null);\n  (enqueueCountyTaskIfCurrent as jest.Mock).mockResolvedValue({\n    stale: null,\n    task: { taskId: 't1', revision: 1, status: 'queued' },\n    created: true,\n    recordRevision: 7,\n  });\n  (cancelTask as jest.Mock).mockResolvedValue({\n    taskId: 'task-1',\n    revision: 3,\n  });\n  (retryTask as jest.Mock).mockResolvedValue({ taskId: 'task-1', revision: 3 });\n  (draftRoute as jest.Mock).mockResolvedValue(okResponse(202));\n  (sendRoute as jest.Mock).mockResolvedValue(okResponse(200));\n});\n\n// --- allowlisted actions: exactly one domain action --------------------------\n\ndescribe('confirmed allowlisted proposal → exactly one authorized action', () => {\n\n[715 more lines in file. Use offset=308 to continue.]"}],"isError":false,"timestamp":1788205068499}}
