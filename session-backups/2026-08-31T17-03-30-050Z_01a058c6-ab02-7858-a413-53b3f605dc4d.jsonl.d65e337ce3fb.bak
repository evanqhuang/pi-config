{"type":"message","id":"66de8f79","parentId":"8e545b82","timestamp":"2026-08-31T17:11:48.687Z","message":{"role":"toolResult","toolCallId":"chatcmpl-tool-ade211f56cf0457f","toolName":"read","content":[{"type":"text","text":"import { NextRequest, NextResponse } from 'next/server';\n\nimport {\n  NO_STORE,\n  requireRecordedProperty,\n  searchNotFoundResponse,\n} from '../../shared';\nimport { getRecordedSearchById } from '@/lib/firestore/recorded-documents';\n\nexport const dynamic = 'force-dynamic';\n\n/**\n * GET /api/properties/[id]/recorded-documents/searches/[searchId]\n *\n * One specific search run (the UI polls this after a 202 to watch a run\n * go queued → running → terminal). The search collection is owner-scoped,\n * so an unknown id — including another owner's id — is simply 404.\n */\nexport async function GET(\n  request: NextRequest,\n  {\n    params,\n  }: {\n    params: Promise<{ id: string; searchId: string }>;\n  }\n) {\n  try {\n    const auth = await requireRecordedProperty(request, params);\n    if (auth instanceof NextResponse) return auth;\n\n    const { searchId } = await params;\n    const search = await getRecordedSearchById(auth.user.id, searchId);\n    if (!search || search.propertyId !== auth.property.id) {\n      return searchNotFoundResponse();\n    }\n    return NextResponse.json(search, { headers: NO_STORE });\n  } catch (error) {\n    console.error(\n      'Error in GET .../recorded-documents/searches/[searchId]:',\n      error\n    );\n    return NextResponse.json(\n      { error: 'Internal server error' },\n      { status: 500, headers: NO_STORE }\n    );\n  }\n}\n"}],"isError":false,"timestamp":1788196308687}}
